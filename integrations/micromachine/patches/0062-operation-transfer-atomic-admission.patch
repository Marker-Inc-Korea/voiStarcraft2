diff --git a/tests/operation_transfer_admission_test.cpp b/tests/operation_transfer_admission_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..636558183e596cbe725377d4116fd4fe42e0c57f
--- /dev/null
+++ b/tests/operation_transfer_admission_test.cpp
@@ -0,0 +1,142 @@
+#include "voi_operation_transfer_admission.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace
+{
+VoiOperationTransferEndpoint endpoint(
+	const std::string & operationId,
+	const std::string & counterpartOperationId,
+	const std::string & editAction,
+	std::uint64_t existingGeneration,
+	std::uint64_t requestedGeneration,
+	bool existingActive = true)
+{
+	VoiOperationTransferEndpoint value;
+	value.operationId = operationId;
+	value.counterpartOperationId = counterpartOperationId;
+	value.editAction = editAction;
+	value.existingGeneration = existingGeneration;
+	value.requestedGeneration = requestedGeneration;
+	value.requestedPresent = true;
+	value.existingActive = existingActive;
+	return value;
+}
+
+struct TestUnit
+{
+	std::uint64_t tag = 0;
+};
+
+struct TestRole
+{
+	std::string unitType;
+	std::string role;
+	std::string abilityPolicy;
+	int priority = 0;
+};
+}
+
+int main()
+{
+	const auto sourceAdvanced = endpoint(
+		"recon-alpha",
+		"assault-bravo",
+		"transfer_out",
+		3,
+		4);
+	const auto destinationNotAdvanced = endpoint(
+		"assault-bravo",
+		"recon-alpha",
+		"transfer_in",
+		7,
+		7);
+	const auto partialGeneration =
+		voiDecideOperationTransferAdmission(
+			sourceAdvanced,
+			destinationNotAdvanced);
+	assert(!partialGeneration.admitted);
+	assert(
+		partialGeneration.blocker
+		== "transfer_pair_requires_generation_increment");
+
+	const auto newCounterpart = endpoint(
+		"assault-bravo",
+		"recon-alpha",
+		"transfer_in",
+		0,
+		1,
+		false);
+	const auto newCounterpartDecision =
+		voiDecideOperationTransferAdmission(
+			sourceAdvanced,
+			newCounterpart);
+	assert(!newCounterpartDecision.admitted);
+	assert(
+		newCounterpartDecision.blocker
+		== "transfer_pair_not_active");
+
+	const auto destinationAdvanced = endpoint(
+		"assault-bravo",
+		"recon-alpha",
+		"transfer_in",
+		7,
+		8);
+	const auto atomicPair =
+		voiDecideOperationTransferAdmission(
+			sourceAdvanced,
+			destinationAdvanced);
+	assert(atomicPair.admitted);
+	assert(atomicPair.blocker.empty());
+
+	const std::map<std::uint64_t, std::string> assignedRoles = {
+		{ 11, "scout" },
+		{ 22, "frontline" },
+		{ 33, "reserve" },
+	};
+	const std::vector<TestUnit> retainedUnits = {
+		{ 11 },
+		{ 22 },
+	};
+	const auto retainedRoles =
+		voiPreserveAssignedRolesForUnits(
+			assignedRoles,
+			retainedUnits,
+			[](const TestUnit & unit)
+			{
+				return unit.tag;
+			});
+	assert(retainedRoles.size() == 2);
+	assert(retainedRoles.at(11) == "scout");
+	assert(retainedRoles.at(22) == "frontline");
+	assert(retainedRoles.find(33) == retainedRoles.end());
+
+	const std::vector<TestRole> marineRoles = {
+		{ "TERRAN_MARINE", "scout", "avoid_combat", 10 },
+		{ "TERRAN_MARINE", "frontline", "stim_focus_fire", 20 },
+	};
+	const auto * scoutPolicy =
+		voiSelectRoleAbilityPolicy(
+			marineRoles,
+			"scout",
+			[](const TestRole & role)
+			{
+				return role.unitType == "TERRAN_MARINE";
+			});
+	const auto * frontlinePolicy =
+		voiSelectRoleAbilityPolicy(
+			marineRoles,
+			"frontline",
+			[](const TestRole & role)
+			{
+				return role.unitType == "TERRAN_MARINE";
+			});
+	assert(scoutPolicy != nullptr);
+	assert(scoutPolicy->abilityPolicy == "avoid_combat");
+	assert(frontlinePolicy != nullptr);
+	assert(frontlinePolicy->abilityPolicy == "stim_focus_fire");
+	return 0;
+}
