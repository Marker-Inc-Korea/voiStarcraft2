diff --git a/src/voi_operation_transfer_admission.hpp b/src/voi_operation_transfer_admission.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c101468bf8ebe3698e8c41058c1240a74aa7211e
--- /dev/null
+++ b/src/voi_operation_transfer_admission.hpp
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+struct VoiOperationTransferEndpoint
+{
+	std::string operationId;
+	std::string counterpartOperationId;
+	std::string editAction;
+	std::uint64_t existingGeneration = 0;
+	std::uint64_t requestedGeneration = 0;
+	bool requestedPresent = false;
+	bool existingActive = false;
+	bool terminal = false;
+	std::string blocker;
+};
+
+struct VoiOperationTransferAdmission
+{
+	bool admitted = false;
+	std::string blocker;
+};
+
+inline VoiOperationTransferAdmission voiDecideOperationTransferAdmission(
+	const VoiOperationTransferEndpoint & first,
+	const VoiOperationTransferEndpoint & second)
+{
+	if (!first.requestedPresent || !second.requestedPresent)
+	{
+		return { false, "transfer_counterpart_missing" };
+	}
+	if (first.operationId.empty()
+		|| second.operationId.empty()
+		|| first.operationId == second.operationId
+		|| first.counterpartOperationId != second.operationId
+		|| second.counterpartOperationId != first.operationId
+		|| !((first.editAction == "transfer_in"
+				&& second.editAction == "transfer_out")
+			|| (first.editAction == "transfer_out"
+				&& second.editAction == "transfer_in")))
+	{
+		return { false, "transfer_counterpart_contract_mismatch" };
+	}
+	if (!first.blocker.empty())
+	{
+		return { false, first.blocker };
+	}
+	if (!second.blocker.empty())
+	{
+		return { false, second.blocker };
+	}
+	if (!first.existingActive || !second.existingActive)
+	{
+		return { false, "transfer_pair_not_active" };
+	}
+	if (first.terminal || second.terminal)
+	{
+		return { false, "transfer_endpoint_terminal" };
+	}
+	if (first.requestedGeneration < first.existingGeneration
+		|| second.requestedGeneration < second.existingGeneration)
+	{
+		return { false, "stale_operation_generation" };
+	}
+	if (first.requestedGeneration == first.existingGeneration
+		|| second.requestedGeneration == second.existingGeneration)
+	{
+		return {
+			false,
+			"transfer_pair_requires_generation_increment"
+		};
+	}
+	return { true, "" };
+}
+
+template <typename Tag, typename Unit, typename TagGetter>
+std::map<Tag, std::string> voiPreserveAssignedRolesForUnits(
+	const std::map<Tag, std::string> & assignedRoles,
+	const std::vector<Unit> & retainedUnits,
+	TagGetter tagGetter)
+{
+	std::map<Tag, std::string> retainedRoles;
+	for (const auto & unit : retainedUnits)
+	{
+		const Tag tag = tagGetter(unit);
+		const auto role = assignedRoles.find(tag);
+		if (role != assignedRoles.end())
+		{
+			retainedRoles[tag] = role->second;
+		}
+	}
+	return retainedRoles;
+}
+
+template <typename Role, typename MatchesUnit>
+const Role * voiSelectRoleAbilityPolicy(
+	const std::vector<Role> & roles,
+	const std::string & assignedRole,
+	MatchesUnit matchesUnit)
+{
+	const Role * selected = nullptr;
+	for (const auto & role : roles)
+	{
+		if (!role.abilityPolicy.empty()
+			&& matchesUnit(role)
+			&& (assignedRole.empty()
+				|| role.role == assignedRole)
+			&& (selected == nullptr
+				|| role.priority >= selected->priority))
+		{
+			selected = &role;
+		}
+	}
+	return selected;
+}
