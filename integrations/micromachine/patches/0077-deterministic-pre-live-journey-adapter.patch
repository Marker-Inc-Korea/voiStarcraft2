+
+int main()
+{
+	const auto output =
+		voiRunPreLiveJourneyAdapter(validInput());
+	CHECK(output["schema_version"] == 1);
+	CHECK(output["events"].is_array());
+	CHECK(output["events"].size() >= 6);
+	CHECK(
+		output["battlefield_overview"]["authority"]
+			== "micromachine_cpp");
+	CHECK(
+		output["operation_director"][0]["status"]
+			== "COMPLETED");
+	CHECK(
+		output["operation_director"][0]
+			["submission_observed"] == true);
+	CHECK(
+		output["operation_director"][0]
+			["family_evidence"][0]["effect_kind"]
+			== "movement");
+	CHECK(output["hud"]["rows"].is_array());
+
+	auto multiRole = validInput();
+	multiRole["initial_state"]["units"].push_back({
+		{ "tag", 13 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	multiRole["initial_state"]["units"].push_back({
+		{ "tag", 14 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	multiRole["initial_state"]["units"].push_back({
+		{ "tag", 15 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	auto & multiRoleOperation =
+		multiRole["steps"][0]["update"]["vector"]["operations"][0];
+	multiRoleOperation["tactical_task"]["min_units"] = 5;
+	multiRoleOperation["tactical_task"]["max_units"] = 5;
+	multiRoleOperation["composition_requirements"] = {
+		{
+			{ "unit_type", "TERRAN_MARINE" },
+			{ "count", 4 },
+			{ "role", "frontline" },
+		},
+		{
+			{ "unit_type", "TERRAN_MARINE" },
+			{ "count", 1 },
+			{ "role", "scout" },
+		},
+	};
+	const auto multiRoleOutput =
+		voiRunPreLiveJourneyAdapter(multiRole);
+	CHECK(
+		multiRoleOutput["operation_director"][0]["assigned_count"]
+			== 5);
+	CHECK(
+		multiRoleOutput["operation_director"][0]
+			["assigned_unit_tags"].size() == 5);
+
+	auto protectedMinimum = validInput();
+	protectedMinimum["initial_state"]["protected_minimum"]
+		["TERRAN_MARINE"] = 3;
+	protectedMinimum["initial_state"]["units"].push_back({
+		{ "tag", 13 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	protectedMinimum["initial_state"]["units"].push_back({
+		{ "tag", 14 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	protectedMinimum["initial_state"]["units"].push_back({
+		{ "tag", 15 },
+		{ "unit_type", "TERRAN_MARINE" },
+		{ "home_distance", 0.0 },
+	});
+	auto & protectedOperation =
+		protectedMinimum["steps"][0]["update"]["vector"]["operations"][0];
+	protectedOperation["tactical_task"]["min_units"] = 4;
+	protectedOperation["tactical_task"]["max_units"] = 4;
+	protectedOperation["composition_requirements"][0]["count"] = 4;
+	protectedMinimum["steps"].erase(
+		protectedMinimum["steps"].begin() + 1);
+	const auto protectedOutput =
+		voiRunPreLiveJourneyAdapter(protectedMinimum);
+	CHECK(protectedOutput["operation_director"].empty());
+	CHECK(protectedOutput["final_state"]["operations"].empty());
+	CHECK(protectedOutput["final_state"]["owners"].empty());
+	bool protectedRejectionObserved = false;
+	for (const auto & event : protectedOutput["events"])
+	{
+		protectedRejectionObserved =
+			protectedRejectionObserved
+			|| (event["event_type"] == "rejection"
+				&& event["payload"]["reason"]
+					== "protected_minimum_violation");
+	}
+	CHECK(protectedRejectionObserved);
+
+	auto forbidden = validInput();
+	forbidden["steps"][0]["submission_success"] = true;
+	try
+	{
+		(void)voiRunPreLiveJourneyAdapter(forbidden);
+		CHECK(false);
+	}
+	catch (const std::runtime_error & error)
+	{
+		CHECK(
+			std::string(error.what()).find(
+				"authoritative input field is forbidden")
+				!= std::string::npos);
+	}
+
+	auto regressive = validInput();
+	regressive["steps"][1]["frame"] = 99;
+	try
+	{
+		(void)voiRunPreLiveJourneyAdapter(regressive);
+		CHECK(false);
+	}
+	catch (const std::runtime_error & error)
+	{
+		CHECK(
+			std::string(error.what()).find("regressed")
+				!= std::string::npos);
+	}
+
+	return failures == 0 ? 0 : 1;
+}
