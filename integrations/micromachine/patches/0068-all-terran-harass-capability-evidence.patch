+	std::size_t effectCount = 0;
+	std::uint32_t effectFrame = 0;
+	std::string blockerManager;
+	std::string blockerReason;
+};
+
+struct VoiFamilyEffectTelemetryLatch
+{
+	bool pending = false;
+	VoiFamilyEffectTelemetrySnapshot pendingSnapshot;
+	bool acknowledged = false;
+	std::string acknowledgedPolicyUpdateId;
+	std::uint64_t acknowledgedOperationGeneration = 0;
+	std::string acknowledgedAction;
+	std::uint64_t acknowledgedAttemptGeneration = 0;
+	std::string acknowledgedEffectKind;
+};
+
+struct VoiFamilyEffectTelemetryDelivery
+{
+	std::string operationId;
+	std::string unitType;
+	std::string role;
+	VoiFamilyEffectTelemetrySnapshot snapshot;
+};
+
+struct VoiFamilyEffectTelemetryDeliveryQueue
+{
+	std::vector<VoiFamilyEffectTelemetryDelivery> pending;
+	std::vector<VoiFamilyEffectTelemetryDelivery> acknowledged;
+};
+
+inline bool voiSameFamilyEffectTelemetryDelivery(
+	const VoiFamilyEffectTelemetryDelivery & left,
+	const VoiFamilyEffectTelemetryDelivery & right)
+{
+	return left.operationId == right.operationId
+		&& left.unitType == right.unitType
+		&& left.role == right.role
+		&& left.snapshot.policyUpdateId
+			== right.snapshot.policyUpdateId
+		&& left.snapshot.operationGeneration
+			== right.snapshot.operationGeneration
+		&& left.snapshot.action == right.snapshot.action
+		&& left.snapshot.attemptGeneration
+			== right.snapshot.attemptGeneration
+		&& left.snapshot.effectKind
+			== right.snapshot.effectKind
+		&& left.snapshot.effectFrame
+			== right.snapshot.effectFrame;
+}
+
+inline bool voiEnqueueFamilyEffectTelemetryDelivery(
+	const VoiFamilyEffectTelemetryDelivery & delivery,
+	VoiFamilyEffectTelemetryDeliveryQueue & queue)
+{
+	if (delivery.operationId.empty()
+		|| delivery.snapshot.effectKind.empty()
+		|| delivery.snapshot.effectCount == 0
+		|| delivery.snapshot.effectFrame == 0)
+	{
+		return false;
+	}
+	for (const auto & pending : queue.pending)
+	{
+		if (voiSameFamilyEffectTelemetryDelivery(
+			pending,
+			delivery))
+		{
+			return false;
+		}
+	}
+	for (const auto & acknowledged : queue.acknowledged)
+	{
+		if (voiSameFamilyEffectTelemetryDelivery(
+			acknowledged,
+			delivery))
+		{
+			return false;
+		}
+	}
+	queue.pending.push_back(delivery);
+	return true;
+}
+
+inline void voiAcknowledgeFamilyEffectTelemetryDeliveries(
+	VoiFamilyEffectTelemetryDeliveryQueue & queue)
+{
+	for (const auto & delivery : queue.pending)
+	{
+		queue.acknowledged.push_back(delivery);
+	}
+	queue.pending.clear();
+	const std::size_t maximumAcknowledged = 128;
+	if (queue.acknowledged.size() > maximumAcknowledged)
+	{
+		queue.acknowledged.erase(
+			queue.acknowledged.begin(),
+			queue.acknowledged.begin()
+				+ (queue.acknowledged.size()
+					- maximumAcknowledged));
+	}
+}
+
+inline bool voiLatchFamilyEffectForTelemetry(
+	const VoiFamilyEffectTelemetrySnapshot & snapshot,
+	VoiFamilyEffectTelemetryLatch & latch)
+{
+	if (snapshot.effectKind.empty()
+		|| snapshot.effectCount == 0
+		|| snapshot.effectFrame == 0)
+	{
+		return false;
+	}
+	if (latch.pending)
+	{
+		return false;
+	}
+	if (latch.acknowledged
+		&& latch.acknowledgedPolicyUpdateId
+			== snapshot.policyUpdateId
+		&& latch.acknowledgedOperationGeneration
+			== snapshot.operationGeneration
+		&& latch.acknowledgedAction == snapshot.action
+		&& latch.acknowledgedAttemptGeneration
+			== snapshot.attemptGeneration
+		&& latch.acknowledgedEffectKind == snapshot.effectKind)
+	{
+		return false;
+	}
+	latch.pendingSnapshot = snapshot;
+	latch.pending = true;
+	return true;
+}
+
+inline const VoiFamilyEffectTelemetrySnapshot *
+voiPeekFamilyEffectForTelemetry(
+	const VoiFamilyEffectTelemetryLatch & latch)
+{
+	return latch.pending
+		? &latch.pendingSnapshot
+		: nullptr;
+}
+
+inline const VoiFamilyEffectTelemetrySnapshot *
+voiPeekFamilyEffectForTelemetry(
+	const VoiFamilyEffectTelemetryLatch & latch,
+	std::uint64_t operationGeneration)
+{
+	if (!latch.pending
+		|| latch.pendingSnapshot.operationGeneration
+			!= operationGeneration)
+	{
+		return nullptr;
+	}
+	return &latch.pendingSnapshot;
+}
+
+inline VoiFamilyEffectTelemetrySnapshot
+voiSelectFamilyEffectForTelemetry(
+	const VoiFamilyEffectTelemetrySnapshot & liveSnapshot,
+	const VoiFamilyEffectTelemetryLatch & latch,
+	std::uint64_t operationGeneration)
+{
+	const auto * pending =
+		voiPeekFamilyEffectForTelemetry(
+			latch,
+			operationGeneration);
+	return pending != nullptr
+		? *pending
+		: liveSnapshot;
+}
+
+inline bool voiFamilyEffectHasMatchingSubmission(
+	const VoiFamilyEffectTelemetrySnapshot & snapshot,
+	const std::string & policyUpdateId,
+	std::uint64_t operationGeneration,
+	std::uint32_t observationFrame)
+{
+	return !policyUpdateId.empty()
+		&& snapshot.policyUpdateId == policyUpdateId
+		&& snapshot.operationGeneration == operationGeneration
+		&& snapshot.attemptGeneration > 0
+		&& snapshot.submittedCount > 0
+		&& snapshot.submittedFrame > 0
+		&& observationFrame > snapshot.submittedFrame;
+}
+
+inline bool voiFamilyEffectHasMatchingObservation(
+	const VoiFamilyEffectTelemetrySnapshot & snapshot,
+	const std::string & policyUpdateId,
+	std::uint64_t operationGeneration,
+	std::uint32_t observationFrame,
+	bool unitSubmissionMatched,
+	bool movementObserved,
+	bool engagementObserved)
+{
+	return unitSubmissionMatched
+		&& (movementObserved || engagementObserved)
+		&& voiFamilyEffectHasMatchingSubmission(
+			snapshot,
+			policyUpdateId,
+			operationGeneration,
+			observationFrame);
+}
+
+inline bool voiAcknowledgeFamilyEffectTelemetry(
+	VoiFamilyEffectTelemetryLatch & latch,
+	const VoiFamilyEffectTelemetrySnapshot & serializedSnapshot)
+{
+	if (!latch.pending)
+	{
+		return false;
+	}
+	if (latch.pendingSnapshot.policyUpdateId
+			!= serializedSnapshot.policyUpdateId
+		|| latch.pendingSnapshot.operationGeneration
+			!= serializedSnapshot.operationGeneration
+		|| latch.pendingSnapshot.action
+			!= serializedSnapshot.action
+		|| latch.pendingSnapshot.attemptGeneration
+			!= serializedSnapshot.attemptGeneration
+		|| latch.pendingSnapshot.effectKind
+			!= serializedSnapshot.effectKind
+		|| latch.pendingSnapshot.effectFrame
+			!= serializedSnapshot.effectFrame)
+	{
+		return false;
+	}
+	latch.acknowledged = true;
+	latch.acknowledgedPolicyUpdateId =
+		latch.pendingSnapshot.policyUpdateId;
+	latch.acknowledgedOperationGeneration =
+		latch.pendingSnapshot.operationGeneration;
+	latch.acknowledgedAction =
+		latch.pendingSnapshot.action;
+	latch.acknowledgedAttemptGeneration =
+		latch.pendingSnapshot.attemptGeneration;
+	latch.acknowledgedEffectKind =
+		latch.pendingSnapshot.effectKind;
+	latch.pending = false;
+	return true;
+}
+
+template <typename Acknowledge>
+inline bool voiWriteAuthoritativeTelemetryFile(
+	const std::string & path,
+	const std::string & payload,
+	Acknowledge acknowledge)
+{
+	std::ofstream telemetry(path.c_str());
+	if (!telemetry.good())
+	{
+		return false;
+	}
+	telemetry << payload;
+	telemetry.close();
+	if (telemetry.fail())
+	{
+		return false;
+	}
+	acknowledge();
+	return true;
+}
