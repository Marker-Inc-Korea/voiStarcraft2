+void CombatCommander::acknowledgeVoiFamilyEffects()
+{
+	for (auto & operation : m_voiOperations)
+	{
+		for (auto & evidenceEntry :
+			operation.familyEvidenceByKey)
+		{
+			auto & evidence = evidenceEntry.second;
+			const auto * pending =
+				voiPeekFamilyEffectForTelemetry(
+					evidence.telemetryLatch);
+			if (pending == nullptr)
+			{
+				continue;
+			}
+			voiAcknowledgeFamilyEffectTelemetry(
+				evidence.telemetryLatch,
+				*pending);
+		}
+	}
+	voiAcknowledgeFamilyEffectTelemetryDeliveries(
+		m_voiFamilyEffectTelemetryDeliveries);
+}
