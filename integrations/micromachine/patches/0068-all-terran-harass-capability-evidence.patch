+std::string voiTerranOperationFamily(const std::string & unitType)
+{
+	if (unitType == "TERRAN_MARINE") return "marine";
+	if (unitType == "TERRAN_MARAUDER") return "marauder";
+	if (unitType == "TERRAN_REAPER") return "reaper";
+	if (unitType == "TERRAN_GHOST") return "ghost";
+	if (unitType == "TERRAN_HELLION"
+		|| unitType == "TERRAN_HELLIONTANK")
+	{
+		return "hellion_hellbat";
+	}
+	if (unitType == "TERRAN_WIDOWMINE"
+		|| unitType == "TERRAN_WIDOWMINEBURROWED")
+	{
+		return "widow_mine";
+	}
+	if (unitType == "TERRAN_CYCLONE") return "cyclone";
+	if (unitType == "TERRAN_SIEGETANK"
+		|| unitType == "TERRAN_SIEGETANKSIEGED")
+	{
+		return "siege_tank";
+	}
+	if (unitType == "TERRAN_THOR"
+		|| unitType == "TERRAN_THORAP")
+	{
+		return "thor";
+	}
+	if (unitType == "TERRAN_MEDIVAC") return "medivac";
+	if (unitType == "TERRAN_RAVEN") return "raven";
+	if (unitType == "TERRAN_VIKINGFIGHTER"
+		|| unitType == "TERRAN_VIKINGASSAULT")
+	{
+		return "viking";
+	}
+	if (unitType == "TERRAN_BANSHEE") return "banshee";
+	if (unitType == "TERRAN_LIBERATOR"
+		|| unitType == "TERRAN_LIBERATORAG")
+	{
+		return "liberator";
+	}
+	if (unitType == "TERRAN_BATTLECRUISER") return "battlecruiser";
+	return "";
+}
+
+std::string voiCanonicalOperationTaskType(const std::string & taskType)
+{
+	if (taskType == "scout_with_units") return "scout";
+	if (taskType == "pressure_with_main_army") return "attack";
+	if (taskType == "defend_with_units") return "defend";
+	if (taskType == "harass_with_units") return "harass";
+	return taskType;
+}
+
+int voiOperationSquadOrderType(const std::string & taskType)
+{
+	if (taskType == "scout") return SquadOrderTypes::Scout;
+	if (taskType == "defend") return SquadOrderTypes::Defend;
+	if (taskType == "harass") return SquadOrderTypes::Harass;
+	if (taskType == "attack") return SquadOrderTypes::Attack;
+	return SquadOrderTypes::Idle;
+}
+
+float voiOperationSquadOrderRadius(const std::string & taskType)
+{
+	if (taskType == "scout") return ScoutOrderRadius;
+	if (taskType == "harass") return HarassOrderRadius;
+	return DefaultOrderRadius;
+}
+
+void voiSetOperationSquadOrder(
+	VoiOperationState & operation,
+	Squad & squad,
+	size_t orderType,
+	const CCPosition & position,
+	float radius,
+	const std::string & status)
+{
+	operation.squadOrderType = orderType;
+	operation.squadOrderRadius = radius;
+	squad.setSquadOrder(
+		SquadOrder(orderType, position, radius, status));
+}
+
+std::string voiSquadOrderName(size_t orderType)
+{
+	if (orderType == SquadOrderTypes::Scout) return "scout";
+	if (orderType == SquadOrderTypes::Defend) return "defend";
+	if (orderType == SquadOrderTypes::Harass) return "harass";
+	if (orderType == SquadOrderTypes::Attack) return "attack";
+	if (orderType == SquadOrderTypes::Retreat) return "retreat";
+	if (orderType == SquadOrderTypes::Regroup) return "regroup";
+	if (orderType == SquadOrderTypes::Idle) return "idle";
+	return "none";
+}
+
+std::string voiOperationFamilyEvidenceKey(
+	const std::string & unitType,
+	const std::string & role)
+{
+	return voiTerranOperationFamily(unitType) + "|" + role;
+}
+
+VoiOperationState::FamilyExecutionEvidence &
+voiEnsureOperationFamilyEvidence(
+	VoiOperationState & operation,
+	const std::string & unitType,
+	const std::string & role)
+{
+	const std::string key =
+		voiOperationFamilyEvidenceKey(unitType, role);
+	auto & evidence = operation.familyEvidenceByKey[key];
+	evidence.family = voiTerranOperationFamily(unitType);
+	evidence.unitType = unitType;
+	evidence.role = role;
+	return evidence;
+}
+
+std::string voiOperationFamilyActionName(const UnitAction & action)
+{
+	switch (action.microActionType)
+	{
+	case MicroActionType::AttackMove:
+		return "attack_move";
+	case MicroActionType::AttackUnit:
+		return "attack_unit";
+	case MicroActionType::Move:
+		return "move";
+	case MicroActionType::Ability:
+	case MicroActionType::AbilityPosition:
+	case MicroActionType::AbilityTarget:
+	case MicroActionType::ToggleAbility:
+		return std::string("ability:")
+			+ sc2::AbilityTypeToName(action.abilityID);
+	case MicroActionType::RightClick:
+		return "right_click";
+	case MicroActionType::Stop:
+		return "stop";
+	default:
+		return action.description.empty()
+			? "unknown"
+			: action.description;
+	}
+}
+
+std::string voiOperationRequiredEffect(const UnitAction & action)
+{
+	switch (action.microActionType)
+	{
+	case MicroActionType::Ability:
+	case MicroActionType::AbilityPosition:
+	case MicroActionType::AbilityTarget:
+	case MicroActionType::ToggleAbility:
+		return "ability_state_or_effect";
+	default:
+		return "movement_or_engagement";
+	}
+}
+
+bool voiOperationAbilityStateObserved(
+	const VoiOperationState::FamilyExecutionEvidence & evidence,
+	const Unit & unit)
+{
+	const std::string & action = evidence.action;
+	const auto unitType = unit.getAPIUnitType();
+	if (action.find("MORPH_SIEGEMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_SIEGETANKSIEGED;
+	if (action.find("UNSIEGE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_SIEGETANK;
+	if (action.find("BURROWDOWN_WIDOWMINE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_WIDOWMINEBURROWED;
+	if (action.find("BURROWUP_WIDOWMINE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_WIDOWMINE;
+	if (action.find("MORPH_HELLBAT") != std::string::npos
+		|| action.find("MORPH_HELLIONTANK") != std::string::npos)
+	{
+		return unitType == sc2::UNIT_TYPEID::TERRAN_HELLIONTANK;
+	}
+	if (action.find("MORPH_HELLION") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_HELLION;
+	if (action.find("MORPH_VIKINGASSAULTMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_VIKINGASSAULT;
+	if (action.find("MORPH_VIKINGFIGHTERMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_VIKINGFIGHTER;
+	if (action.find("MORPH_LIBERATORAGMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_LIBERATORAG;
+	if (action.find("MORPH_LIBERATORAAMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_LIBERATOR;
+	if (action.find("MORPH_THORHIGHIMPACTMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_THORAP;
+	if (action.find("MORPH_THOREXPLOSIVEMODE") != std::string::npos)
+		return unitType == sc2::UNIT_TYPEID::TERRAN_THOR;
+	if (action.find("CLOAKON") != std::string::npos)
+		return unit.getUnitPtr()->cloak != sc2::Unit::NotCloaked;
+	if (action.find("CLOAKOFF") != std::string::npos)
+		return unit.getUnitPtr()->cloak == sc2::Unit::NotCloaked;
+	return false;
+}
+
+VoiFamilyEffectTelemetrySnapshot voiFamilyEffectTelemetrySnapshot(
+	uint64_t operationGeneration,
+	const VoiOperationState::FamilyExecutionEvidence & evidence)
+{
+	VoiFamilyEffectTelemetrySnapshot snapshot;
+	snapshot.operationGeneration = operationGeneration;
+	snapshot.action = evidence.action;
+	snapshot.requiredEffect = evidence.requiredEffect;
+	snapshot.attemptGeneration = evidence.attemptGeneration;
+	snapshot.attemptedCount = evidence.attemptedCount;
+	snapshot.attemptedFrame = evidence.attemptedFrame;
+	snapshot.submittedCount = evidence.submittedCount;
+	snapshot.submittedFrame = evidence.submittedFrame;
+	snapshot.effectKind = evidence.effectKind;
+	snapshot.effectCount = evidence.effectUnitTags.size();
+	snapshot.effectFrame = evidence.effectFrame;
+	snapshot.blockerManager = evidence.blockerManager;
+	snapshot.blockerReason = evidence.blockerReason;
+	return snapshot;
+}
+
+VoiFamilyEffectTelemetrySnapshot voiSelectFamilyEffectTelemetry(
+	uint64_t operationGeneration,
+	const VoiOperationState::FamilyExecutionEvidence & evidence)
+{
+	return voiSelectFamilyEffectForTelemetry(
+		voiFamilyEffectTelemetrySnapshot(
+			operationGeneration,
+			evidence),
+			evidence.telemetryLatch,
+			operationGeneration);
+}
