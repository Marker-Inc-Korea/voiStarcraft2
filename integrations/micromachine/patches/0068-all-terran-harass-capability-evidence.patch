diff --git a/tests/family_effect_lifecycle_test.cpp b/tests/family_effect_lifecycle_test.cpp
new file mode 100644
index 0000000..c08b535
--- /dev/null
+++ b/tests/family_effect_lifecycle_test.cpp
@@ -0,0 +1,344 @@
+#include "voi_family_effect_lifecycle.hpp"
+
+#include <cassert>
+#include <cstdio>
+
+VoiFamilyEffectTelemetrySnapshot effect(
+	const char * policyUpdateId,
+	std::uint64_t operationGeneration,
+	const char * action,
+	std::uint64_t attemptGeneration,
+	const char * effectKind,
+	std::size_t effectCount,
+	std::uint32_t effectFrame)
+{
+	VoiFamilyEffectTelemetrySnapshot snapshot;
+	snapshot.policyUpdateId = policyUpdateId;
+	snapshot.operationGeneration = operationGeneration;
+	snapshot.action = action;
+	snapshot.requiredEffect = "ability_state_or_effect";
+	snapshot.attemptGeneration = attemptGeneration;
+	snapshot.attemptedCount = 1;
+	snapshot.attemptedFrame = effectFrame - 2;
+	snapshot.submittedCount = 1;
+	snapshot.submittedFrame = effectFrame - 1;
+	snapshot.effectKind = effectKind;
+	snapshot.effectCount = effectCount;
+	snapshot.effectFrame = effectFrame;
+	return snapshot;
+}
+
+VoiFamilyEffectTelemetryDelivery delivery(
+	const char * operationId,
+	const char * unitType,
+	const char * role,
+	const VoiFamilyEffectTelemetrySnapshot & snapshot)
+{
+	VoiFamilyEffectTelemetryDelivery value;
+	value.operationId = operationId;
+	value.unitType = unitType;
+	value.role = role;
+	value.snapshot = snapshot;
+	return value;
+}
+
+int main()
+{
+	VoiFamilyEffectTelemetryLatch latch;
+
+	// observe A -> Plan B -> submit B -> telemetry still emits A.
+	const auto observedSiege =
+		effect(
+			"update-a",
+			4,
+			"ability:MORPH_SIEGEMODE",
+			7,
+			"ability_state",
+			1,
+			102);
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		latch));
+	auto liveEvidence =
+		effect(
+			"update-a",
+			4,
+			"attack_move",
+			8,
+			"movement",
+			1,
+			103);
+	liveEvidence.attemptedFrame = 103;
+	liveEvidence.submittedFrame = 103;
+	const auto firstTelemetry =
+		voiSelectFamilyEffectForTelemetry(
+			liveEvidence,
+			latch,
+			4);
+	assert(firstTelemetry.action
+		== "ability:MORPH_SIEGEMODE");
+	assert(firstTelemetry.effectKind == "ability_state");
+
+	// Successful telemetry acknowledgement removes A without mutating live B.
+	assert(voiAcknowledgeFamilyEffectTelemetry(
+		latch,
+		observedSiege));
+	assert(voiPeekFamilyEffectForTelemetry(
+		latch,
+		4) == nullptr);
+	const auto followingTelemetry =
+		voiSelectFamilyEffectForTelemetry(
+			liveEvidence,
+			latch,
+			4);
+	assert(followingTelemetry.action == "attack_move");
+	assert(followingTelemetry.submittedCount == 1);
+
+	// A persistent state cannot relatch the same action/attempt generation.
+	auto persistentSiege = observedSiege;
+	persistentSiege.effectFrame = 104;
+	assert(!voiLatchFamilyEffectForTelemetry(
+		persistentSiege,
+		latch));
+
+	// The observation pass latches the fully aggregated same-frame count.
+	VoiFamilyEffectTelemetryLatch aggregateLatch;
+	const auto aggregateMovement =
+		effect(
+			"update-c",
+			9,
+			"attack_move",
+			12,
+			"movement",
+			3,
+			220);
+	assert(voiLatchFamilyEffectForTelemetry(
+		aggregateMovement,
+		aggregateLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		aggregateLatch,
+		9)->effectCount == 3);
+
+	// Live movement cannot overwrite a pending ability delivery.
+	VoiFamilyEffectTelemetryLatch orderedLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		orderedLatch));
+	assert(!voiLatchFamilyEffectForTelemetry(
+		liveEvidence,
+		orderedLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		orderedLatch,
+		4)->effectKind == "ability_state");
+	assert(voiAcknowledgeFamilyEffectTelemetry(
+		orderedLatch,
+		observedSiege));
+	assert(liveEvidence.effectKind == "movement");
+
+	// A local latch keeps the oldest unacknowledged snapshot.
+	VoiFamilyEffectTelemetryLatch generationLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		generationLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		generationLatch,
+		5) == nullptr);
+	const auto nextGeneration =
+		effect(
+			"update-b",
+			5,
+			"ability:MORPH_SIEGEMODE",
+			8,
+			"ability_state",
+			1,
+			300);
+	assert(!voiLatchFamilyEffectForTelemetry(
+		nextGeneration,
+		generationLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		generationLatch)->operationGeneration == 4);
+
+	// The immutable delivery queue preserves effects across retarget/reset.
+	VoiFamilyEffectTelemetryDeliveryQueue deliveryQueue;
+	const auto siegeDelivery =
+		delivery(
+			"operation-alpha",
+			"TERRAN_SIEGETANK",
+			"siege",
+			observedSiege);
+	assert(voiEnqueueFamilyEffectTelemetryDelivery(
+		siegeDelivery,
+		deliveryQueue));
+	assert(!voiEnqueueFamilyEffectTelemetryDelivery(
+		siegeDelivery,
+		deliveryQueue));
+	generationLatch = VoiFamilyEffectTelemetryLatch();
+	assert(!generationLatch.pending);
+	assert(deliveryQueue.pending.size() == 1);
+	assert(deliveryQueue.pending.front()
+		.snapshot.operationGeneration == 4);
+	const auto nextGenerationDelivery =
+		delivery(
+			"operation-alpha",
+			"TERRAN_SIEGETANK",
+			"siege",
+			nextGeneration);
+	assert(voiEnqueueFamilyEffectTelemetryDelivery(
+		nextGenerationDelivery,
+		deliveryQueue));
+	assert(deliveryQueue.pending.size() == 2);
+	assert(deliveryQueue.pending.back()
+		.snapshot.operationGeneration == 5);
+
+	// A newer policy cannot inherit or acknowledge an older update's effect.
+	VoiFamilyEffectTelemetryLatch policyLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		policyLatch));
+	auto wrongPolicy = observedSiege;
+	wrongPolicy.policyUpdateId = "update-b";
+	auto newerPolicyLive = liveEvidence;
+	newerPolicyLive.policyUpdateId = "update-b";
+	const auto olderPolicyDelivery =
+		voiSelectFamilyEffectForTelemetry(
+			newerPolicyLive,
+			policyLatch,
+			4);
+	assert(olderPolicyDelivery.policyUpdateId == "update-a");
+	assert(!voiAcknowledgeFamilyEffectTelemetry(
+		policyLatch,
+		wrongPolicy));
+	assert(voiPeekFamilyEffectForTelemetry(
+		policyLatch,
+		4) != nullptr);
+
+	// Submission identity must precede effect observation.
+	auto noSubmission = effect(
+		"update-d",
+		6,
+		"ability:CLOAKON",
+		9,
+		"ability_state",
+		1,
+		420);
+	noSubmission.submittedCount = 0;
+	noSubmission.submittedFrame = 0;
+	assert(!voiFamilyEffectHasMatchingSubmission(
+		noSubmission,
+		"update-d",
+		6,
+		420));
+	assert(!voiFamilyEffectHasMatchingSubmission(
+		noSubmission,
+		"update-d",
+		6,
+		421));
+	auto submitted = noSubmission;
+	submitted.submittedCount = 1;
+	submitted.submittedFrame = 420;
+	assert(!voiFamilyEffectHasMatchingSubmission(
+		submitted,
+		"update-d",
+		6,
+		420));
+	assert(voiFamilyEffectHasMatchingSubmission(
+		submitted,
+		"update-d",
+		6,
+		421));
+	assert(!voiFamilyEffectHasMatchingSubmission(
+		submitted,
+		"update-e",
+		6,
+		421));
+	assert(!voiFamilyEffectHasMatchingObservation(
+		noSubmission,
+		"update-d",
+		6,
+		421,
+		false,
+		false,
+		true));
+	assert(!voiFamilyEffectHasMatchingObservation(
+		submitted,
+		"update-d",
+		6,
+		420,
+		true,
+		false,
+		true));
+	// Same-family unit B cannot claim unit A's submitted engagement.
+	assert(!voiFamilyEffectHasMatchingObservation(
+		submitted,
+		"update-d",
+		6,
+		421,
+		false,
+		false,
+		true));
+	assert(voiFamilyEffectHasMatchingObservation(
+		submitted,
+		"update-d",
+		6,
+		421,
+		true,
+		false,
+		true));
+
+	// Failed writes retain both local and immutable delivery evidence.
+	VoiFamilyEffectTelemetryLatch writeFailureLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		writeFailureLatch));
+	VoiFamilyEffectTelemetryDeliveryQueue writeFailureQueue;
+	assert(voiEnqueueFamilyEffectTelemetryDelivery(
+		siegeDelivery,
+		writeFailureQueue));
+	bool failedWriteAcknowledged = false;
+	assert(!voiWriteAuthoritativeTelemetryFile(
+		".",
+		"{\"effect\":\"ability_state\"}\n",
+		[&]() {
+			failedWriteAcknowledged = true;
+			voiAcknowledgeFamilyEffectTelemetry(
+				writeFailureLatch,
+				observedSiege);
+			voiAcknowledgeFamilyEffectTelemetryDeliveries(
+				writeFailureQueue);
+		}));
+	assert(!failedWriteAcknowledged);
+	assert(voiPeekFamilyEffectForTelemetry(
+		writeFailureLatch,
+		4) != nullptr);
+	assert(writeFailureQueue.pending.size() == 1);
+	assert(writeFailureQueue.acknowledged.empty());
+
+	// Retarget can discard family state without losing queued evidence.
+	writeFailureLatch = VoiFamilyEffectTelemetryLatch();
+	assert(!writeFailureLatch.pending);
+	assert(writeFailureQueue.pending.size() == 1);
+
+	// A successful authoritative write acknowledges serialized deliveries.
+	const char * successfulTelemetryPath =
+		"voi_family_effect_lifecycle_test_telemetry.json";
+	bool successfulWriteAcknowledged = false;
+	assert(voiWriteAuthoritativeTelemetryFile(
+		successfulTelemetryPath,
+		"{\"effect\":\"ability_state\"}\n",
+		[&]() {
+			successfulWriteAcknowledged = true;
+			voiAcknowledgeFamilyEffectTelemetryDeliveries(
+				writeFailureQueue);
+		}));
+	assert(successfulWriteAcknowledged);
+	assert(writeFailureQueue.pending.empty());
+	assert(writeFailureQueue.acknowledged.size() == 1);
+	assert(writeFailureQueue.acknowledged.front()
+		.snapshot.policyUpdateId == "update-a");
+	assert(!voiEnqueueFamilyEffectTelemetryDelivery(
+		siegeDelivery,
+		writeFailureQueue));
+	assert(std::remove(successfulTelemetryPath) == 0);
+
+	return 0;
+}
