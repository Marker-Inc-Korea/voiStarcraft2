diff --git a/tests/family_effect_lifecycle_test.cpp b/tests/family_effect_lifecycle_test.cpp
new file mode 100644
index 0000000..747ccb2
--- /dev/null
+++ b/tests/family_effect_lifecycle_test.cpp
@@ -0,0 +1,138 @@
+#include "voi_family_effect_lifecycle.hpp"
+
+#include <cassert>
+
+VoiFamilyEffectTelemetrySnapshot effect(
+	std::uint64_t operationGeneration,
+	const char * action,
+	std::uint64_t attemptGeneration,
+	const char * effectKind,
+	std::size_t effectCount,
+	std::uint32_t effectFrame)
+{
+	VoiFamilyEffectTelemetrySnapshot snapshot;
+	snapshot.operationGeneration = operationGeneration;
+	snapshot.action = action;
+	snapshot.requiredEffect = "ability_state_or_effect";
+	snapshot.attemptGeneration = attemptGeneration;
+	snapshot.attemptedCount = 1;
+	snapshot.attemptedFrame = effectFrame - 2;
+	snapshot.submittedCount = 1;
+	snapshot.submittedFrame = effectFrame - 1;
+	snapshot.effectKind = effectKind;
+	snapshot.effectCount = effectCount;
+	snapshot.effectFrame = effectFrame;
+	return snapshot;
+}
+
+int main()
+{
+	VoiFamilyEffectTelemetryLatch latch;
+
+	// observe A -> Plan B -> submit B -> telemetry still emits A.
+	const auto observedSiege =
+		effect(
+			4,
+			"ability:MORPH_SIEGEMODE",
+			7,
+			"ability_state",
+			1,
+			102);
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		latch));
+	auto liveEvidence =
+		effect(
+			4,
+			"attack_move",
+			8,
+			"movement",
+			1,
+			103);
+	liveEvidence.attemptedFrame = 103;
+	liveEvidence.submittedFrame = 103;
+	const auto firstTelemetry =
+		voiSelectFamilyEffectForTelemetry(
+			liveEvidence,
+			latch,
+			4);
+	assert(firstTelemetry.action
+		== "ability:MORPH_SIEGEMODE");
+	assert(firstTelemetry.effectKind == "ability_state");
+
+	// Successful telemetry acknowledgement removes A without mutating live B.
+	assert(voiAcknowledgeFamilyEffectTelemetry(latch, 4));
+	assert(voiPeekFamilyEffectForTelemetry(latch, 4) == nullptr);
+	const auto followingTelemetry =
+		voiSelectFamilyEffectForTelemetry(
+			liveEvidence,
+			latch,
+			4);
+	assert(followingTelemetry.action == "attack_move");
+	assert(followingTelemetry.submittedCount == 1);
+
+	// A persistent state cannot relatch the same action/attempt generation.
+	auto persistentSiege = observedSiege;
+	persistentSiege.effectFrame = 104;
+	assert(!voiLatchFamilyEffectForTelemetry(
+		persistentSiege,
+		latch));
+
+	// The observation pass latches the fully aggregated same-frame count.
+	VoiFamilyEffectTelemetryLatch aggregateLatch;
+	const auto aggregateMovement =
+		effect(
+			9,
+			"attack_move",
+			12,
+			"movement",
+			3,
+			220);
+	assert(voiLatchFamilyEffectForTelemetry(
+		aggregateMovement,
+		aggregateLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		aggregateLatch,
+		9)->effectCount == 3);
+
+	// Live movement cannot overwrite a pending ability delivery.
+	VoiFamilyEffectTelemetryLatch orderedLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		orderedLatch));
+	assert(!voiLatchFamilyEffectForTelemetry(
+		liveEvidence,
+		orderedLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		orderedLatch,
+		4)->effectKind == "ability_state");
+	assert(voiAcknowledgeFamilyEffectTelemetry(
+		orderedLatch,
+		4));
+	assert(liveEvidence.effectKind == "movement");
+
+	// A new operation generation neither exposes nor blocks an old latch.
+	VoiFamilyEffectTelemetryLatch generationLatch;
+	assert(voiLatchFamilyEffectForTelemetry(
+		observedSiege,
+		generationLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		generationLatch,
+		5) == nullptr);
+	const auto nextGeneration =
+		effect(
+			5,
+			"ability:MORPH_SIEGEMODE",
+			8,
+			"ability_state",
+			1,
+			300);
+	assert(voiLatchFamilyEffectForTelemetry(
+		nextGeneration,
+		generationLatch));
+	assert(voiPeekFamilyEffectForTelemetry(
+		generationLatch,
+		5)->operationGeneration == 5);
+
+	return 0;
+}
