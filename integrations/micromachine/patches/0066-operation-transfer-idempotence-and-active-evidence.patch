--- a/src/voi_operation_transfer_admission.hpp
+++ b/src/voi_operation_transfer_admission.hpp
@@ -13,6 +13,9 @@ struct VoiOperationTransferEndpoint
 	std::string operationId;
 	std::string counterpartOperationId;
 	std::string editAction;
+	std::string existingCounterpartOperationId;
+	std::string existingEditAction;
+	std::string existingEditResolution;
 	std::uint64_t existingGeneration = 0;
 	std::uint64_t requestedGeneration = 0;
 	bool requestedPresent = false;
@@ -203,6 +206,66 @@ inline bool voiShouldReconcileExistingOperation(
 	return !completed && !staticBlock;
 }
 
+inline bool voiOperationTransferAlreadyApplied(
+	const VoiOperationTransferEndpoint & first,
+	const VoiOperationTransferEndpoint & second)
+{
+	if (!first.requestedPresent
+		|| !second.requestedPresent
+		|| !first.blocker.empty()
+		|| !second.blocker.empty()
+		|| first.operationId.empty()
+		|| second.operationId.empty()
+		|| first.operationId == second.operationId
+		|| first.counterpartOperationId != second.operationId
+		|| second.counterpartOperationId != first.operationId
+		|| first.existingCounterpartOperationId
+			!= first.counterpartOperationId
+		|| second.existingCounterpartOperationId
+			!= second.counterpartOperationId
+		|| first.existingEditAction != first.editAction
+		|| second.existingEditAction != second.editAction
+		|| first.existingEditResolution != "applied"
+		|| second.existingEditResolution != "applied"
+		|| first.requestedGeneration != first.existingGeneration
+		|| second.requestedGeneration != second.existingGeneration)
+	{
+		return false;
+	}
+	return (first.editAction == "transfer_in"
+			&& second.editAction == "transfer_out")
+		|| (first.editAction == "transfer_out"
+			&& second.editAction == "transfer_in");
+}
+
+template <typename Mutation>
+bool voiApplyOperationTransferMutationOnce(
+	const VoiOperationTransferEndpoint & first,
+	const VoiOperationTransferEndpoint & second,
+	Mutation mutation)
+{
+	if (voiOperationTransferAlreadyApplied(first, second))
+	{
+		return false;
+	}
+	mutation();
+	return true;
+}
+
+template <typename Operation, typename Annotation>
+void voiApplyRejectedOperationEditMetadata(
+	Operation & operation,
+	Annotation annotation)
+{
+	const std::string activeLastAction =
+		operation.lastAction;
+	const auto activeLastActionFrame =
+		operation.lastActionFrame;
+	annotation();
+	operation.lastAction = activeLastAction;
+	operation.lastActionFrame = activeLastActionFrame;
+}
+
 inline VoiOperationTransferAdmission voiDecideOperationTransferAdmission(
 	const VoiOperationTransferEndpoint & first,
 	const VoiOperationTransferEndpoint & second)
