+inline bool voiOperationTransferAlreadyApplied(
+	const VoiOperationTransferEndpoint & first,
+	const VoiOperationTransferEndpoint & second)
+{
+	if (!first.requestedPresent
+		|| !second.requestedPresent
+		|| !first.blocker.empty()
+		|| !second.blocker.empty()
+		|| first.operationId.empty()
+		|| second.operationId.empty()
+		|| first.operationId == second.operationId
+		|| first.counterpartOperationId != second.operationId
+		|| second.counterpartOperationId != first.operationId
+		|| first.existingCounterpartOperationId
+			!= first.counterpartOperationId
+		|| second.existingCounterpartOperationId
+			!= second.counterpartOperationId
+		|| first.existingEditAction != first.editAction
+		|| second.existingEditAction != second.editAction
+		|| first.existingEditResolution != "applied"
+		|| second.existingEditResolution != "applied"
+		|| first.requestedGeneration != first.existingGeneration
+		|| second.requestedGeneration != second.existingGeneration)
+	{
+		return false;
+	}
+	return (first.editAction == "transfer_in"
+			&& second.editAction == "transfer_out")
+		|| (first.editAction == "transfer_out"
+			&& second.editAction == "transfer_in");
+}
+
