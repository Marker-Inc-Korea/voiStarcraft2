+template <typename Tag, typename Owner>
+bool voiTransferOwnershipAtomically(
+	std::map<Tag, Owner> & owners,
+	const std::vector<Tag> & tags,
+	const Owner & expectedSource,
+	const Owner & destination)
+{
+	std::map<Tag, Owner> replacement = owners;
+	std::map<Tag, bool> uniqueTags;
+	for (const auto & tag : tags)
+	{
+		if (uniqueTags.find(tag) != uniqueTags.end())
+		{
+			return false;
+		}
+		uniqueTags[tag] = true;
+		const auto owner = replacement.find(tag);
+		if (owner == replacement.end()
+			|| owner->second != expectedSource)
+		{
+			return false;
+		}
+		owner->second = destination;
+	}
+	owners.swap(replacement);
+	return true;
+}
