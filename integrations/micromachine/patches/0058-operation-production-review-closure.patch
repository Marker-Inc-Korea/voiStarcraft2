+std::string
+ProductionManager::getVoiOperationProductionQueuePurgeEventsTelemetryJson()
+	const
+{
+	std::ostringstream telemetry;
+	telemetry << "[";
+	for (size_t index = 0;
+		index < m_voiOperationProductionQueuePurgeEvents.size();
+		++index)
+	{
+		if (index > 0)
+		{
+			telemetry << ",";
+		}
+		const auto & event =
+			m_voiOperationProductionQueuePurgeEvents[index];
+		telemetry
+			<< "{"
+			<< "\"operation_id\":\""
+			<< voiProductionTelemetryJsonEscape(event.operationId)
+			<< "\","
+			<< "\"generation\":" << event.generation << ","
+			<< "\"frame\":" << event.frame << ","
+			<< "\"removed_count\":" << event.removedCount
+			<< "}";
+	}
+	telemetry << "]";
+	return telemetry.str();
+}
