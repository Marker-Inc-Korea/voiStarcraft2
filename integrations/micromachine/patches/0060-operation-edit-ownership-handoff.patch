+
+std::map<std::string, int> voiOperationCompositionCounts(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	std::map<std::string, int> counts;
+	for (const auto & requirement : requirements)
+	{
+		if (!requirement.unitType.empty() && requirement.count > 0)
+		{
+			counts[requirement.unitType] += requirement.count;
+		}
+	}
+	return counts;
+}
+
+int voiOperationCompositionTotal(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	int total = 0;
+	for (const auto & count : voiOperationCompositionCounts(requirements))
+	{
+		total += count.second;
+	}
+	return total;
+}
+
+bool voiOperationCompositionMatches(
+	const std::vector<VoiOperationState::CompositionRequirement> & left,
+	const std::vector<VoiOperationState::CompositionRequirement> & right)
+{
+	return voiOperationCompositionCounts(left)
+		== voiOperationCompositionCounts(right);
+}
+
+bool voiIsSupportedOperationEditAction(const std::string & action)
+{
+	return action.empty()
+		|| action == "create"
+		|| action == "update"
+		|| action == "resize"
+		|| action == "reinforce"
+		|| action == "retarget"
+		|| action == "transfer_in"
+		|| action == "transfer_out"
+		|| action == "cancel"
+		|| action == "restart";
+}
+
+std::string voiOperationCompositionTelemetryJson(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	std::ostringstream payload;
+	payload << "[";
+	const auto counts = voiOperationCompositionCounts(requirements);
+	size_t index = 0;
+	for (const auto & count : counts)
+	{
+		if (index++ > 0)
+		{
+			payload << ",";
+		}
+		payload << "{\"unit_type\":\""
+			<< voiOperationJsonEscape(count.first)
+			<< "\",\"count\":" << count.second << "}";
+	}
+	payload << "]";
+	return payload.str();
+}
