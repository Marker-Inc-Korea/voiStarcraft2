+
+using VoiOperationCompositionKey =
+	std::pair<std::string, std::string>;
+
+std::map<VoiOperationCompositionKey, int> voiOperationCompositionCounts(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	std::map<VoiOperationCompositionKey, int> counts;
+	for (const auto & requirement : requirements)
+	{
+		if (!requirement.unitType.empty() && requirement.count > 0)
+		{
+			counts[std::make_pair(
+				requirement.unitType,
+				requirement.role)] += requirement.count;
+		}
+	}
+	return counts;
+}
+
+int voiOperationCompositionTotal(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	int total = 0;
+	for (const auto & count : voiOperationCompositionCounts(requirements))
+	{
+		total += count.second;
+	}
+	return total;
+}
+
+bool voiOperationCompositionMatches(
+	const std::vector<VoiOperationState::CompositionRequirement> & left,
+	const std::vector<VoiOperationState::CompositionRequirement> & right)
+{
+	return voiOperationCompositionCounts(left)
+		== voiOperationCompositionCounts(right);
+}
+
+bool voiOperationUnitMatchesRequirement(
+	const VoiOperationState & operation,
+	const Unit & unit,
+	const VoiOperationState::CompositionRequirement & requirement)
+{
+	if (!voiUnitMatchesCompositionToken(
+		unit,
+		requirement.unitType))
+	{
+		return false;
+	}
+	return requirement.role.empty()
+		|| voiOperationRoleForUnit(
+			&operation,
+			unit.getUnitPtr()) == requirement.role;
+}
+
+bool voiIsSupportedOperationEditAction(const std::string & action)
+{
+	return action.empty()
+		|| action == "create"
+		|| action == "update"
+		|| action == "resize"
+		|| action == "reinforce"
+		|| action == "retarget"
+		|| action == "transfer_in"
+		|| action == "transfer_out"
+		|| action == "cancel"
+		|| action == "restart";
+}
+
+std::string voiOperationCompositionTelemetryJson(
+	const std::vector<VoiOperationState::CompositionRequirement> & requirements)
+{
+	std::ostringstream payload;
+	payload << "[";
+	const auto counts = voiOperationCompositionCounts(requirements);
+	size_t index = 0;
+	for (const auto & count : counts)
+	{
+		if (index++ > 0)
+		{
+			payload << ",";
+		}
+		payload << "{\"unit_type\":\""
+			<< voiOperationJsonEscape(count.first.first)
+			<< "\",\"count\":" << count.second
+			<< ",\"role\":\""
+			<< voiOperationJsonEscape(count.first.second)
+			<< "\"}";
+	}
+	payload << "]";
+	return payload.str();
+}
