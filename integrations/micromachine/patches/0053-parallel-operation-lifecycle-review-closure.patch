+bool voiParallelOperationTerminalState(const std::string & value)
+{
+	return value == "COMPLETED"
+		|| value == "completed"
+		|| value == "CANCELLED"
+		|| value == "cancelled"
+		|| value == "EXPIRED"
+		|| value == "expired"
+		|| value == "FAILED"
+		|| value == "failed"
+		|| value == "SUPERSEDED"
+		|| value == "superseded";
+}
+
+bool voiParallelOperationIsActive(CCBot & bot, int operationIndex)
+{
+	if (!bot.Commander().isVoiPolicyActive()
+		|| operationIndex < 0
+		|| operationIndex >= voiParallelOperationCount(bot))
+	{
+		return false;
+	}
+
+	const std::string prefix =
+		"operations." + std::to_string(operationIndex);
+	const std::string operationId =
+		bot.Commander().getVoiPolicyString(
+			prefix + ".operation_id",
+			"");
+	const std::string taskType =
+		bot.Commander().getVoiPolicyString(
+			prefix + ".tactical_task.task_type",
+			"");
+	if (operationId.empty()
+		|| (taskType != "scout_with_units"
+			&& taskType != "pressure_with_main_army"
+			&& taskType != "defend_with_units")
+		|| bot.Commander().getVoiPolicyBool(
+			prefix + ".completed",
+			false)
+		|| bot.Commander().getVoiPolicyBool(
+			prefix + ".cancelled",
+			false)
+		|| voiParallelOperationTerminalState(
+			bot.Commander().getVoiPolicyString(
+				prefix + ".status",
+				""))
+		|| voiParallelOperationTerminalState(
+			bot.Commander().getVoiPolicyString(
+				prefix + ".lifetime.completion_state",
+				"active")))
+	{
+		return false;
+	}
+
+	const std::string lifetimeMode =
+		bot.Commander().getVoiPolicyString(
+			prefix + ".lifetime.mode",
+			"");
+	if (lifetimeMode == "standing_order"
+		|| lifetimeMode == "until_cancelled")
+	{
+		return true;
+	}
+
+	const int tacticalDurationSeconds = std::max(
+		0,
+		bot.Commander().getVoiPolicyInt(
+			prefix + ".tactical_task.duration_seconds",
+			0));
+	const int durationSeconds =
+		tacticalDurationSeconds > 0
+			? tacticalDurationSeconds
+			: std::max(
+				0,
+				bot.Commander().getVoiPolicyInt(
+					prefix + ".scope.duration_seconds",
+					0));
+	if (durationSeconds == 0)
+	{
+		return true;
+	}
+
+	const uint64_t issuedAtFrame =
+		static_cast<uint64_t>(
+			std::max(
+				0,
+				bot.Commander().getVoiPolicyInt(
+					"issued_at_frame",
+					0)));
+	const uint64_t deadlineFrame =
+		issuedAtFrame
+		+ static_cast<uint64_t>(durationSeconds) * 22u;
+	return static_cast<uint64_t>(bot.GetCurrentFrame())
+		<= deadlineFrame;
+}
+
+int voiActiveParallelOperationCount(CCBot & bot)
+{
+	int activeCount = 0;
+	for (int operationIndex = 0;
+		operationIndex < voiParallelOperationCount(bot);
+		++operationIndex)
+	{
+		if (voiParallelOperationIsActive(bot, operationIndex))
+		{
+			++activeCount;
+		}
+	}
+	return activeCount;
+}
