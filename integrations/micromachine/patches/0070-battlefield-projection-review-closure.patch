+inline std::uint64_t voiCurrentBattlefieldSessionEpoch()
 {
+	const auto ticks = std::chrono::duration_cast<
+		std::chrono::nanoseconds>(
+			std::chrono::system_clock::now().time_since_epoch())
+			.count();
+	return ticks > 0
+		? static_cast<std::uint64_t>(ticks)
+		: 1;
+}
+
+inline std::uint64_t voiNextBattlefieldSessionEpoch(
+	std::uint64_t previous,
+	std::uint64_t processEpoch = 0)
+{
+	if (processEpoch > previous)
+	{
+		return processEpoch;
+	}
 	return previous == std::numeric_limits<std::uint64_t>::max()
 		? previous
 		: previous + 1;
