+inline VoiBattlefieldBaseDefenderCollection
+voiBattlefieldCollectBaseDefenders(
+	const std::vector<std::uint64_t> & autonomousTags,
+	const std::vector<VoiBattlefieldDefenseOperationInput> & operations)
+{
+	VoiBattlefieldBaseDefenderCollection result;
+	std::set<std::uint64_t> unique;
+	const auto appendTags =
+		[&](const std::vector<std::uint64_t> & tags)
+		{
+			for (const auto tag : tags)
+			{
+				if (tag == 0)
+				{
+					result.evidencePresent = false;
+					continue;
+				}
+				unique.insert(tag);
+			}
+		};
+	appendTags(autonomousTags);
+	for (const auto & operation : operations)
+	{
+		if (!operation.active
+			|| !operation.defensive
+			|| !operation.targetMatchesBase)
+		{
+			continue;
+		}
+		if (!operation.squadEvidencePresent)
+		{
+			result.evidencePresent = false;
+			continue;
+		}
+		appendTags(operation.squadTags);
+	}
+	result.defenderTags.assign(unique.begin(), unique.end());
+	return result;
+}
