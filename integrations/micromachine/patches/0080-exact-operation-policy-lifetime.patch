+inline bool voiOperationPolicyTerminalState(
+	const std::string & value)
+{
+	return value == "BLOCKED"
+		|| value == "blocked"
+		|| value == "COMPLETED"
+		|| value == "completed"
+		|| value == "CANCELLED"
+		|| value == "cancelled"
+		|| value == "EXPIRED"
+		|| value == "expired"
+		|| value == "FAILED"
+		|| value == "failed"
+		|| value == "SUPERSEDED"
+		|| value == "superseded";
+}
+
+struct VoiOperationPolicyCompositionRequirement
+{
+	std::string unitType;
+	int count = 0;
+	std::string role;
+};
+
+struct VoiOperationPolicyContinuationEntry
+{
+	std::string operationId;
+	std::uint64_t generation = 0;
+	std::string operationPolicyUpdateId;
+	std::string lifetimeMode;
+	int durationSeconds = 0;
+	bool allowPartial = true;
+	std::vector<VoiOperationPolicyCompositionRequirement>
+		compositionRequirements;
+	bool active = false;
+};
+
+inline bool voiOperationPolicyCompositionMatches(
+	std::vector<VoiOperationPolicyCompositionRequirement> left,
+	std::vector<VoiOperationPolicyCompositionRequirement> right)
+{
+	const auto less =
+		[](const VoiOperationPolicyCompositionRequirement & lhs,
+			const VoiOperationPolicyCompositionRequirement & rhs)
+		{
+			if (lhs.unitType != rhs.unitType)
+			{
+				return lhs.unitType < rhs.unitType;
+			}
+			if (lhs.role != rhs.role)
+			{
+				return lhs.role < rhs.role;
+			}
+			return lhs.count < rhs.count;
+		};
+	std::sort(left.begin(), left.end(), less);
+	std::sort(right.begin(), right.end(), less);
+	if (left.size() != right.size())
+	{
+		return false;
+	}
+	for (std::size_t index = 0; index < left.size(); ++index)
+	{
+		if (left[index].unitType != right[index].unitType
+			|| left[index].count != right[index].count
+			|| left[index].role != right[index].role)
+		{
+			return false;
+		}
+	}
+	return true;
+}
+
+inline bool voiRetainExpiredPolicyForOperations(
+	const std::string & requestedPolicyUpdateId,
+	const std::vector<VoiOperationPolicyContinuationEntry> & requested,
+	const std::vector<VoiOperationPolicyContinuationEntry> & runtime)
+{
+	if (requestedPolicyUpdateId.empty()
+		|| requested.empty()
+		|| requested.size() != runtime.size())
+	{
+		return false;
+	}
+	std::set<std::pair<std::string, std::uint64_t>> requestedKeys;
+	for (const auto & request : requested)
+	{
+		if (request.operationId.empty()
+			|| request.generation == 0
+			|| request.lifetimeMode != "until_completed"
+			|| request.durationSeconds <= 0
+			|| request.allowPartial
+			|| request.compositionRequirements.empty()
+			|| !request.active
+			|| !requestedKeys.insert({
+					request.operationId,
+					request.generation
+				}).second)
+		{
+			return false;
+		}
+		int matchCount = 0;
+		for (const auto & candidate : runtime)
+		{
+			if (candidate.operationId != request.operationId
+				|| candidate.generation != request.generation)
+			{
+				continue;
+			}
+			++matchCount;
+			if (candidate.operationPolicyUpdateId
+					!= requestedPolicyUpdateId
+				|| candidate.lifetimeMode
+					!= request.lifetimeMode
+				|| candidate.durationSeconds
+					!= request.durationSeconds
+				|| candidate.allowPartial
+					!= request.allowPartial
+				|| !candidate.active
+				|| !voiOperationPolicyCompositionMatches(
+					candidate.compositionRequirements,
+					request.compositionRequirements))
+			{
+				return false;
+			}
+		}
+		if (matchCount != 1)
+		{
+			return false;
+		}
+	}
+	return true;
+}
