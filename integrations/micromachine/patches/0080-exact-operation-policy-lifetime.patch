+bool CombatCommander::canContinueExpiredVoiOperationsForPolicy(
+	const std::string & policyUpdateId,
+	const std::vector<VoiOperationPolicyContinuationEntry> &
+		requestedOperations) const
+{
+	std::vector<VoiOperationPolicyContinuationEntry>
+		runtimeOperations;
+	for (const auto & operation : m_voiOperations)
+	{
+		const bool terminal =
+			operation.completed
+			|| voiOperationPolicyTerminalState(operation.status);
+		if (terminal
+			|| operation.policyUpdateId != policyUpdateId)
+		{
+			continue;
+		}
+		VoiOperationPolicyContinuationEntry runtime;
+		runtime.operationId = operation.operationId;
+		runtime.generation = operation.generation;
+		runtime.operationPolicyUpdateId =
+			operation.policyUpdateId;
+		runtime.lifetimeMode = operation.lifetimeMode;
+		runtime.durationSeconds = operation.durationSeconds;
+		runtime.allowPartial = operation.allowPartial;
+		runtime.active = isVoiOperationActive(
+			operation.operationId,
+			operation.generation);
+		for (const auto & requirement :
+			operation.compositionRequirements)
+		{
+			runtime.compositionRequirements.push_back(
+				{
+					requirement.unitType,
+					requirement.count,
+					requirement.role
+				});
+		}
+		runtimeOperations.push_back(runtime);
+	}
+	return voiRetainExpiredPolicyForOperations(
+		policyUpdateId,
+		requestedOperations,
+		runtimeOperations);
+}
