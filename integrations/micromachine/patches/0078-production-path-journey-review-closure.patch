+		{
+			++invalidOrderCallbackCount;
+			return true;
+		});
+	CHECK(!invalidOrder.accepted);
+	CHECK(!invalidOrder.callbackExecuted);
+	CHECK(invalidOrderCallbackCount == 0);
+	CHECK(invalidOrder.receiptId.empty());
+	CHECK(invalidOrder.blocker == "invalid_squad_order_identity");
+
+	int rejectedOrderCallbackCount = 0;
