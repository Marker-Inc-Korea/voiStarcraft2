+public:
+	VoiMicroMachinePreLiveProductionExecutor()
+		: m_bot(new CCBot("voi-pre-live", "1", false))
+	{
+	}
+
+	const char * executorKind() const override
+	{
+		return "micromachine_concrete_pre_live";
+	}
+
+	const char * squadOrderExecutionPath() const override
+	{
+		return "Squad::setSquadOrder";
+	}
+
+	const char * sc2SubmissionExecutionPath() const override
+	{
+		return "Micro::*->CCBot::Actions()->UnitCommand";
+	}
+
+	VoiProductionSquadOrderReceipt issueSquadOrder(
+		const VoiProductionActionBinding & binding,
+		const std::string & squadName,
+		const std::string & squadOrderKind,
+		double squadOrderRadius,
+		const std::vector<std::uint64_t> & unitTags) override
+	{
+		std::size_t orderType = 0;
+		if (!squadOrderType(squadOrderKind, orderType))
+		{
+			VoiProductionSquadOrderReceipt receipt;
+			receipt.updateId = binding.identity.updateId;
+			receipt.operationId =
+				binding.identity.operationId;
+			receipt.generation =
+				binding.identity.generation;
+			receipt.squadName = squadName;
+			receipt.action = binding.action;
+			receipt.unitTags = unitTags;
+			receipt.blocker =
+				"unsupported_pre_live_squad_order";
+			return receipt;
+		}
+		Squad & squad = squadFor(squadName);
+		const auto previousUnits = squad.getUnits();
+		for (const auto & unit : previousUnits)
+		{
+			squad.removeUnit(unit);
+		}
+		for (const auto unitTag : unitTags)
+		{
+			squad.addUnit(Unit(unitFor(unitTag), *m_bot));
