+	CHECK(!rejectedOrder.appliedProof);
+	CHECK(rejectedOrderCallbackCount == 1);
+	CHECK(rejectedOrder.receiptId.empty());
+	CHECK(rejectedOrder.blocker == "squad_order_not_applied");
+
+	bool orderApplied = false;
