+VoiProductionSquadOrderReceipt Squad::setSquadOrder(
+	const SquadOrder & so,
+	const VoiProductionOperationIdentity & identity,
+	const std::string & action,
+	const std::vector<std::uint64_t> & unitTags)
+{
+	std::vector<std::uint64_t> actualUnitTags;
+	for (const auto & unit : m_units)
+	{
+		actualUnitTags.push_back(unit.getTag());
+	}
+	std::sort(actualUnitTags.begin(), actualUnitTags.end());
+	std::vector<std::uint64_t> requestedUnitTags = unitTags;
+	std::sort(requestedUnitTags.begin(), requestedUnitTags.end());
+	const bool membershipProof =
+		actualUnitTags == requestedUnitTags;
+	auto receipt = voiProductionIssueSquadOrder(
+		identity,
+		m_name,
+		action,
+		unitTags,
+		[&]()
+		{
+			return membershipProof
+				&& applySquadOrderState(so)
+				&& m_order.getType() == so.getType()
+				&& m_order.getPosition() == so.getPosition()
+				&& m_order.getRadius() == so.getRadius()
+				&& m_order.getStatus() == so.getStatus();
+		});
+	receipt.membershipProof = membershipProof;
+	receipt.squadOrderType = so.getType();
+	receipt.targetX = so.getPosition().x;
+	receipt.targetY = so.getPosition().y;
+	receipt.radius = so.getRadius();
+	return receipt;
 }
 
