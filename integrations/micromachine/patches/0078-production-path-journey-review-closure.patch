+
+const VoiPreLiveJson & operationState(
+	const VoiPreLiveJson & output,
+	const std::string & operationId)
+{
+	for (const auto & operation :
+		output["final_state"]["operations"])
+	{
+		if (operation["operation_id"] == operationId)
+		{
+			return operation;
+		}
+	}
+	throw std::runtime_error(
+		"missing final operation: " + operationId);
+}
+
+void checkFinalSnapshotConsistency(
+	const VoiPreLiveJson & output)
+{
+	const auto & snapshot =
+		output["snapshots"][output["snapshots"].size() - 1]
+			["state"];
+	CHECK(
+		snapshot["owners"]
+			== output["final_state"]["owners"]);
+	CHECK(
+		snapshot["owner_bindings"]
+			== output["final_state"]["owner_bindings"]);
+	CHECK(
+		snapshot["operations"]
+			== output["final_state"]["operations"]);
+}
+
+void expectRuntimeError(
+	const VoiPreLiveJson & input,
+	const std::string & expected)
+{
+	try
+	{
+		(void)runAdapter(input);
+		CHECK(false);
+	}
+	catch (const std::runtime_error & error)
+	{
+		CHECK(
+			std::string(error.what()).find(expected)
+				!= std::string::npos);
+	}
+}
