+
+	int invalidSubmissionCallbackCount = 0;
+	const auto invalidSubmission = voiProductionSubmitSc2Action(
+		VoiProductionOperationIdentity(),
+		"squad_order:attack",
+		"attack_move",
+		std::vector<std::uint64_t>({11}),
+		[&]()
+		{
+			++invalidSubmissionCallbackCount;
+			return true;
+		});
+	CHECK(!invalidSubmission.submitted);
+	CHECK(!invalidSubmission.callbackExecuted);
+	CHECK(invalidSubmissionCallbackCount == 0);
+	CHECK(invalidSubmission.submissionId.empty());
+	CHECK(
+		invalidSubmission.blocker
+			== "invalid_sc2_submission_identity");
+
+	bool suppressedCommandIssued = true;
