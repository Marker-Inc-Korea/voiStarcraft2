+				return true;
+			});
+	const auto changedActionSubmission =
+		voiProductionSubmitSc2Action(
+			identity,
+			"squad_order:defend",
+			"attack_move",
+			std::vector<std::uint64_t>({11}),
+			[]()
+			{
+				return true;
+			});
+	const auto changedTagsSubmission =
+		voiProductionSubmitSc2Action(
