+		{
+			++rejectedSubmissionCallbackCount;
+			return false;
+		});
+	CHECK(!rejectedSubmission.submitted);
+	CHECK(rejectedSubmission.callbackExecuted);
+	CHECK(!rejectedSubmission.dispatchProof);
+	CHECK(rejectedSubmissionCallbackCount == 1);
+	CHECK(rejectedSubmission.submissionId.empty());
+	CHECK(
+		rejectedSubmission.blocker
