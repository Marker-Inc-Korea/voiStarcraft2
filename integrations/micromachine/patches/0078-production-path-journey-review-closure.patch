+class VoiMicroMachinePreLiveProductionExecutor
+	: public VoiPreLiveProductionExecutor
+{
+	CCBot * m_bot;
+	std::map<std::string, Squad *> m_squads;
+	std::map<std::uint64_t, sc2::Unit *> m_units;
+	std::map<std::string, sc2::Unit *> m_targets;
+
+	Squad & squadFor(const std::string & squadName)
+	{
+		const auto existing = m_squads.find(squadName);
+		if (existing != m_squads.end())
+		{
+			return *existing->second;
+		}
+		Squad * squad = new Squad(
+			squadName,
+			SquadOrder(
+				SquadOrderTypes::Idle,
+				CCPosition(0.0f, 0.0f),
+				0.0f,
+				"pre_live_initial"),
+			1,
+			*m_bot);
+		m_squads[squadName] = squad;
+		return *squad;
+	}
+
+	sc2::Unit * unitFor(std::uint64_t unitTag)
+	{
+		const auto existing = m_units.find(unitTag);
+		if (existing != m_units.end())
+		{
+			return existing->second;
+		}
+		sc2::Unit * unit = new sc2::Unit();
+		unit->tag = unitTag;
+		unit->unit_type = sc2::UNIT_TYPEID::TERRAN_MARINE;
+		unit->build_progress = 1.0f;
+		m_units[unitTag] = unit;
+		return unit;
+	}
+
+	sc2::Unit * targetFor(
+		const VoiProductionActionBinding & binding,
+		std::uint64_t casterTag)
+	{
+		const std::string key =
+			binding.identity.updateId + "|"
+				+ binding.identity.operationId + "|"
+				+ std::to_string(binding.identity.generation) + "|"
+				+ binding.abilityName + "|"
+				+ std::to_string(casterTag);
+		const auto existing = m_targets.find(key);
+		if (existing != m_targets.end())
+		{
+			return existing->second;
+		}
+		sc2::Unit * target = new sc2::Unit();
+		target->tag =
+			9'000'000'000ULL
+				+ static_cast<std::uint64_t>(m_targets.size());
+		target->unit_type =
+			sc2::UNIT_TYPEID::TERRAN_MARINE;
+		target->build_progress = 1.0f;
+		target->pos = sc2::Point3D(
+			static_cast<float>(binding.targetX),
+			static_cast<float>(binding.targetY),
+			0.0f);
+		m_targets[key] = target;
+		return target;
+	}
+
+	static bool squadOrderType(
+		const std::string & orderKind,
+		std::size_t & orderType)
+	{
+		if (orderKind == "scout")
+		{
+			orderType = SquadOrderTypes::Scout;
+		}
+		else if (orderKind == "defend")
+		{
+			orderType = SquadOrderTypes::Defend;
+		}
+		else if (orderKind == "harass")
+		{
+			orderType = SquadOrderTypes::Harass;
+		}
+		else if (orderKind == "attack")
+		{
+			orderType = SquadOrderTypes::Attack;
+		}
+		else if (orderKind == "retreat")
+		{
+			orderType = SquadOrderTypes::Retreat;
+		}
+		else if (orderKind == "idle")
+		{
+			orderType = SquadOrderTypes::Idle;
+		}
+		else
+		{
+			return false;
+		}
+		return true;
+	}
