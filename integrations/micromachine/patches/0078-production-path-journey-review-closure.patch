+			return orderApplied;
+		});
+	CHECK(acceptedOrder.accepted);
+	CHECK(acceptedOrder.callbackExecuted);
+	CHECK(acceptedOrder.appliedProof);
+	CHECK(orderApplied);
+	CHECK(acceptedOrder.updateId == "update-17");
+	CHECK(acceptedOrder.operationId == "operation-alpha");
+	CHECK(acceptedOrder.generation == 3);
+	CHECK(acceptedOrder.action == "squad_order:attack");
+	CHECK(acceptedOrder.unitTags
+		== std::vector<std::uint64_t>({11, 12}));
+	CHECK(!acceptedOrder.receiptId.empty());
+
+	const auto repeatedOrder = voiProductionIssueSquadOrder(
+		identity,
