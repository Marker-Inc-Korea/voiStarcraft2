+
+using VoiProductionOperationOwners =
+	std::map<std::uint64_t, std::pair<std::string, std::uint64_t>>;
+
+struct VoiProductionOwnershipReceipt
+{
+	bool accepted = false;
+	std::uint64_t unitTag = 0;
+	std::string operationId;
+	std::uint64_t generation = 0;
+	std::string blocker;
+};
+
+inline VoiProductionOwnershipReceipt
+voiProductionAssignOperationOwner(
+	VoiProductionOperationOwners & owners,
+	std::uint64_t unitTag,
+	const std::string & operationId,
+	std::uint64_t generation)
+{
+	VoiProductionOwnershipReceipt receipt;
+	receipt.unitTag = unitTag;
+	receipt.operationId = operationId;
+	receipt.generation = generation;
+	if (unitTag == 0 || operationId.empty() || generation == 0)
+	{
+		receipt.blocker = "invalid_operation_ownership_identity";
+		return receipt;
+	}
+	const auto existing = owners.find(unitTag);
+	if (existing != owners.end()
+		&& existing->second
+			!= std::make_pair(operationId, generation))
+	{
+		receipt.blocker = "unit_already_owned_by_other_operation";
+		return receipt;
+	}
+	owners[unitTag] = std::make_pair(operationId, generation);
+	receipt.accepted = true;
+	return receipt;
+}
+
+inline void voiProductionReleaseOperationOwnership(
+	VoiProductionOperationOwners & owners,
+	const std::string & operationId,
+	std::uint64_t generation)
+{
+	for (auto owner = owners.begin(); owner != owners.end();)
+	{
+		if (owner->second
+			== std::make_pair(operationId, generation))
+		{
+			owner = owners.erase(owner);
+		}
+		else
+		{
+			++owner;
+		}
+	}
+}
+
+inline bool voiProductionTransferOperationOwnership(
+	VoiProductionOperationOwners & owners,
+	const std::vector<std::uint64_t> & unitTags,
+	const std::string & sourceOperationId,
+	std::uint64_t sourceGeneration,
+	const std::string & destinationOperationId,
+	std::uint64_t destinationGeneration)
+{
+	if (unitTags.empty()
+		|| sourceOperationId.empty()
+		|| destinationOperationId.empty()
+		|| sourceGeneration == 0
+		|| destinationGeneration == 0)
+	{
+		return false;
+	}
+	for (const auto unitTag : unitTags)
+	{
+		const auto owner = owners.find(unitTag);
+		if (owner == owners.end()
+			|| owner->second
+				!= std::make_pair(
+					sourceOperationId,
+					sourceGeneration))
+		{
+			return false;
+		}
+	}
+	for (const auto unitTag : unitTags)
+	{
+		owners[unitTag] = std::make_pair(
+			destinationOperationId,
+			destinationGeneration);
+	}
+	return true;
+}
+
+struct VoiProductionSquadOrderReceipt
+{
+	bool accepted = false;
+	bool callbackExecuted = false;
+	bool appliedProof = false;
+	bool membershipProof = false;
+	std::string updateId;
+	std::string operationId;
+	std::uint64_t generation = 0;
+	std::string squadName;
+	std::string action;
+	std::size_t squadOrderType = 0;
+	double targetX = 0.0;
+	double targetY = 0.0;
+	double radius = 0.0;
+	std::vector<std::uint64_t> unitTags;
+	std::string receiptId;
+	std::string blocker;
+};
+
+struct VoiProductionOperationIdentity
+{
+	std::string updateId;
+	std::string operationId;
+	std::uint64_t generation = 0;
+};
+
+struct VoiProductionActionBinding
+{
+	VoiProductionOperationIdentity identity;
+	std::string action;
+	std::string abilityName;
+	std::uint32_t abilityId = 0;
+	std::string targetKind;
+	double targetX = 0.0;
+	double targetY = 0.0;
+};
+
+inline bool voiProductionOperationIdentityIsValid(
+	const VoiProductionOperationIdentity & identity)
+{
+	return !identity.updateId.empty()
+		&& !identity.operationId.empty()
+		&& identity.generation > 0;
+}
+
+inline bool voiProductionCanonicalizeUnitTags(
+	const std::vector<std::uint64_t> & unitTags,
+	std::vector<std::uint64_t> & canonical,
+	std::string & blocker)
+{
+	if (unitTags.empty())
+	{
+		blocker = "missing_production_unit_tags";
+		return false;
+	}
+	canonical = unitTags;
+	std::sort(canonical.begin(), canonical.end());
+	if (canonical.front() == 0)
+	{
+		blocker = "invalid_production_unit_tag";
+		return false;
+	}
+	if (std::adjacent_find(canonical.begin(), canonical.end())
+		!= canonical.end())
+	{
+		blocker = "duplicate_production_unit_tag";
+		return false;
+	}
+	return true;
+}
+
+inline void voiProductionAppendDeterministicField(
+	std::ostringstream & canonical,
+	const std::string & value)
+{
+	canonical << value.size() << ":" << value << "|";
+}
+
+inline std::string voiProductionDeterministicReceiptId(
+	const std::string & prefix,
+	const VoiProductionOperationIdentity & identity,
+	const std::string & action,
+	const std::string & dispatchAction,
+	const std::vector<std::uint64_t> & unitTags,
+	const VoiProductionActionBinding * binding = nullptr)
+{
+	std::ostringstream canonical;
+	voiProductionAppendDeterministicField(canonical, prefix);
+	voiProductionAppendDeterministicField(
+		canonical,
+		identity.updateId);
+	voiProductionAppendDeterministicField(
+		canonical,
+		identity.operationId);
+	canonical << identity.generation << "|";
+	voiProductionAppendDeterministicField(canonical, action);
+	voiProductionAppendDeterministicField(
+		canonical,
+		dispatchAction);
+	for (const auto unitTag : unitTags)
+	{
+		canonical << unitTag << ",";
+	}
+	canonical << "|";
+	if (binding != nullptr)
+	{
+		voiProductionAppendDeterministicField(
+			canonical,
+			binding->abilityName);
+		canonical << binding->abilityId << "|";
+		voiProductionAppendDeterministicField(
+			canonical,
+			binding->targetKind);
+		canonical << std::setprecision(17)
+			<< binding->targetX << "|"
+			<< binding->targetY << "|";
+	}
+
+	std::uint64_t hash = 1469598103934665603ULL;
+	for (const unsigned char value : canonical.str())
+	{
+		hash ^= static_cast<std::uint64_t>(value);
+		hash *= 1099511628211ULL;
+	}
+	std::ostringstream receiptId;
+	receiptId << prefix << "-"
+		<< std::hex << std::setfill('0') << std::setw(16) << hash;
+	return receiptId.str();
+}
+
+template <typename Apply>
+VoiProductionSquadOrderReceipt voiProductionIssueSquadOrder(
+	const VoiProductionOperationIdentity & identity,
+	const std::string & squadName,
+	const std::string & action,
+	const std::vector<std::uint64_t> & unitTags,
+	Apply apply)
+{
+	VoiProductionSquadOrderReceipt receipt;
+	receipt.updateId = identity.updateId;
+	receipt.operationId = identity.operationId;
+	receipt.generation = identity.generation;
+	receipt.squadName = squadName;
+	receipt.action = action;
+	if (!voiProductionOperationIdentityIsValid(identity))
+	{
+		receipt.blocker = "invalid_squad_order_identity";
+		return receipt;
+	}
+	if (squadName.empty() || action.empty())
+	{
+		receipt.blocker = "invalid_squad_order";
+		return receipt;
+	}
+	if (!voiProductionCanonicalizeUnitTags(
+			unitTags,
+			receipt.unitTags,
+			receipt.blocker))
+	{
+		return receipt;
+	}
+	receipt.callbackExecuted = true;
+	receipt.appliedProof = static_cast<bool>(apply());
+	if (!receipt.appliedProof)
+	{
+		receipt.blocker = "squad_order_not_applied";
+		return receipt;
+	}
+	receipt.receiptId = voiProductionDeterministicReceiptId(
+		"voi-squad-order",
+		identity,
+		action,
+		"",
+		receipt.unitTags);
+	receipt.accepted = true;
+	return receipt;
+}
+
+struct VoiProductionSubmissionReceipt
+{
+	bool submitted = false;
+	bool callbackExecuted = false;
+	bool dispatchProof = false;
+	std::string updateId;
+	std::string operationId;
+	std::uint64_t generation = 0;
+	std::string action;
+	std::string dispatchAction;
+	std::string abilityName;
+	std::uint32_t abilityId = 0;
+	std::string targetKind;
+	double targetX = 0.0;
+	double targetY = 0.0;
+	std::vector<std::uint64_t> unitTags;
+	std::string submissionId;
+	std::string blocker;
+};
+
+template <typename Submit>
+VoiProductionSubmissionReceipt voiProductionSubmitSc2Action(
+	const VoiProductionOperationIdentity & identity,
+	const std::string & action,
+	const std::string & dispatchAction,
+	const std::vector<std::uint64_t> & unitTags,
+	const VoiProductionActionBinding * binding,
+	Submit submit)
+{
+	VoiProductionSubmissionReceipt receipt;
+	receipt.updateId = identity.updateId;
+	receipt.operationId = identity.operationId;
+	receipt.generation = identity.generation;
+	receipt.action = action;
+	receipt.dispatchAction = dispatchAction;
+	if (binding != nullptr)
+	{
+		receipt.abilityName = binding->abilityName;
+		receipt.abilityId = binding->abilityId;
+		receipt.targetKind = binding->targetKind;
+		receipt.targetX = binding->targetX;
+		receipt.targetY = binding->targetY;
+	}
+	if (!voiProductionOperationIdentityIsValid(identity))
+	{
+		receipt.blocker = "invalid_sc2_submission_identity";
+		return receipt;
+	}
+	if (action.empty() || dispatchAction.empty())
+	{
+		receipt.blocker = "invalid_sc2_submission";
+		return receipt;
+	}
+	if (!voiProductionCanonicalizeUnitTags(
+			unitTags,
+			receipt.unitTags,
+			receipt.blocker))
+	{
+		return receipt;
+	}
+	receipt.callbackExecuted = true;
+	receipt.dispatchProof = static_cast<bool>(submit());
+	if (!receipt.dispatchProof)
+	{
+		receipt.blocker = "sc2_action_not_dispatched";
+		return receipt;
+	}
+	receipt.submissionId = voiProductionDeterministicReceiptId(
+		"voi-sc2-submission",
+		identity,
+		action,
+		dispatchAction,
+		receipt.unitTags,
+		binding);
+	receipt.submitted = true;
+	return receipt;
+}
+
+template <typename Submit>
+VoiProductionSubmissionReceipt voiProductionSubmitSc2Action(
+	const VoiProductionOperationIdentity & identity,
+	const std::string & action,
+	const std::string & dispatchAction,
+	const std::vector<std::uint64_t> & unitTags,
+	Submit submit)
+{
+	return voiProductionSubmitSc2Action(
+		identity,
+		action,
+		dispatchAction,
+		unitTags,
+		nullptr,
+		submit);
+}
+
+inline void voiProductionResetCommandIssue(bool * commandIssued)
+{
+	if (commandIssued != nullptr)
+	{
+		*commandIssued = false;
+	}
+}
+
+template <typename Dispatch>
+bool voiProductionDispatchSc2ActionAndRecord(
+	const VoiProductionActionBinding * productionBinding,
+	const std::string & dispatchAction,
+	std::uint64_t unitTag,
+	bool * commandIssued,
+	VoiProductionSubmissionReceipt * submissionReceipt,
+	Dispatch dispatch)
+{
+	voiProductionResetCommandIssue(commandIssued);
+	if (submissionReceipt != nullptr)
+	{
+		*submissionReceipt = VoiProductionSubmissionReceipt();
+	}
+	bool dispatched = false;
+	if (productionBinding == nullptr)
+	{
+		dispatched = static_cast<bool>(dispatch());
+	}
+	else
+	{
+		const auto receipt = voiProductionSubmitSc2Action(
+			productionBinding->identity,
+			productionBinding->action,
+			dispatchAction,
+			std::vector<std::uint64_t>({unitTag}),
+			productionBinding,
+			dispatch);
+		dispatched = receipt.submitted;
+		if (submissionReceipt != nullptr)
+		{
+			*submissionReceipt = receipt;
+		}
+	}
+	if (commandIssued != nullptr)
+	{
+		*commandIssued = dispatched;
+	}
+	return dispatched;
+}
+
+template <typename Dispatch>
+bool voiProductionDispatchSc2ActionAndRecord(
+	const VoiProductionActionBinding * productionBinding,
+	const std::string & dispatchAction,
+	std::uint64_t unitTag,
+	bool * commandIssued,
+	Dispatch dispatch)
+{
+	return voiProductionDispatchSc2ActionAndRecord(
+		productionBinding,
+		dispatchAction,
+		unitTag,
+		commandIssued,
+		nullptr,
+		dispatch);
+}
