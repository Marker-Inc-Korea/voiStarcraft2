+template <typename Dispatch>
+bool voiDispatchSc2Action(
+	const VoiProductionActionBinding * productionBinding,
+	const std::string & dispatchAction,
+	std::uint64_t unitTag,
+	bool * commandIssued,
+	Dispatch dispatch)
+{
+	const bool dispatched = voiProductionDispatchSc2ActionAndRecord(
+		productionBinding,
+		dispatchAction,
+		unitTag,
+		commandIssued,
+		dispatch);
+	BOT_ASSERT(
+		dispatched,
+		productionBinding == nullptr
+			? "SC2 action dispatch failed"
+			: "VOI production SC2 action submission failed");
+	return dispatched;
+}
+}
 
