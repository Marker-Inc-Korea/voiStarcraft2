@@ -0,0 +1,66 @@
+#pragma once
+
+#include "voi_family_effect_lifecycle.hpp"
+
+#include <cstdint>
+#include <string>
+
+struct VoiOperationObservationDecision
+{
+	bool matchingSubmission = false;
+	bool movement = false;
+	bool engagement = false;
+	bool abilityEffect = false;
+	std::string effectKind;
+};
+
+inline VoiOperationObservationDecision voiReduceOperationObservation(
+	const VoiFamilyEffectTelemetrySnapshot & snapshot,
+	const std::string & expectedUpdateId,
+	std::uint64_t expectedGeneration,
+	std::uint32_t currentFrame,
+	bool submittedPositionPresent,
+	bool unitMoved,
+	bool unitEngaged,
+	bool abilityStateObserved)
+{
+	VoiOperationObservationDecision decision;
+	decision.matchingSubmission =
+		voiFamilyEffectHasMatchingSubmission(
+			snapshot,
+			expectedUpdateId,
+			expectedGeneration,
+			currentFrame);
+	if (!decision.matchingSubmission)
+	{
+		return decision;
+	}
+	if (snapshot.requiredEffect == "ability_state_or_effect")
+	{
+		decision.abilityEffect =
+			submittedPositionPresent && abilityStateObserved;
+		if (decision.abilityEffect)
+		{
+			decision.effectKind = "ability_state";
+		}
+		return decision;
+	}
+	const bool observed =
+		voiFamilyEffectHasMatchingObservation(
+			snapshot,
+			expectedUpdateId,
+			expectedGeneration,
+			currentFrame,
+			submittedPositionPresent,
+			unitMoved,
+			unitEngaged);
+	if (!observed)
+	{
+		return decision;
+	}
+	decision.engagement = unitEngaged;
+	decision.movement = !unitEngaged && unitMoved;
+	decision.effectKind =
+		decision.engagement ? "engagement" : "movement";
+	return decision;
+}
