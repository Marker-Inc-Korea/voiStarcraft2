+
+	bool rejectedDispatchCommandIssued = true;
+	int rejectedDispatchCallbackCount = 0;
+	const VoiProductionActionBinding binding = {
+		identity,
+		"squad_order:attack"
+	};
+	CHECK(!voiProductionDispatchSc2ActionAndRecord(
+		&binding,
+		"attack_move",
+		11,
+		&rejectedDispatchCommandIssued,
+		[&]()
+		{
+			++rejectedDispatchCallbackCount;
+			return false;
+		}));
+	CHECK(!rejectedDispatchCommandIssued);
+	CHECK(rejectedDispatchCallbackCount == 1);
+
+	bool actionDispatched = false;
+	const auto acceptedSubmission = voiProductionSubmitSc2Action(
+		identity,
