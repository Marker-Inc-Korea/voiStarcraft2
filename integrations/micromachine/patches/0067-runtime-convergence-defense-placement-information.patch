+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+struct VoiRuntimeRequirementSnapshot
+{
+	std::string unitType;
+	std::string role;
+	int targetCount = 0;
+	int assignedCount = 0;
+	int representedCount = 0;
+	int completedCount = 0;
+	int inProgressCount = 0;
+	int queuedCount = 0;
+	std::string productionBlocker;
+	std::vector<std::string> prerequisites;
+	std::vector<std::string> missingPrerequisites;
+
+	int missingCount() const
+	{
+		return std::max(
+			0,
+			targetCount - std::max(assignedCount, representedCount));
+	}
+};
+
+struct VoiRuntimeConvergenceDecision
+{
+	bool ready = false;
+	std::string status;
+	std::string blocker;
+	int targetCount = 0;
+	int assignedCount = 0;
+	int representedCount = 0;
+	int missingCount = 0;
+};
+
+struct VoiRuntimeProductionPool
+{
+	int inProgressCount = 0;
+	int queuedCount = 0;
+};
+
+struct VoiRuntimeProductionAllocation
+{
+	int inProgressCount = 0;
+	int queuedCount = 0;
+	int representedCount = 0;
+};
+
+inline VoiRuntimeProductionAllocation
+voiAllocateOperationProductionProgress(
+	int targetCount,
+	int assignedCount,
+	VoiRuntimeProductionPool & pool)
+{
+	VoiRuntimeProductionAllocation allocation;
+	int remaining =
+		std::max(0, targetCount - assignedCount);
+	allocation.inProgressCount =
+		std::min(remaining, std::max(0, pool.inProgressCount));
+	pool.inProgressCount -= allocation.inProgressCount;
+	remaining -= allocation.inProgressCount;
+	allocation.queuedCount =
+		std::min(remaining, std::max(0, pool.queuedCount));
+	pool.queuedCount -= allocation.queuedCount;
+	allocation.representedCount =
+		std::max(0, assignedCount)
+		+ allocation.inProgressCount
+		+ allocation.queuedCount;
+	return allocation;
+}
+
+inline std::vector<std::string> voiTerranPrerequisiteChain(
+	const std::string & unitType)
+{
+	if (unitType == "TERRAN_MARINE"
+		|| unitType == "TERRAN_REAPER")
+	{
+		return { "TERRAN_BARRACKS" };
+	}
+	if (unitType == "TERRAN_MARAUDER")
+	{
+		return {
+			"TERRAN_BARRACKS",
+			"TERRAN_BARRACKSTECHLAB"
+		};
+	}
+	if (unitType == "TERRAN_GHOST")
+	{
+		return {
+			"TERRAN_BARRACKS",
+			"TERRAN_BARRACKSTECHLAB",
+			"TERRAN_GHOSTACADEMY"
+		};
+	}
+	if (unitType == "TERRAN_HELLION"
+		|| unitType == "TERRAN_WIDOWMINE")
+	{
+		return { "TERRAN_FACTORY" };
+	}
+	if (unitType == "TERRAN_CYCLONE"
+		|| unitType == "TERRAN_SIEGETANK")
+	{
+		return {
+			"TERRAN_FACTORY",
+			"TERRAN_FACTORYTECHLAB"
+		};
+	}
+	if (unitType == "TERRAN_THOR")
+	{
+		return {
+			"TERRAN_FACTORY",
+			"TERRAN_FACTORYTECHLAB",
+			"TERRAN_ARMORY"
+		};
+	}
+	if (unitType == "TERRAN_MEDIVAC"
+		|| unitType == "TERRAN_VIKINGFIGHTER"
+		|| unitType == "TERRAN_LIBERATOR")
+	{
+		return {
+			"TERRAN_FACTORY",
+			"TERRAN_STARPORT"
+		};
+	}
+	if (unitType == "TERRAN_BANSHEE"
+		|| unitType == "TERRAN_RAVEN")
+	{
+		return {
+			"TERRAN_FACTORY",
+			"TERRAN_STARPORT",
+			"TERRAN_STARPORTTECHLAB"
+		};
+	}
+	if (unitType == "TERRAN_BATTLECRUISER")
+	{
+		return {
+			"TERRAN_FACTORY",
+			"TERRAN_STARPORT",
+			"TERRAN_STARPORTTECHLAB",
+			"TERRAN_FUSIONCORE"
+		};
+	}
+	return {};
+}
+
+inline VoiRuntimeConvergenceDecision voiEvaluateOperationConvergence(
+	const std::vector<VoiRuntimeRequirementSnapshot> & requirements,
+	int minimumUnits,
+	bool allowPartial)
+{
+	VoiRuntimeConvergenceDecision decision;
+	bool compositionAssigned = true;
+	bool compositionRepresented = true;
+	for (const auto & requirement : requirements)
+	{
+		decision.targetCount += std::max(0, requirement.targetCount);
+		decision.assignedCount += std::max(0, requirement.assignedCount);
+		decision.representedCount += std::max(
+			0,
+			requirement.representedCount);
+		decision.missingCount += requirement.missingCount();
+		compositionAssigned =
+			compositionAssigned
+			&& requirement.assignedCount >= requirement.targetCount;
+		compositionRepresented =
+			compositionRepresented && requirement.missingCount() == 0;
+	}
+	const bool minimumReady =
+		decision.assignedCount >= std::max(0, minimumUnits);
+	decision.ready =
+		(minimumReady && (allowPartial || compositionAssigned))
+		|| (allowPartial && decision.assignedCount > 0);
+	if (decision.ready)
+	{
+		decision.status = "ASSIGNED";
+		return decision;
+	}
+	decision.status = "WAITING_FOR_UNITS";
+	if (!compositionAssigned)
+	{
+		decision.blocker = compositionRepresented
+			? "composition_assignment_pending"
+			: "composition_prerequisites_pending";
+	}
+	else if (decision.assignedCount == 0)
+	{
+		decision.blocker = "no_available_units";
+	}
+	else
+	{
+		decision.blocker = "insufficient_units";
+	}
+	return decision;
+}
+
+template <typename Tag>
+bool voiAutonomousDefenseMayClaim(
+	Tag tag,
+	const std::set<Tag> & operationOwnedTags)
+{
+	return operationOwnedTags.find(tag) == operationOwnedTags.end();
+}
+
+template <typename Tag>
+bool voiOwnershipSetsAreDisjoint(
+	const std::vector<std::set<Tag>> & ownershipSets)
+{
+	std::set<Tag> seen;
+	for (const auto & owners : ownershipSets)
+	{
+		for (const auto & tag : owners)
+		{
+			if (!seen.insert(tag).second)
+			{
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+struct VoiPlacementCandidate
+{
+	int x = 0;
+	int y = 0;
+	int distanceRank = 0;
+	bool valid = false;
+	bool buildable = false;
+	bool connected = false;
+};
+
+inline int voiSelectSemanticPlacementCandidate(
+	std::vector<VoiPlacementCandidate> candidates,
+	bool allowFallback)
+{
+	if (candidates.empty())
+	{
+		return -1;
+	}
+	std::stable_sort(
+		candidates.begin(),
+		candidates.end(),
+		[](const VoiPlacementCandidate & left,
+			const VoiPlacementCandidate & right)
+		{
+			if (left.distanceRank != right.distanceRank)
+			{
+				return left.distanceRank < right.distanceRank;
+			}
+			if (left.x != right.x)
+			{
+				return left.x < right.x;
+			}
+			return left.y < right.y;
+		});
+	for (const auto & candidate : candidates)
+	{
+		if (candidate.distanceRank > 0 && !allowFallback)
+		{
+			break;
+		}
+		if (candidate.valid
+			&& candidate.buildable
+			&& candidate.connected)
+		{
+			return candidate.distanceRank;
+		}
+	}
+	return -1;
+}
+
+inline bool voiProductionBuildingLiftAllowed(
+	bool explicitRelocationAllowed,
+	bool recoveryOwnerAuthorized)
+{
+	return explicitRelocationAllowed || recoveryOwnerAuthorized;
+}
+
+inline bool voiIsSelfMainLocationIntent(
+	const std::string & locationIntent)
+{
+	return locationIntent == "home"
+		|| locationIntent == "self_main"
+		|| locationIntent == "main_base";
+}
+
+inline bool voiIsSelfNaturalLocationIntent(
+	const std::string & locationIntent)
+{
+	return locationIntent == "natural"
+		|| locationIntent == "self_natural";
+}
+
+inline bool voiIsSelfRampLocationIntent(
+	const std::string & locationIntent)
+{
+	return locationIntent == "self_ramp"
+		|| locationIntent == "self_main_ramp"
+		|| locationIntent == "front_door"
+		|| locationIntent == "main_entrance"
+		|| locationIntent == "self_choke"
+		|| locationIntent == "main_choke"
+		|| locationIntent == "self_natural_choke";
+}
+
+inline std::string voiClassifyEnemyTargetEvidence(
+	bool explicitTarget,
+	bool selfTarget,
+	const std::string & observedEnemyEvidence,
+	bool knownEnemyBaseMatch,
+	bool searchIntent)
+{
+	if (selfTarget)
+	{
+		return "self_observed";
+	}
+	if (explicitTarget)
+	{
+		return "explicit";
+	}
+	if (!observedEnemyEvidence.empty())
+	{
+		return observedEnemyEvidence;
+	}
+	if (knownEnemyBaseMatch)
+	{
+		return "known_enemy_base";
+	}
+	return searchIntent ? "search_candidate" : "resolved";
+}
+
+struct VoiOperationTargetUpdateInput
+{
+	std::uint64_t activeGeneration = 0;
+	std::uint64_t requestedGeneration = 0;
+	bool explicitRetarget = false;
+	bool targetReached = false;
+	bool routeStalled = false;
+};
+
+inline bool voiShouldReplaceOperationTarget(
+	const VoiOperationTargetUpdateInput & input)
+{
+	if (input.requestedGeneration != input.activeGeneration)
+	{
+		return input.requestedGeneration > input.activeGeneration;
+	}
+	return input.explicitRetarget
+		|| input.targetReached
+		|| input.routeStalled;
+}
+
+struct VoiTargetLatchInput
+{
+	std::string activeKey;
+	std::string requestedKey;
+	bool targetValid = false;
+	bool targetReached = false;
+	bool routeStalled = false;
+	float targetDistance = 0.0f;
+	float bestDistance = 0.0f;
+	std::uint32_t currentFrame = 0;
+	std::uint32_t lastProgressFrame = 0;
+};
+
+struct VoiTargetLatchDecision
+{
+	bool reset = false;
+	bool rotate = false;
+	bool retain = false;
+	float bestDistance = 0.0f;
+	std::uint32_t lastProgressFrame = 0;
+};
+
+inline VoiTargetLatchDecision voiReduceTargetLatch(
+	const VoiTargetLatchInput & input)
+{
+	VoiTargetLatchDecision decision;
+	decision.reset = input.activeKey != input.requestedKey;
+	decision.rotate = !input.targetValid
+		|| input.targetReached
+		|| input.routeStalled;
+	decision.retain = !decision.reset && !decision.rotate;
+	decision.bestDistance = input.bestDistance;
+	decision.lastProgressFrame = input.lastProgressFrame;
+	if (decision.reset)
+	{
+		decision.bestDistance = 0.0f;
+		decision.lastProgressFrame = 0;
+		return decision;
+	}
+	if (input.targetValid
+		&& (input.bestDistance <= 0.0f
+			|| input.targetDistance + 1.0f < input.bestDistance))
+	{
+		decision.bestDistance = input.targetDistance;
+		decision.lastProgressFrame = input.currentFrame;
+	}
+	return decision;
+}
