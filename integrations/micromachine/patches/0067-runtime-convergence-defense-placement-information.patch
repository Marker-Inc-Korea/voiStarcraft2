diff --git a/tests/runtime_convergence_test.cpp b/tests/runtime_convergence_test.cpp
new file mode 100644
index 0000000..a593e8f
--- /dev/null
+++ b/tests/runtime_convergence_test.cpp
@@ -0,0 +1,244 @@
+#include "voi_runtime_convergence.hpp"
+
+#include <cassert>
+#include <set>
+#include <string>
+#include <vector>
+
+int main()
+{
+	VoiRuntimeRequirementSnapshot tank;
+	tank.unitType = "TERRAN_SIEGETANK";
+	tank.role = "siege";
+	tank.targetCount = 2;
+	tank.assignedCount = 0;
+	tank.representedCount = 1;
+	tank.completedCount = 1;
+	tank.inProgressCount = 0;
+	tank.queuedCount = 1;
+	tank.productionBlocker = "production_queued";
+	tank.prerequisites = voiTerranPrerequisiteChain(tank.unitType);
+	tank.missingPrerequisites = { "TERRAN_FACTORYTECHLAB" };
+	assert(tank.missingCount() == 1);
+	assert(tank.completedCount == 1);
+	assert(tank.queuedCount == 1);
+	assert(tank.productionBlocker == "production_queued");
+	assert(tank.missingPrerequisites.size() == 1);
+	assert(tank.prerequisites.size() == 2);
+	assert(tank.prerequisites[1] == "TERRAN_FACTORYTECHLAB");
+
+	VoiRuntimeRequirementSnapshot viking;
+	viking.unitType = "TERRAN_VIKINGFIGHTER";
+	viking.targetCount = 1;
+	viking.assignedCount = 0;
+	viking.representedCount = 0;
+	viking.prerequisites = voiTerranPrerequisiteChain(viking.unitType);
+	assert(viking.prerequisites.size() == 2);
+	assert(viking.prerequisites[1] == "TERRAN_STARPORT");
+
+	VoiRuntimeRequirementSnapshot ghost;
+	ghost.unitType = "TERRAN_GHOST";
+	ghost.targetCount = 1;
+	ghost.assignedCount = 0;
+	ghost.representedCount = 0;
+	ghost.prerequisites = voiTerranPrerequisiteChain(ghost.unitType);
+	assert(ghost.prerequisites.size() == 3);
+	assert(ghost.prerequisites[2] == "TERRAN_GHOSTACADEMY");
+
+	const auto waiting = voiEvaluateOperationConvergence(
+		{ tank, viking, ghost },
+		4,
+		false);
+	assert(!waiting.ready);
+	assert(waiting.status == "WAITING_FOR_UNITS");
+	assert(waiting.blocker == "composition_prerequisites_pending");
+	assert(waiting.targetCount == 4);
+	assert(waiting.assignedCount == 0);
+	assert(waiting.representedCount == 1);
+	assert(waiting.missingCount == 3);
+
+	VoiRuntimeProductionPool marinePool;
+	marinePool.inProgressCount = 2;
+	marinePool.queuedCount = 2;
+	const auto frontlineAllocation =
+		voiAllocateOperationProductionProgress(
+			2,
+			0,
+			marinePool);
+	const auto scoutAllocation =
+		voiAllocateOperationProductionProgress(
+			2,
+			0,
+			marinePool);
+	assert(frontlineAllocation.inProgressCount == 2);
+	assert(frontlineAllocation.queuedCount == 0);
+	assert(frontlineAllocation.representedCount == 2);
+	assert(scoutAllocation.inProgressCount == 0);
+	assert(scoutAllocation.queuedCount == 2);
+	assert(scoutAllocation.representedCount == 2);
+	assert(marinePool.inProgressCount == 0);
+	assert(marinePool.queuedCount == 0);
+	assert(
+		frontlineAllocation.representedCount
+			+ scoutAllocation.representedCount
+			== 4);
+
+	tank.representedCount = 2;
+	viking.representedCount = 1;
+	ghost.representedCount = 1;
+	const auto representedButUnassigned =
+		voiEvaluateOperationConvergence(
+			{ tank, viking, ghost },
+			4,
+			false);
+	assert(!representedButUnassigned.ready);
+	assert(
+		representedButUnassigned.status
+			== "WAITING_FOR_UNITS");
+	assert(
+		representedButUnassigned.blocker
+			== "composition_assignment_pending");
+	assert(representedButUnassigned.missingCount == 0);
+
+	tank.assignedCount = 2;
+	tank.representedCount = 2;
+	viking.assignedCount = 1;
+	viking.representedCount = 1;
+	ghost.assignedCount = 1;
+	ghost.representedCount = 1;
+	const auto launched = voiEvaluateOperationConvergence(
+		{ tank, viking, ghost },
+		4,
+		false);
+	assert(launched.ready);
+	assert(launched.status == "ASSIGNED");
+	assert(launched.blocker.empty());
+	assert(launched.missingCount == 0);
+
+	const std::set<unsigned long long> attackOwners = { 11, 12 };
+	const std::set<unsigned long long> scoutOwners = { 21 };
+	const std::set<unsigned long long> defenseOwners = { 31, 32 };
+	assert(voiAutonomousDefenseMayClaim(41ULL, attackOwners));
+	assert(!voiAutonomousDefenseMayClaim(11ULL, attackOwners));
+	assert(voiOwnershipSetsAreDisjoint<unsigned long long>(
+		{ attackOwners, scoutOwners, defenseOwners }));
+	assert(!voiOwnershipSetsAreDisjoint<unsigned long long>(
+		{ attackOwners, { 12, 41 } }));
+
+	const std::vector<VoiPlacementCandidate> placementCandidates = {
+		{ 20, 20, 0, true, false, true },
+		{ 19, 20, 1, true, true, false },
+		{ 21, 20, 2, true, true, true },
+		{ 18, 20, 3, true, true, true },
+	};
+	assert(
+		voiSelectSemanticPlacementCandidate(
+			placementCandidates,
+			false) == -1);
+	assert(
+		voiSelectSemanticPlacementCandidate(
+			placementCandidates,
+			true) == 2);
+	assert(!voiProductionBuildingLiftAllowed(false, false));
+	assert(voiProductionBuildingLiftAllowed(true, false));
+	assert(voiProductionBuildingLiftAllowed(false, true));
+
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			false,
+			false,
+			"",
+			false,
+			true) == "search_candidate");
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			false,
+			false,
+			"visible_enemy",
+			true,
+			true) == "visible_enemy");
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			false,
+			false,
+			"remembered_building",
+			true,
+			true) == "remembered_building");
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			false,
+			false,
+			"recent_mobile",
+			false,
+			true) == "recent_mobile");
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			false,
+			false,
+			"",
+			true,
+			true) == "known_enemy_base");
+	assert(
+		voiClassifyEnemyTargetEvidence(
+			true,
+			true,
+			"",
+			false,
+			false) == "self_observed");
+
+	assert(voiIsSelfMainLocationIntent("home"));
+	assert(voiIsSelfNaturalLocationIntent("self_natural"));
+	assert(voiIsSelfRampLocationIntent("self_ramp"));
+	assert(voiIsSelfRampLocationIntent("front_door"));
+	assert(voiIsSelfRampLocationIntent("self_natural_choke"));
+	assert(!voiIsSelfRampLocationIntent("enemy_front"));
+
+	VoiOperationTargetUpdateInput targetUpdate;
+	targetUpdate.activeGeneration = 4;
+	targetUpdate.requestedGeneration = 4;
+	assert(!voiShouldReplaceOperationTarget(targetUpdate));
+	targetUpdate.explicitRetarget = true;
+	assert(voiShouldReplaceOperationTarget(targetUpdate));
+	targetUpdate.explicitRetarget = false;
+	targetUpdate.targetReached = true;
+	assert(voiShouldReplaceOperationTarget(targetUpdate));
+	targetUpdate.targetReached = false;
+	targetUpdate.routeStalled = true;
+	assert(voiShouldReplaceOperationTarget(targetUpdate));
+	targetUpdate.routeStalled = false;
+	targetUpdate.requestedGeneration = 5;
+	assert(voiShouldReplaceOperationTarget(targetUpdate));
+	targetUpdate.requestedGeneration = 3;
+	assert(!voiShouldReplaceOperationTarget(targetUpdate));
+
+	VoiTargetLatchInput latch;
+	latch.activeKey = "attack:1|lost_contact_sweep";
+	latch.requestedKey = latch.activeKey;
+	latch.targetValid = true;
+	latch.targetDistance = 20.0f;
+	latch.bestDistance = 24.0f;
+	latch.currentFrame = 300;
+	latch.lastProgressFrame = 200;
+	const auto progress = voiReduceTargetLatch(latch);
+	assert(progress.retain);
+	assert(!progress.rotate);
+	assert(progress.bestDistance == 20.0f);
+	assert(progress.lastProgressFrame == 300);
+
+	latch.targetReached = true;
+	const auto reached = voiReduceTargetLatch(latch);
+	assert(reached.rotate);
+	assert(!reached.retain);
+	latch.targetReached = false;
+	latch.routeStalled = true;
+	const auto stalled = voiReduceTargetLatch(latch);
+	assert(stalled.rotate);
+	latch.routeStalled = false;
+	latch.requestedKey = "attack:2|lost_contact_sweep";
+	const auto generationReset = voiReduceTargetLatch(latch);
+	assert(generationReset.reset);
+	assert(generationReset.bestDistance == 0.0f);
+	assert(generationReset.lastProgressFrame == 0);
+
+	return 0;
+}
