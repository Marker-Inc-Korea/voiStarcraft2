+VoiOperationProductionProgress
+ProductionManager::getVoiOperationProductionProgress(
+	const std::string & operationId,
+	uint64_t generation,
+	const std::string & unitToken) const
+{
+	VoiOperationProductionProgress progress;
+	progress.operationId = operationId;
+	progress.generation = generation;
+	progress.unitToken = unitToken;
+
+	const MetaType * type =
+		voiExactCompositionTypeForToken(unitToken);
+	if (operationId.empty()
+		|| generation == 0
+		|| type == nullptr)
+	{
+		return progress;
+	}
+
+	progress.supported = true;
+	progress.completedCount =
+		m_bot.Commander().Combat()
+			.getVoiOperationOwnedUnitCount(
+				operationId,
+				generation,
+				unitToken);
+	progress.operationOwnedQueuedCount =
+		m_queue.getVoiOperationOwnedItemCount(
+			*type,
+			operationId,
+			generation);
+	const MM::VoiBuildOrderOwner owner {
+		operationId,
+		generation };
+	const auto ownerBaselines =
+		m_voiOperationProductionBaselines.find(owner);
+	if (ownerBaselines != m_voiOperationProductionBaselines.end())
+	{
+		const uint32_t productionTypeKey =
+			static_cast<uint32_t>(
+				type->getUnitType().getAPIUnitType());
+		const auto baseline =
+			ownerBaselines->second.find(productionTypeKey);
+		if (baseline != ownerBaselines->second.end())
+		{
+			const int completedGrowth = std::max(
+				0,
+				progress.completedCount
+					- baseline->second.ownedCount);
+			progress.trainingCount = std::max(
+				0,
+				baseline->second.attributedRepresentedGrowth
+					- completedGrowth);
+		}
+	}
+	progress.inProgressCount = progress.trainingCount;
+	progress.representedCount =
+		progress.completedCount
+		+ progress.inProgressCount
+		+ progress.operationOwnedQueuedCount;
+
+	const TypeData & typeData = m_bot.Data(*type);
+	progress.availableMinerals =
+		std::max(0, m_bot.GetFreeMinerals());
+	progress.requiredMinerals =
+		std::max(0, typeData.mineralCost);
+	progress.availableGas =
+		std::max(0, m_bot.GetFreeGas());
+	progress.requiredGas =
+		std::max(0, typeData.gasCost);
+	progress.availableSupply = std::max(
+		0,
+		m_bot.GetMaxSupply()
+			- m_bot.GetCurrentSupply());
+	progress.requiredSupply =
+		std::max(0, typeData.supplyCost);
+	progress.mineralsAvailable =
+		progress.availableMinerals
+			>= progress.requiredMinerals;
+	progress.gasAvailable =
+		progress.availableGas
+			>= progress.requiredGas;
+	progress.resourcesAvailable =
+		progress.mineralsAvailable
+			&& progress.gasAvailable;
+	progress.supplyAvailable =
+		progress.availableSupply
+			>= progress.requiredSupply;
+	progress.prerequisitesSatisfied =
+		hasRequired(*type, false);
+	progress.producerPresent =
+		hasProducer(*type, false);
+	progress.producerAvailable =
+		progress.producerPresent
+		&& getProducer(*type).isValid();
+
+	const std::vector<std::string> prerequisiteChain =
+		voiTerranPrerequisiteChain(unitToken);
+	for (const auto & prerequisiteToken :
+		prerequisiteChain)
+	{
+		const MetaType * prerequisiteType =
+			voiTerranPrerequisiteTypeForToken(
+				prerequisiteToken);
+		if (prerequisiteType == nullptr
+			|| !hasRequiredUnit(
+				prerequisiteType->getUnitType(),
+				false))
+		{
+			progress.missingPrerequisiteTokens.push_back(
+				prerequisiteToken);
+		}
+	}
+
+	if (progress.trainingCount > 0)
+	{
+		progress.blocker = "training";
+		return progress;
+	}
+	if (!progress.missingPrerequisiteTokens.empty())
+	{
+		const MetaType * missingType =
+			voiTerranPrerequisiteTypeForToken(
+				progress.missingPrerequisiteTokens.front());
+		if (missingType != nullptr
+			&& voiProductionPrerequisiteIsProducer(
+				typeData,
+				*missingType))
+		{
+			progress.blocker = "missing_producer";
+		}
+		else if (missingType != nullptr
+			&& missingType->isAddon())
+		{
+			progress.blocker = "missing_addon";
+		}
+		else
+		{
+			progress.blocker = "missing_tech";
+		}
+		return progress;
+	}
+	if (!progress.prerequisitesSatisfied)
+	{
+		progress.blocker = "missing_tech";
+		return progress;
+	}
+	if (!progress.producerAvailable)
+	{
+		progress.blocker = progress.producerPresent
+			? "producer_busy"
+			: "missing_producer";
+		return progress;
+	}
+	if (!progress.supplyAvailable)
+	{
+		progress.blocker = "supply_blocked";
+		return progress;
+	}
+	if (!progress.gasAvailable)
+	{
+		progress.blocker = "gas_pending";
+		return progress;
+	}
+	if (!progress.mineralsAvailable)
+	{
+		progress.blocker = "minerals_pending";
+		return progress;
+	}
+	if (progress.operationOwnedQueuedCount > 0)
+	{
+		progress.blocker = "production_queued";
+		return progress;
+	}
+	progress.blocker = "ready";
+	return progress;
+}
