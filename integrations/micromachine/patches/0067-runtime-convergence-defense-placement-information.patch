+int BuildOrderQueue::getVoiOperationOwnedItemCount(
+	const MetaType & type,
+	const std::string & operationId,
+	uint64_t generation) const
+{
+	const MM::VoiBuildOrderOwner owner {
+		operationId,
+		generation };
+	return static_cast<int>(
+		std::count_if(
+			m_queue.begin(),
+			m_queue.end(),
+			[&](const MM::BuildOrderItem & item)
+			{
+				return sameBuildOrderType(item, type)
+					&& item.voiOperationOwners.find(owner)
+						!= item.voiOperationOwners.end();
+			}));
+}
