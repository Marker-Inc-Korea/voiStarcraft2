diff --git a/src/voi_atomic_telemetry.hpp b/src/voi_atomic_telemetry.hpp
new file mode 100644
--- /dev/null
+++ b/src/voi_atomic_telemetry.hpp
@@ -0,0 +1,235 @@
+#pragma once
+
+#include <atomic>
+#include <cerrno>
+#include <cstddef>
+#include <fcntl.h>
+#include <string>
+#include <unistd.h>
+
+struct VoiAtomicTelemetrySystemCalls
+{
+	int openDirectory(const char * path) const
+	{
+		return ::open(
+			path,
+			O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	}
+
+	int openDirectoryAt(
+		int directoryDescriptor,
+		const char * name) const
+	{
+		return ::openat(
+			directoryDescriptor,
+			name,
+			O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	}
+
+	int openFileAt(
+		int directoryDescriptor,
+		const char * name,
+		int flags,
+		mode_t mode) const
+	{
+		return ::openat(directoryDescriptor, name, flags, mode);
+	}
+
+	ssize_t writeFile(
+		int descriptor,
+		const void * data,
+		std::size_t size) const
+	{
+		return ::write(descriptor, data, size);
+	}
+
+	int closeDescriptor(int descriptor) const
+	{
+		return ::close(descriptor);
+	}
+
+	int renameFileAt(
+		int directoryDescriptor,
+		const char * from,
+		const char * to) const
+	{
+		return ::renameat(
+			directoryDescriptor,
+			from,
+			directoryDescriptor,
+			to);
+	}
+
+	int removeFileAt(
+		int directoryDescriptor,
+		const char * name) const
+	{
+		return ::unlinkat(directoryDescriptor, name, 0);
+	}
+};
+
+inline bool voiSplitTelemetryPath(
+	const std::string & path,
+	std::string & directory,
+	std::string & name)
+{
+	const std::string::size_type separator = path.find_last_of('/');
+	if (separator == std::string::npos)
+	{
+		directory = ".";
+		name = path;
+	}
+	else
+	{
+		directory = separator == 0 ? "/" : path.substr(0, separator);
+		name = path.substr(separator + 1);
+	}
+	return !name.empty() && name != "." && name != "..";
+}
+
+template <typename FileOperations>
+inline int voiOpenTelemetryDirectoryWithoutSymlinks(
+	const std::string & directory,
+	FileOperations & operations)
+{
+	const bool absolute =
+		!directory.empty() && directory.front() == '/';
+	int descriptor =
+		operations.openDirectory(absolute ? "/" : ".");
+	if (descriptor < 0)
+	{
+		return -1;
+	}
+
+	std::string::size_type offset = absolute ? 1 : 0;
+	while (offset < directory.size())
+	{
+		const std::string::size_type separator =
+			directory.find('/', offset);
+		const std::string component = directory.substr(
+			offset,
+			separator == std::string::npos
+				? std::string::npos
+				: separator - offset);
+		offset = separator == std::string::npos
+			? directory.size()
+			: separator + 1;
+		if (component.empty() || component == ".")
+		{
+			continue;
+		}
+		if (component == "..")
+		{
+			operations.closeDescriptor(descriptor);
+			return -1;
+		}
+		const int childDescriptor =
+			operations.openDirectoryAt(
+				descriptor,
+				component.c_str());
+		operations.closeDescriptor(descriptor);
+		if (childDescriptor < 0)
+		{
+			return -1;
+		}
+		descriptor = childDescriptor;
+	}
+	return descriptor;
+}
+
+template <typename FileOperations>
+inline bool voiWriteTelemetrySnapshotAtomicallyWithOperations(
+	const std::string & path,
+	const std::string & payload,
+	FileOperations & operations)
+{
+	std::string directory;
+	std::string name;
+	if (!voiSplitTelemetryPath(path, directory, name))
+	{
+		return false;
+	}
+
+	const int directoryDescriptor =
+		voiOpenTelemetryDirectoryWithoutSymlinks(
+			directory,
+			operations);
+	if (directoryDescriptor < 0)
+	{
+		return false;
+	}
+
+	static std::atomic<unsigned long> sequence(0);
+	const std::string temporaryName =
+		name
+		+ ".tmp."
+		+ std::to_string(static_cast<unsigned long>(::getpid()))
+		+ "."
+		+ std::to_string(sequence.fetch_add(1));
+	const int descriptor = operations.openFileAt(
+		directoryDescriptor,
+		temporaryName.c_str(),
+		O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+		0600);
+	if (descriptor < 0)
+	{
+		operations.closeDescriptor(directoryDescriptor);
+		return false;
+	}
+
+	std::size_t written = 0;
+	while (written < payload.size())
+	{
+		const ssize_t result = operations.writeFile(
+			descriptor,
+			payload.data() + written,
+			payload.size() - written);
+		if (result > 0)
+		{
+			written += static_cast<std::size_t>(result);
+			continue;
+		}
+		if (result < 0 && errno == EINTR)
+		{
+			continue;
+		}
+		operations.closeDescriptor(descriptor);
+		operations.removeFileAt(
+			directoryDescriptor,
+			temporaryName.c_str());
+		operations.closeDescriptor(directoryDescriptor);
+		return false;
+	}
+	if (operations.closeDescriptor(descriptor) != 0)
+	{
+		operations.removeFileAt(
+			directoryDescriptor,
+			temporaryName.c_str());
+		operations.closeDescriptor(directoryDescriptor);
+		return false;
+	}
+	if (operations.renameFileAt(
+			directoryDescriptor,
+			temporaryName.c_str(),
+			name.c_str()) != 0)
+	{
+		operations.removeFileAt(
+			directoryDescriptor,
+			temporaryName.c_str());
+		operations.closeDescriptor(directoryDescriptor);
+		return false;
+	}
+	operations.closeDescriptor(directoryDescriptor);
+	return true;
+}
+
+inline bool voiWriteTelemetrySnapshotAtomically(
+	const std::string & path,
+	const std::string & payload)
+{
+	VoiAtomicTelemetrySystemCalls operations;
+	return voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		path,
+		payload,
+		operations);
+}
