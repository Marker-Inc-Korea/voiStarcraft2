diff --git a/tests/atomic_telemetry_test.cpp b/tests/atomic_telemetry_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/atomic_telemetry_test.cpp
@@ -0,0 +1,450 @@
+#include "voi_atomic_telemetry.hpp"
+
+#include <atomic>
+#include <cstdio>
+#include <dirent.h>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <sys/stat.h>
+#include <thread>
+#include <vector>
+
+namespace
+{
+int fail(const char * expression, int line)
+{
+	std::fprintf(
+		stderr,
+		"atomic telemetry contract failed at line %d: %s\n",
+		line,
+		expression);
+	return 1;
+}
+
+#define REQUIRE(expression) \
+	do \
+	{ \
+		if (!(expression)) \
+		{ \
+			return fail(#expression, __LINE__); \
+		} \
+	} while (false)
+
+std::string readFile(const std::string & path)
+{
+	std::ifstream input(path.c_str(), std::ios::binary);
+	return std::string(
+		std::istreambuf_iterator<char>(input),
+		std::istreambuf_iterator<char>());
+}
+
+bool writeFile(
+	const std::string & path,
+	const std::string & payload)
+{
+	std::ofstream output(path.c_str(), std::ios::binary);
+	if (!output.good())
+	{
+		return false;
+	}
+	output << payload;
+	output.close();
+	return !output.fail();
+}
+
+bool temporaryFilesFor(
+	const std::string & path,
+	std::vector<std::string> & matches)
+{
+	DIR * directory = ::opendir(".");
+	if (directory == nullptr)
+	{
+		return false;
+	}
+	const std::string prefix = path + ".tmp.";
+	while (const dirent * entry = ::readdir(directory))
+	{
+		const std::string name(entry->d_name);
+		if (name.find(prefix) == 0)
+		{
+			matches.push_back(name);
+		}
+	}
+	return ::closedir(directory) == 0;
+}
+
+struct InterruptingShortWriteOperations
+	: VoiAtomicTelemetrySystemCalls
+{
+	bool interrupted = false;
+	bool shortened = false;
+
+	ssize_t writeFile(
+		int descriptor,
+		const void * data,
+		std::size_t size)
+	{
+		if (!interrupted)
+		{
+			interrupted = true;
+			errno = EINTR;
+			return -1;
+		}
+		if (!shortened && size > 7)
+		{
+			shortened = true;
+			return VoiAtomicTelemetrySystemCalls::writeFile(
+				descriptor,
+				data,
+				7);
+		}
+		return VoiAtomicTelemetrySystemCalls::writeFile(
+			descriptor,
+			data,
+			size);
+	}
+};
+
+struct DeterministicOverlapOperations
+	: VoiAtomicTelemetrySystemCalls
+{
+	std::atomic<bool> & partialWriteEntered;
+	std::atomic<bool> & releaseWrite;
+	std::atomic<bool> & readerCompletedDuringWrite;
+	bool blocked = false;
+
+	DeterministicOverlapOperations(
+		std::atomic<bool> & entered,
+		std::atomic<bool> & release,
+		std::atomic<bool> & readerCompleted)
+		: partialWriteEntered(entered)
+		, releaseWrite(release)
+		, readerCompletedDuringWrite(readerCompleted)
+	{
+	}
+
+	ssize_t writeFile(
+		int descriptor,
+		const void * data,
+		std::size_t size)
+	{
+		if (!blocked && size > 1)
+		{
+			const ssize_t result =
+				VoiAtomicTelemetrySystemCalls::writeFile(
+					descriptor,
+					data,
+					1);
+			if (result != 1)
+			{
+				return result;
+			}
+			blocked = true;
+			partialWriteEntered.store(true);
+			while (!releaseWrite.load())
+			{
+				std::this_thread::yield();
+			}
+			if (!readerCompletedDuringWrite.load())
+			{
+				errno = EIO;
+				return -1;
+			}
+			return 1;
+		}
+		return VoiAtomicTelemetrySystemCalls::writeFile(
+			descriptor,
+			data,
+			size);
+	}
+};
+
+struct OpenFailureOperations : VoiAtomicTelemetrySystemCalls
+{
+	int flags = 0;
+	mode_t mode = 0;
+
+	int openFileAt(
+		int,
+		const char *,
+		int requestedFlags,
+		mode_t requestedMode)
+	{
+		flags = requestedFlags;
+		mode = requestedMode;
+		errno = EACCES;
+		return -1;
+	}
+};
+
+struct WriteFailureOperations : VoiAtomicTelemetrySystemCalls
+{
+	ssize_t writeFile(int, const void *, std::size_t)
+	{
+		errno = EIO;
+		return -1;
+	}
+};
+
+struct CloseFailureOperations : VoiAtomicTelemetrySystemCalls
+{
+	int dataDescriptor = -1;
+	bool failed = false;
+
+	int openFileAt(
+		int directoryDescriptor,
+		const char * name,
+		int flags,
+		mode_t mode)
+	{
+		dataDescriptor =
+			VoiAtomicTelemetrySystemCalls::openFileAt(
+				directoryDescriptor,
+				name,
+				flags,
+				mode);
+		return dataDescriptor;
+	}
+
+	int closeDescriptor(int descriptor)
+	{
+		if (descriptor == dataDescriptor && !failed)
+		{
+			failed = true;
+			VoiAtomicTelemetrySystemCalls::closeDescriptor(
+				descriptor);
+			errno = EIO;
+			return -1;
+		}
+		return VoiAtomicTelemetrySystemCalls::closeDescriptor(
+			descriptor);
+	}
+};
+
+struct RenameFailureOperations : VoiAtomicTelemetrySystemCalls
+{
+	int renameFileAt(int, const char *, const char *)
+	{
+		errno = EIO;
+		return -1;
+	}
+};
+}
+
+int main()
+{
+	const std::string path = "voi_atomic_telemetry_test.json";
+	std::remove(path.c_str());
+
+	const std::string first =
+		"{\"frame\":1,\"payload\":\""
+		+ std::string(1024 * 512, 'a')
+		+ "\"}\n";
+	const std::string second =
+		"{\"frame\":2,\"payload\":\""
+		+ std::string(1024 * 512, 'b')
+		+ "\"}\n";
+	REQUIRE(voiWriteTelemetrySnapshotAtomically(path, first));
+
+	std::atomic<bool> partialWriteEntered(false);
+	std::atomic<bool> releaseWrite(false);
+	std::atomic<bool> readerCompletedDuringWrite(false);
+	std::atomic<bool> overlappingWriteSucceeded(false);
+	DeterministicOverlapOperations overlapOperations(
+		partialWriteEntered,
+		releaseWrite,
+		readerCompletedDuringWrite);
+	std::thread overlappingWriter([&]() {
+		overlappingWriteSucceeded.store(
+			voiWriteTelemetrySnapshotAtomicallyWithOperations(
+				path,
+				second,
+				overlapOperations));
+	});
+	while (!partialWriteEntered.load())
+	{
+		std::this_thread::yield();
+	}
+	const std::string observedDuringPartialWrite = readFile(path);
+	REQUIRE(observedDuringPartialWrite == first);
+	readerCompletedDuringWrite.store(true);
+	releaseWrite.store(true);
+	overlappingWriter.join();
+	REQUIRE(overlappingWriteSucceeded.load());
+	REQUIRE(readFile(path) == second);
+
+	std::atomic<bool> readerReady(false);
+	std::atomic<bool> startReader(false);
+	std::atomic<bool> running(true);
+	std::atomic<bool> invalidObservation(false);
+	std::atomic<unsigned long> observations(0);
+	std::thread reader([&]() {
+		readerReady.store(true);
+		while (!startReader.load())
+		{
+			std::this_thread::yield();
+		}
+		while (running.load())
+		{
+			const std::string observed = readFile(path);
+			observations.fetch_add(1);
+			if (observed != first && observed != second)
+			{
+				invalidObservation.store(true);
+				return;
+			}
+		}
+	});
+	while (!readerReady.load())
+	{
+		std::this_thread::yield();
+	}
+	startReader.store(true);
+	while (observations.load() == 0)
+	{
+		std::this_thread::yield();
+	}
+	for (int index = 0; index < 200; ++index)
+	{
+		REQUIRE(voiWriteTelemetrySnapshotAtomically(
+			path,
+			index % 2 == 0 ? second : first));
+		std::this_thread::yield();
+	}
+	running.store(false);
+	reader.join();
+	REQUIRE(observations.load() > 0);
+	REQUIRE(!invalidObservation.load());
+	std::vector<std::string> temporaryFiles;
+	REQUIRE(temporaryFilesFor(path, temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+
+	const std::string interruptedPath =
+		"voi_atomic_telemetry_interrupted.json";
+	InterruptingShortWriteOperations interruptedOperations;
+	REQUIRE(voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		interruptedPath,
+		second,
+		interruptedOperations));
+	REQUIRE(interruptedOperations.interrupted);
+	REQUIRE(interruptedOperations.shortened);
+	REQUIRE(readFile(interruptedPath) == second);
+	temporaryFiles.clear();
+	REQUIRE(temporaryFilesFor(interruptedPath, temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+	REQUIRE(std::remove(interruptedPath.c_str()) == 0);
+
+	OpenFailureOperations openFailureOperations;
+	REQUIRE(!voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		"voi_atomic_telemetry_open_failure.json",
+		first,
+		openFailureOperations));
+	REQUIRE((openFailureOperations.flags & O_EXCL) != 0);
+	REQUIRE((openFailureOperations.flags & O_NOFOLLOW) != 0);
+	REQUIRE((openFailureOperations.flags & O_CLOEXEC) != 0);
+	REQUIRE(openFailureOperations.mode == 0600);
+
+	const std::string writeFailurePath =
+		"voi_atomic_telemetry_write_failure.json";
+	REQUIRE(writeFile(writeFailurePath, first));
+	WriteFailureOperations writeFailureOperations;
+	REQUIRE(!voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		writeFailurePath,
+		second,
+		writeFailureOperations));
+	REQUIRE(readFile(writeFailurePath) == first);
+	temporaryFiles.clear();
+	REQUIRE(temporaryFilesFor(writeFailurePath, temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+	REQUIRE(std::remove(writeFailurePath.c_str()) == 0);
+
+	const std::string closeFailurePath =
+		"voi_atomic_telemetry_close_failure.json";
+	REQUIRE(writeFile(closeFailurePath, first));
+	CloseFailureOperations closeFailureOperations;
+	REQUIRE(!voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		closeFailurePath,
+		second,
+		closeFailureOperations));
+	REQUIRE(closeFailureOperations.failed);
+	REQUIRE(readFile(closeFailurePath) == first);
+	temporaryFiles.clear();
+	REQUIRE(temporaryFilesFor(closeFailurePath, temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+	REQUIRE(std::remove(closeFailurePath.c_str()) == 0);
+
+	const std::string renameFailurePath =
+		"voi_atomic_telemetry_rename_failure.json";
+	REQUIRE(writeFile(renameFailurePath, first));
+	RenameFailureOperations renameFailureOperations;
+	REQUIRE(!voiWriteTelemetrySnapshotAtomicallyWithOperations(
+		renameFailurePath,
+		second,
+		renameFailureOperations));
+	REQUIRE(readFile(renameFailurePath) == first);
+	temporaryFiles.clear();
+	REQUIRE(temporaryFilesFor(renameFailurePath, temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+	REQUIRE(std::remove(renameFailurePath.c_str()) == 0);
+
+	const std::string victimPath =
+		"voi_atomic_telemetry_victim.json";
+	const std::string symlinkPath =
+		"voi_atomic_telemetry_symlink.json";
+	REQUIRE(writeFile(victimPath, first));
+	std::remove(symlinkPath.c_str());
+	REQUIRE(::symlink(victimPath.c_str(), symlinkPath.c_str()) == 0);
+	REQUIRE(voiWriteTelemetrySnapshotAtomically(symlinkPath, second));
+	REQUIRE(readFile(victimPath) == first);
+	REQUIRE(readFile(symlinkPath) == second);
+	REQUIRE(std::remove(symlinkPath.c_str()) == 0);
+	REQUIRE(std::remove(victimPath.c_str()) == 0);
+
+	const std::string directoryPath = "voi_atomic_telemetry_directory";
+	const std::string directoryLink =
+		"voi_atomic_telemetry_directory_link";
+	std::remove(directoryLink.c_str());
+	::rmdir(directoryPath.c_str());
+	REQUIRE(::mkdir(directoryPath.c_str(), 0700) == 0);
+	REQUIRE(::symlink(directoryPath.c_str(), directoryLink.c_str()) == 0);
+	REQUIRE(!voiWriteTelemetrySnapshotAtomically(
+		directoryLink + "/latest.json",
+		first));
+	REQUIRE(!voiWriteTelemetrySnapshotAtomically(
+		directoryLink + "//latest.json",
+		first));
+	REQUIRE(std::remove(directoryLink.c_str()) == 0);
+	REQUIRE(::rmdir(directoryPath.c_str()) == 0);
+
+	const std::string outerDirectory =
+		"voi_atomic_telemetry_outer";
+	const std::string nestedDirectory =
+		"voi_atomic_telemetry_nested";
+	const std::string nestedLink =
+		outerDirectory + "/linked";
+	std::remove(nestedLink.c_str());
+	::rmdir(outerDirectory.c_str());
+	::rmdir(nestedDirectory.c_str());
+	REQUIRE(::mkdir(outerDirectory.c_str(), 0700) == 0);
+	REQUIRE(::mkdir(nestedDirectory.c_str(), 0700) == 0);
+	REQUIRE(::symlink(
+		("../" + nestedDirectory).c_str(),
+		nestedLink.c_str()) == 0);
+	REQUIRE(!voiWriteTelemetrySnapshotAtomically(
+		nestedLink + "/latest.json",
+		first));
+	REQUIRE(std::remove(nestedLink.c_str()) == 0);
+	REQUIRE(::rmdir(outerDirectory.c_str()) == 0);
+	REQUIRE(::rmdir(nestedDirectory.c_str()) == 0);
+
+	REQUIRE(!voiWriteTelemetrySnapshotAtomically(
+		".",
+		"{\"frame\":3}\n"));
+	temporaryFiles.clear();
+	REQUIRE(temporaryFilesFor(".", temporaryFiles));
+	REQUIRE(temporaryFiles.empty());
+
+	REQUIRE(std::remove(path.c_str()) == 0);
+	return 0;
+}
