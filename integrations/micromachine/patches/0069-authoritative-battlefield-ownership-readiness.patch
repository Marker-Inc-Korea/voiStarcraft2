+		projectedOperation.transferSelectionIdentity =
+			operation.editSelectionIdentity;
+		projectedOperation.transferSelectionAcknowledgement =
+			operation.editSelectionAcknowledgement;
+		projectedOperation.transferSelectionResolution =
+			operation.editResolution;
+
+		const bool transferRequested =
+			operation.editAction == "transfer_in"
+			|| operation.editAction == "transfer_out";
+		const VoiOperationState * counterpart =
+			transferRequested
+				? latestOperationById(
+					operation.editCounterpartOperationId)
+				: nullptr;
+		const VoiOperationState * source =
+			counterpart == nullptr
+				? nullptr
+				: (operation.editAction == "transfer_out"
+					? &operation
+					: counterpart);
+		const VoiOperationState * destination =
+			counterpart == nullptr
+				? nullptr
+				: (operation.editAction == "transfer_in"
+					? &operation
+					: counterpart);
+		if (source != nullptr
+			&& destination != nullptr
+			&& !operation.editSelectionIdentity
+				.selectedUnitTags.empty())
+		{
+			auto & evidence =
+				projectedOperation
+					.transferSelectionRuntimeEvidence;
+			evidence.sourceUpdateId =
+				source->policyUpdateId;
+			evidence.counterpartUpdateId =
+				destination->policyUpdateId;
+			evidence.sourceOperationId =
