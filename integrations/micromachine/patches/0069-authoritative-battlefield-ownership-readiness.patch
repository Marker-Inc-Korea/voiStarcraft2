+inline std::set<std::uint64_t> voiBattlefieldEligibleTagSet(
+	const VoiBattlefieldProjection & projection)
+{
+	return std::set<std::uint64_t>(
+		projection.eligibleTags.begin(),
+		projection.eligibleTags.end());
+}
+
+inline std::vector<std::uint64_t> voiBattlefieldEligibleUniqueTags(
+	const std::vector<std::uint64_t> & tags,
+	const std::set<std::uint64_t> & eligibleTags)
+{
+	std::set<std::uint64_t> unique;
+	for (const auto tag : tags)
+	{
+		if (eligibleTags.find(tag) != eligibleTags.end())
+		{
+			unique.insert(tag);
+		}
+	}
+	return std::vector<std::uint64_t>(
+		unique.begin(),
+		unique.end());
+}
