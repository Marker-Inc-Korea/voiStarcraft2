+				? "true"
+				: "false")
+			<< ",\"blocker\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.transferSelection.blocker)
+			<< "\",\"identity\":";
+		voiBattlefieldWriteTransferSelectionIdentity(
+			output,
+			operation.transferSelection.identity);
+		output << ",\"write_identity\":";
+		voiBattlefieldWriteTransferSelectionWriteIdentity(
+			output,
+			operation.transferSelection.writeIdentity);
