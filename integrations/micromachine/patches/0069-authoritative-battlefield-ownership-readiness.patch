+			&& squadSnapshotValid
+			&& actionSnapshotValid
+			&& roleSnapshotValid;
+		projectedOperation.assignedTags =
+			operation.assignedUnitTags;
+		projectedOperation.minimumUnits =
+			static_cast<std::size_t>(
+				std::max(0, operation.minUnits));
+		projectedOperation.maximumUnits =
+			static_cast<std::size_t>(
+				std::max(0, operation.maxUnits));
+		projectedOperation.allowPartial =
+			operation.allowPartial;
+		projectedOperation.strictScope =
+			operation.strictScope;
+		projectedOperation.requestedRouteType =
+			operation.requestedRouteType.empty()
+				? operation.routeType
+				: operation.requestedRouteType;
+		projectedOperation.routeType =
+			operation.routeType;
+		projectedOperation.targetIntent =
+			operation.locationIntent;
+		projectedOperation.targetType =
+			operation.targetType.empty()
+				? operation.taskType
+				: operation.targetType;
+		projectedOperation.resolvedTargetLabel =
+			operation.resolvedTargetLabel.empty()
+				? operation.locationIntent
+				: operation.resolvedTargetLabel;
+		projectedOperation.targetEvidence =
+			operation.targetEvidence;
+		projectedOperation.targetX =
