+			projectedBase.groundThreat
+			+ projectedBase.airThreat;
+		projectedBase.threatened =
+			projectedBase.observedEnemyStrength > 0.0f;
+		projectedBase.requiredDefenderCount =
+			visibleGroundThreatCount + visibleAirThreatCount;
+		projectedBase.protectedMinimum =
+			projectedBase.requiredDefenderCount;
+
+		std::ostringstream defenseSquadName;
+		defenseSquadName << "Base Defense "
