+				owner.second.begin()
+					+ availability.sourceMinimum,
+				owner.second.end());
+		}
+		availability.operationAssignmentsMatch = true;
+		availability.squadAssignmentsMatch = true;
+		availability.actionAssignmentsMatch = true;
+		availability.roleAssignmentsMatch = true;
+		availability.admissionBlocker =
+			"autonomous_transfer_requires_operation_admission";
+		input.transferAvailability.push_back(availability);
+	}
+
+	m_voiBattlefieldProjection =
+		voiMakeBattlefieldProjection(input);
+}
