+		projectedOperation.targetY =
+			operation.targetY;
+		projectedOperation.lifetimeMode =
+			operation.lifetimeMode;
+		projectedOperation.completionConditions =
+			operation.completionConditions;
+		projectedOperation.durationSeconds =
+			static_cast<std::uint64_t>(
+				std::max(0, operation.durationSeconds));
+		projectedOperation.issuedAtFrame =
+			operation.issuedAtFrame;
+		projectedOperation.deadlineFrame =
+			operation.deadlineFrame;
+		projectedOperation.standing =
+			operation.standing;
+		projectedOperation.completed =
+			operation.completed;
+		projectedOperation.completionReason =
+			operation.completionReason;
+		projectedOperation.completionFrame =
+			operation.completionFrame;
+		projectedOperation.movementObserved =
+			operation.status == "MOVING"
+			|| operation.status == "ENGAGED"
+			|| operation.maxHomeDistance >= 1.0f;
+		projectedOperation.engagementObserved =
+			operation.engaged;
+		projectedOperation.targetReached =
+			operation.targetReached;
+		projectedOperation.emergencyPreemption =
