+				? "true"
+				: "false")
+			<< ",\"atomic_revalidation_ready\":"
+			<< (transfer.atomicRevalidationReady
+				? "true"
+				: "false")
+			<< "}}";
+	}
+	output << "]},\"ownership_integrity\":\""
+		<< (projection.ownershipIntegrity
+			? "valid"
+			: (projection.ownershipEvidencePresent
+				? "fail_closed"
+				: "missing_evidence"))
+		<< "\",\"owner_count\":"
+		<< projection.ownerCount
+		<< ",\"unique_owner_tag_count\":"
+		<< projection.uniqueOwnerTagCount
+		<< ",\"duplicate_owner_tags\":";
+	voiBattlefieldWriteTagArray(
+		output,
