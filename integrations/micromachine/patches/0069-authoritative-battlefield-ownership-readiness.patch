+			<< "\"owner_count\":"
+			<< operation.ownerTags.size()
+			<< ",\"owner_tags\":";
+		voiBattlefieldWriteTagArray(
+			output,
+			operation.ownerTags);
+		output << ",\"integrity_status\":\""
+			<< (projection.ownershipIntegrity
+				&& operation.ownershipEvidencePresent
+					? "valid"
+					: "invalid")
+			<< "\"},\"operation_launch_policy\":{"
+			<< "\"min_units\":"
+			<< operation.minimumUnits
