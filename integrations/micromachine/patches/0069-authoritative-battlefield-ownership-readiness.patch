+		const VoiOperationState * operation =
+			findVoiOperationBySquad(squadName);
+		for (const auto & unit : squadEntry.second.getUnits())
+		{
+			if (operation != nullptr)
+			{
+				addExplicitOwner(
+					unit.getTag(),
+					operation->operationId,
+					operation->generation);
+			}
