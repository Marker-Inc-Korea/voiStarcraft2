+	const std::string & id,
+	std::uint64_t generation,
+	std::vector<std::uint64_t> tags)
+{
+	VoiBattlefieldOperationInput value;
+	value.operationId = id;
+	value.generation = generation;
+	value.updateId = "battlefield-test";
+	value.status = "ASSIGNED";
+	value.active = true;
+	value.ownershipEvidencePresent = true;
+	value.assignedTags = std::move(tags);
+	value.minimumUnits = 2;
+	value.maximumUnits = 4;
+	value.allowPartial = true;
+	value.requestedRouteType = "flank_left";
+	value.routeType = "flank_left";
+	value.targetIntent = "enemy_natural";
+	value.targetType = "enemy_expansion";
+	value.resolvedTargetLabel = "enemy natural";
+	value.targetEvidence = "observed_enemy_structure";
+	value.targetX = 80.0f;
+	value.targetY = 42.0f;
+	value.lifetimeMode = "until_completed";
+	value.completionConditions = "target_reached,cancelled_by_user";
+	value.durationSeconds = 300;
+	value.issuedAtFrame = 220;
+	value.deadlineFrame = 6820;
+	return value;
+}
