+	output << ",\"excluded_unit_tags\":{\"dead\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedDeadTags);
+	output << ",\"non_self\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedNonSelfTags);
+	output << ",\"incomplete\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedIncompleteTags);
+	output << ",\"worker\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedWorkerTags);
+	output << ",\"structure\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedStructureTags);
+	output << ",\"temporary_payload\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedTemporaryPayloadTags);
+	output << ",\"non_combat\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.excludedNonCombatTags);
+	output << "},\"duplicate_unit_input_tags\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.duplicateUnitInputTags);
+	output << "}";
+	return output.str();
+}
