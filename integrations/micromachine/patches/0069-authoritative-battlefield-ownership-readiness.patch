+			input.baseEvidencePresent = false;
+			continue;
+		}
+		VoiBattlefieldBaseInput projectedBase;
+		const CCPosition basePosition =
+			Util::GetPosition(base->getDepotTilePosition());
+		std::ostringstream baseId;
+		baseId << "base:" << basePosition.x
+			<< ":" << basePosition.y;
+		projectedBase.baseId = baseId.str();
+		projectedBase.semanticAnchor =
+			base == selfMain
+				? "self_main"
+				: (base == selfNatural
