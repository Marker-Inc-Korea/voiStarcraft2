+	output << "],\"unassigned_unit_tags\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		projection.unassignedTags);
+	output << ",\"bases\":[";
+	for (std::size_t index = 0;
+		index < projection.bases.size();
+		++index)
+	{
+		if (index > 0)
+		{
+			output << ",";
+		}
+		const auto & base = projection.bases[index];
+		output << "{\"base_id\":\""
+			<< voiBattlefieldJsonEscape(base.baseId)
