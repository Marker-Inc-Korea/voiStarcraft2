+					: "self_expansion");
+		projectedBase.occupied = true;
+		projectedBase.readinessEvidencePresent =
+			basePosition != CCPosition()
+			&& m_bot.Map().isValidPosition(basePosition);
+		projectedBase.threatEvidencePresent =
+			projectedBase.readinessEvidencePresent
+			&& m_bot.Map().isVisible(basePosition);
+
+		std::size_t visibleGroundThreatCount = 0;
+		std::size_t visibleAirThreatCount = 0;
+		if (projectedBase.threatEvidencePresent)
+		{
+			for (const auto & enemy : m_bot.GetKnownEnemyUnits())
