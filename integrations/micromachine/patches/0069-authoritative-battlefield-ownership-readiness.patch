+				: "false")
+			<< ",\"acknowledged_frame\":"
+			<< operation.transferSelection
+				.acknowledgedFrame
+			<< ",\"identity\":";
+		voiBattlefieldWriteTransferSelectionWriteIdentity(
+			output,
+			operation.transferSelection
+				.acknowledgedIdentity);
+		output << "}}}";
+	}
+	output << "],\"autonomous_ownership\":[";
+	for (std::size_t index = 0;
+		index < projection.autonomousOwners.size();
+		++index)
+	{
+		if (index > 0)
