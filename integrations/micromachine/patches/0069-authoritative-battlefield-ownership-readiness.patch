+std::string voiOperationIdentityStage(
+	const VoiOperationState & operation)
+{
+	const bool movementObserved =
+		operation.status == "MOVING"
+		|| operation.status == "ENGAGED"
+		|| operation.maxHomeDistance >= 1.0f;
+	return operation.completed
+		? "terminal"
+		: (operation.engaged || movementObserved
+			? "effect_observed"
+			: (operation.submissionObserved
+				? "submitted"
+				: (operation.assignedCount > 0
+					? "assigned"
+					: "planned")));
+}
