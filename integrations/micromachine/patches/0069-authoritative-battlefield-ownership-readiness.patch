+
+template <typename Tag>
+VoiOperationTransferSelectionValidation
+voiCanonicalizeOperationTransferSelectionIdentity(
+	VoiOperationTransferSelectionIdentity<Tag> & identity)
+{
+	if (identity.updateId.empty())
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_update_missing");
+	}
+	if (identity.sourceOperationId.empty())
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_source_missing");
+	}
+	if (identity.counterpartOperationId.empty()
+		|| identity.counterpartOperationId
+			== identity.sourceOperationId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_counterpart_mismatch");
+	}
+	if (identity.sourceAction != "transfer_out"
+		|| identity.counterpartAction != "transfer_in")
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_action_mismatch");
+	}
+	if (identity.sourceGeneration == 0
+		|| identity.counterpartGeneration == 0
+		|| identity.requestedSourceGeneration
+			<= identity.sourceGeneration
+		|| identity.requestedCounterpartGeneration
+			<= identity.counterpartGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_generation_mismatch");
+	}
+	if (identity.requestedCount == 0
+		|| identity.selectedUnitTags.empty())
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_empty");
+	}
+	std::sort(
+		identity.selectedUnitTags.begin(),
+		identity.selectedUnitTags.end());
+	for (std::size_t index = 0;
+		index < identity.selectedUnitTags.size();
+		++index)
+	{
+		if (identity.selectedUnitTags[index] == Tag())
+		{
+			return VoiOperationTransferSelectionValidation(
+				false,
+				"transfer_selection_invalid_tag");
+		}
+		if (index > 0
+			&& identity.selectedUnitTags[index - 1]
+				== identity.selectedUnitTags[index])
+		{
+			return VoiOperationTransferSelectionValidation(
+				false,
+				"transfer_selection_duplicate_tag");
+		}
+	}
+	if (identity.requestedCount
+		!= identity.selectedUnitTags.size())
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_count_mismatch");
+	}
+	return VoiOperationTransferSelectionValidation(true, "");
+}
+
+template <typename Tag>
+VoiOperationTransferSelectionValidation
+voiRevalidateOperationTransferSelectionIdentity(
+	const VoiOperationTransferSelectionIdentity<Tag> & admitted,
+	const VoiOperationTransferSelectionIdentity<Tag> & observed)
+{
+	VoiOperationTransferSelectionIdentity<Tag> expected = admitted;
+	VoiOperationTransferSelectionIdentity<Tag> actual = observed;
+	const auto expectedValidation =
+		voiCanonicalizeOperationTransferSelectionIdentity(expected);
+	if (!expectedValidation.valid)
+	{
+		return expectedValidation;
+	}
+	const auto actualValidation =
+		voiCanonicalizeOperationTransferSelectionIdentity(actual);
+	if (!actualValidation.valid)
+	{
+		return actualValidation;
+	}
+	if (expected.updateId != actual.updateId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_update_mismatch");
+	}
+	if (expected.sourceOperationId != actual.sourceOperationId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_source_mismatch");
+	}
+	if (expected.counterpartOperationId
+		!= actual.counterpartOperationId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_counterpart_mismatch");
+	}
+	if (expected.sourceAction != actual.sourceAction
+		|| expected.counterpartAction
+			!= actual.counterpartAction)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_action_mismatch");
+	}
+	if (expected.sourceGeneration
+		!= actual.sourceGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_source_generation_mismatch");
+	}
+	if (expected.counterpartGeneration
+		!= actual.counterpartGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_counterpart_generation_mismatch");
+	}
+	if (expected.requestedSourceGeneration
+		!= actual.requestedSourceGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_requested_source_generation_mismatch");
+	}
+	if (expected.requestedCounterpartGeneration
+		!= actual.requestedCounterpartGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_requested_counterpart_generation_mismatch");
+	}
+	if (expected.requestedCount != actual.requestedCount)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_count_mismatch");
+	}
+	if (expected.selectedUnitTags != actual.selectedUnitTags)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_tags_mismatch");
+	}
+	return VoiOperationTransferSelectionValidation(true, "");
+}
+
+template <typename Tag>
+VoiOperationTransferSelectionValidation
+voiValidateOperationTransferSelectionRuntimeEvidence(
+	const VoiOperationTransferSelectionIdentity<Tag> & admitted,
+	const VoiOperationTransferSelectionRuntimeEvidence<Tag> & evidence)
+{
+	VoiOperationTransferSelectionIdentity<Tag> expected = admitted;
+	const auto expectedValidation =
+		voiCanonicalizeOperationTransferSelectionIdentity(expected);
+	if (!expectedValidation.valid)
+	{
+		return expectedValidation;
+	}
+	if (evidence.sourceUpdateId != expected.updateId
+		|| evidence.counterpartUpdateId != expected.updateId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_update_mismatch");
+	}
+	if (evidence.sourceOperationId != expected.sourceOperationId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_source_mismatch");
+	}
+	if (evidence.counterpartOperationId
+		!= expected.counterpartOperationId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_counterpart_mismatch");
+	}
+	if (evidence.sourceAction != expected.sourceAction
+		|| evidence.counterpartAction
+			!= expected.counterpartAction)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_action_mismatch");
+	}
+	if (evidence.sourceResolution
+			!= evidence.counterpartResolution
+		|| (evidence.sourceResolution != "pending"
+			&& evidence.sourceResolution != "blocked"
+			&& evidence.sourceResolution != "applied"))
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_resolution_mismatch");
+	}
+	const bool applied =
+		evidence.sourceResolution == "applied";
+	if (evidence.sourceGeneration
+			!= (applied
+				? expected.requestedSourceGeneration
+				: expected.sourceGeneration))
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_source_generation_mismatch");
+	}
+	if (evidence.counterpartGeneration
+			!= (applied
+				? expected.requestedCounterpartGeneration
+				: expected.counterpartGeneration))
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_counterpart_generation_mismatch");
+	}
+	if (evidence.requestedSourceGeneration
+			!= expected.requestedSourceGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_requested_source_generation_mismatch");
+	}
+	if (evidence.requestedCounterpartGeneration
+			!= expected.requestedCounterpartGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_requested_counterpart_generation_mismatch");
+	}
+
+	std::set<Tag> sourceOwners(
+		evidence.sourceOwnedTags.begin(),
+		evidence.sourceOwnedTags.end());
+	std::set<Tag> destinationOwners(
+		evidence.destinationOwnedTags.begin(),
+		evidence.destinationOwnedTags.end());
+	if (sourceOwners.size() != evidence.sourceOwnedTags.size()
+		|| destinationOwners.size()
+			!= evidence.destinationOwnedTags.size())
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_owner_identity_mismatch");
+	}
+	for (const auto tag : expected.selectedUnitTags)
+	{
+		const bool sourceOwned =
+			sourceOwners.find(tag) != sourceOwners.end();
+		const bool destinationOwned =
+			destinationOwners.find(tag)
+				!= destinationOwners.end();
+		if (applied
+			? (sourceOwned || !destinationOwned)
+			: (!sourceOwned || destinationOwned))
+		{
+			return VoiOperationTransferSelectionValidation(
+				false,
+				"transfer_selection_runtime_ownership_mismatch");
+		}
+	}
+	return VoiOperationTransferSelectionValidation(true, "");
+}
+
+template <typename Tag>
+VoiOperationTransferSelectionValidation
+voiCanonicalizeOperationTransferSelectionWriteIdentity(
+	VoiOperationTransferSelectionWriteIdentity<Tag> & identity)
+{
+	const auto selectionValidation =
+		voiCanonicalizeOperationTransferSelectionIdentity(
+			identity.selectionIdentity);
+	if (!selectionValidation.valid)
+	{
+		return selectionValidation;
+	}
+	if (identity.updateId.empty()
+		|| identity.updateId
+			!= identity.selectionIdentity.updateId)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_write_update_mismatch");
+	}
+	if (identity.operationId.empty()
+		|| (identity.operationId
+				!= identity.selectionIdentity.sourceOperationId
+			&& identity.operationId
+				!= identity.selectionIdentity
+					.counterpartOperationId))
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_write_operation_mismatch");
+	}
+	if (identity.operationGeneration == 0
+		|| identity.stage.empty()
+		|| identity.gameFrame == 0)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_write_identity_missing");
+	}
+	const bool sourceOperation =
+		identity.operationId
+			== identity.selectionIdentity.sourceOperationId;
+	const std::uint64_t existingGeneration =
+		sourceOperation
+			? identity.selectionIdentity.sourceGeneration
+			: identity.selectionIdentity.counterpartGeneration;
+	const std::uint64_t requestedGeneration =
+		sourceOperation
+			? identity.selectionIdentity.requestedSourceGeneration
+			: identity.selectionIdentity
+				.requestedCounterpartGeneration;
+	if (identity.operationGeneration != existingGeneration
+		&& identity.operationGeneration != requestedGeneration)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_write_generation_mismatch");
+	}
+	return VoiOperationTransferSelectionValidation(true, "");
+}
+
+template <typename Tag>
+VoiOperationTransferSelectionValidation
+voiRevalidateOperationTransferSelectionWriteIdentity(
+	const VoiOperationTransferSelectionWriteIdentity<Tag> & expectedInput,
+	const VoiOperationTransferSelectionWriteIdentity<Tag> & observedInput)
+{
+	auto expected = expectedInput;
+	auto observed = observedInput;
+	const auto expectedValidation =
+		voiCanonicalizeOperationTransferSelectionWriteIdentity(
+			expected);
+	if (!expectedValidation.valid)
+	{
+		return expectedValidation;
+	}
+	const auto observedValidation =
+		voiCanonicalizeOperationTransferSelectionWriteIdentity(
+			observed);
+	if (!observedValidation.valid)
+	{
+		return observedValidation;
+	}
+	const auto selectionValidation =
+		voiRevalidateOperationTransferSelectionIdentity(
+			expected.selectionIdentity,
+			observed.selectionIdentity);
+	if (!selectionValidation.valid)
+	{
+		return selectionValidation;
+	}
+	if (expected.updateId != observed.updateId
+		|| expected.operationId != observed.operationId
+		|| expected.operationGeneration
+			!= observed.operationGeneration
+		|| expected.stage != observed.stage
+		|| expected.gameFrame != observed.gameFrame)
+	{
+		return VoiOperationTransferSelectionValidation(
+			false,
+			"transfer_selection_write_identity_mismatch");
+	}
+	return VoiOperationTransferSelectionValidation(true, "");
+}
+
+template <typename Tag>
+bool voiAcknowledgeOperationTransferSelectionWrite(
+	const VoiOperationTransferSelectionWriteIdentity<Tag> & liveIdentity,
+	const VoiOperationTransferSelectionWriteIdentity<Tag> & writtenIdentity,
+	std::uint64_t writtenFrame,
+	VoiOperationTransferSelectionAcknowledgement<Tag> & acknowledgement)
+{
+	const auto validation =
+		voiRevalidateOperationTransferSelectionWriteIdentity(
+			liveIdentity,
+			writtenIdentity);
+	if (!validation.valid
+		|| writtenFrame == 0
+		|| writtenIdentity.gameFrame != writtenFrame)
+	{
+		return false;
+	}
+	acknowledgement.acknowledged = true;
+	acknowledgement.acknowledgedFrame = writtenFrame;
+	acknowledgement.identity = writtenIdentity;
+	return true;
+}
+
+template <typename Tag>
+bool voiOperationTransferSelectionAcknowledgementMatches(
+	const VoiOperationTransferSelectionWriteIdentity<Tag> & currentContextInput,
+	const VoiOperationTransferSelectionAcknowledgement<Tag> & acknowledgement,
+	std::uint64_t currentFrame)
+{
+	if (!acknowledgement.acknowledged
+		|| acknowledgement.acknowledgedFrame == 0
+		|| acknowledgement.acknowledgedFrame > currentFrame
+		|| acknowledgement.identity.gameFrame
+			!= acknowledgement.acknowledgedFrame)
+	{
+		return false;
+	}
+	auto currentContext = currentContextInput;
+	auto acknowledgedIdentity = acknowledgement.identity;
+	const auto currentValidation =
+		voiCanonicalizeOperationTransferSelectionWriteIdentity(
+			currentContext);
+	const auto acknowledgedValidation =
+		voiCanonicalizeOperationTransferSelectionWriteIdentity(
+			acknowledgedIdentity);
+	if (!currentValidation.valid || !acknowledgedValidation.valid)
+	{
+		return false;
+	}
+	const auto selectionValidation =
+		voiRevalidateOperationTransferSelectionIdentity(
+			currentContext.selectionIdentity,
+			acknowledgedIdentity.selectionIdentity);
+	return selectionValidation.valid
+		&& currentContext.updateId
+			== acknowledgedIdentity.updateId
+		&& currentContext.operationId
+			== acknowledgedIdentity.operationId
+		&& currentContext.operationGeneration
+			== acknowledgedIdentity.operationGeneration
+		&& currentContext.stage
+			== acknowledgedIdentity.stage;
+}
+
+template <typename State>
+void voiResetOperationTransferSelectionEpoch(State & state)
+{
+	state.editSelectionIdentity =
+		decltype(state.editSelectionIdentity)();
+	state.editSelectionAcknowledgement =
+		decltype(state.editSelectionAcknowledgement)();
+}
