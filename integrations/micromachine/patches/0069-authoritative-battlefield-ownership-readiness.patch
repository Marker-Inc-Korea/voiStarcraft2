+		}
+		for (const auto & role : operation.assignedRoleByTag)
+		{
+			addExplicitOwner(
+				role.first,
+				operation.operationId,
+				operation.generation);
+		}
+	}
+
+	std::map<std::string, std::vector<sc2::Tag>>
+		autonomousTagsByOwner;
+	for (const auto & squadEntry : m_squadData.getSquads())
