+	}
+
+	const auto assignedTagSet =
+		[](const VoiOperationState & operation)
+		{
+			return std::set<sc2::Tag>(
+				operation.assignedUnitTags.begin(),
+				operation.assignedUnitTags.end());
+		};
+	const auto isActiveOperation =
+		[&](const VoiOperationState & operation)
+		{
+			return !operation.completed
+				&& operation.status != "BLOCKED"
+				&& operation.status != "CANCELLED"
+				&& operation.status != "EXPIRED"
+				&& operation.status != "FAILED"
+				&& operation.status != "SUPERSEDED"
+				&& !operation.squadName.empty()
+				&& m_squadData.squadExists(
+					operation.squadName);
+		};
+	const auto operationAssignmentsMatch =
+		[&](const VoiOperationState & operation)
+		{
+			const std::set<sc2::Tag> tags =
+				assignedTagSet(operation);
+			if (tags.size()
+					!= operation.assignedUnitTags.size()
+				|| static_cast<int>(tags.size())
+					!= operation.assignedCount)
+			{
+				return false;
+			}
+			for (const auto tag : tags)
+			{
+				const auto owner =
+					m_voiOperationUnitOwners.find(tag);
+				if (owner == m_voiOperationUnitOwners.end()
+					|| owner->second.first
+						!= operation.operationId
+					|| owner->second.second
+						!= operation.generation)
+				{
+					return false;
+				}
+			}
+			return true;
+		};
+	const auto squadAssignmentsMatch =
+		[&](const VoiOperationState & operation)
+		{
+			if (operation.squadName.empty()
+				|| !m_squadData.squadExists(
+					operation.squadName))
+			{
+				return operation.completed
+					&& operation.assignedUnitTags.empty();
+			}
+			const std::set<sc2::Tag> expected =
+				assignedTagSet(operation);
+			std::set<sc2::Tag> actual;
+			for (const auto & unit :
+				m_squadData.getSquad(
+					operation.squadName).getUnits())
+			{
+				if (!unit.isValid()
+					|| !unit.isAlive()
+					|| !actual.insert(unit.getTag()).second)
+				{
+					return false;
+				}
+			}
+			return actual == expected;
+		};
+	const auto actionAssignmentsMatch =
+		[&](const VoiOperationState & operation)
+		{
+			const std::set<sc2::Tag> expected =
+				assignedTagSet(operation);
+			for (const auto & actionEntry : unitActions)
+			{
+				if (actionEntry.first == nullptr)
+				{
+					continue;
+				}
+				const sc2::Tag tag =
+					actionEntry.first->tag;
+				const UnitAction & action =
+					actionEntry.second;
+				const bool actionHasOwner =
+					!action.operationId.empty()
+					|| action.operationGeneration > 0;
+				const bool expectedTag =
+					expected.find(tag) != expected.end();
+				const bool matchingAction =
+					action.operationId
+						== operation.operationId
+					&& action.operationGeneration
+						== operation.generation;
+				if ((expectedTag && actionHasOwner
+						&& !matchingAction)
+					|| (matchingAction && !expectedTag))
+				{
+					return false;
+				}
+			}
+			return true;
+		};
+	const auto roleAssignmentsMatch =
+		[&](const VoiOperationState & operation)
+		{
+			const std::set<sc2::Tag> expected =
+				assignedTagSet(operation);
+			for (const auto & role :
+				operation.assignedRoleByTag)
+			{
+				if (role.second.empty()
+					|| expected.find(role.first)
+						== expected.end())
+				{
+					return false;
+				}
+			}
+			return true;
+		};
+	const auto latestOperationById =
+		[&](const std::string & operationId)
+			-> const VoiOperationState *
+		{
+			const VoiOperationState * latest = nullptr;
+			for (const auto & candidate : m_voiOperations)
+			{
+				if (candidate.operationId == operationId
+					&& (latest == nullptr
+						|| candidate.generation
+							> latest->generation))
+				{
+					latest = &candidate;
+				}
+			}
+			return latest;
+		};
+
+	const bool emergencyPreemption =
+		m_bot.Commander().getVoiPolicyBool(
+			"emergency.force_retreat",
+			false)
