+			}
+		}
+	}
+	for (const auto & actionEntry : unitActions)
+	{
+		if (actionEntry.first != nullptr)
+		{
+			addExplicitOwner(
+				actionEntry.first->tag,
+				actionEntry.second.operationId,
+				actionEntry.second.operationGeneration);
+		}
+	}
+	for (const auto & unitEntry : unitsByTag)
+	{
+		input.units.push_back(unitEntry.second);
+	}
+
+	std::map<std::string, std::size_t>
+		autonomousProtectedMinimum;
+	const auto & occupiedBases =
+		m_bot.Bases().getOccupiedBaseLocations(Players::Self);
+	input.baseEvidencePresent = !occupiedBases.empty();
+	const BaseLocation * selfMain =
+		m_bot.Bases().getPlayerStartingBaseLocation(Players::Self);
+	BaseLocation * selfNatural =
+		m_bot.Bases().getPlayerNat(Players::Self);
+	for (const BaseLocation * base : occupiedBases)
