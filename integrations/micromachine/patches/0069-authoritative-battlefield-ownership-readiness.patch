+		}
+		VoiBattlefieldTransferInput availability;
+		availability.sourceOwnerId = owner.first;
+		availability.sourceOwnerTags = owner.second;
+		availability.sourceActive = true;
+		const auto protectedMinimum =
+			autonomousProtectedMinimum.find(owner.first);
+		availability.sourceMinimum =
+			protectedMinimum
+					!= autonomousProtectedMinimum.end()
+				? protectedMinimum->second
