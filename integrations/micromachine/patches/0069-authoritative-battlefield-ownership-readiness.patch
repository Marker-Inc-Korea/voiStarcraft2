+			output << ",";
+		}
+		const auto & operation = projection.operations[index];
+		const std::size_t missingCount =
+			operation.minimumUnits > operation.assignedCount
+				? operation.minimumUnits
+					- operation.assignedCount
+				: 0;
+		output << "{\"identity\":{"
+			<< "\"update_id\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.updateId)
