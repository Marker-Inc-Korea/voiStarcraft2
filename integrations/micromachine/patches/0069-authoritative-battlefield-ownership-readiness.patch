+
+inline std::string voiBattlefieldJsonEscape(const std::string & value)
+{
+	std::ostringstream escaped;
+	for (const char ch : value)
+	{
+		switch (ch)
+		{
+		case '\\':
+		case '"':
+			escaped << '\\' << ch;
+			break;
+		case '\n':
+			escaped << "\\n";
+			break;
+		case '\r':
+			escaped << "\\r";
+			break;
+		case '\t':
+			escaped << "\\t";
+			break;
+		default:
+			escaped << ch;
+			break;
+		}
+	}
+	return escaped.str();
+}
+
+inline bool voiBattlefieldStandingMayComplete(
+	bool standing,
+	const std::string & completionReason)
+{
+	if (!standing)
+	{
+		return true;
+	}
+	static const std::set<std::string> terminalReasons = {
+		"cancelled_by_policy",
+		"cancelled_by_user",
+		"completed_by_policy",
+		"expired_by_policy",
+		"failed_by_policy",
+		"operation_deadline_expired",
+		"superseded_by_policy",
+		"transferred_all_units",
+	};
+	return terminalReasons.find(completionReason)
+		!= terminalReasons.end();
+}
+
+inline std::vector<std::string> voiBattlefieldSplitCommaList(
+	const std::string & value)
+{
+	std::vector<std::string> result;
+	std::string token;
+	for (std::size_t index = 0; index <= value.size(); ++index)
+	{
+		const char ch =
+			index < value.size() ? value[index] : ',';
+		if (ch != ',')
+		{
+			token.push_back(ch);
+			continue;
+		}
+		const std::size_t first = token.find_first_not_of(" \t");
+		const std::size_t last = token.find_last_not_of(" \t");
+		if (first != std::string::npos)
+		{
+			result.push_back(token.substr(first, last - first + 1));
+		}
+		token.clear();
+	}
+	return result;
+}
+
+inline std::string voiBattlefieldCompletionState(
+	const std::string & status,
+	bool completed)
+{
+	if (!completed)
+	{
+		return status == "BLOCKED" ? "blocked" : "active";
+	}
+	if (status == "CANCELLED")
+	{
+		return "cancelled";
+	}
+	if (status == "EXPIRED")
+	{
+		return "expired";
+	}
+	if (status == "SUPERSEDED")
+	{
+		return "superseded";
+	}
+	if (status == "FAILED")
+	{
+		return "failed";
+	}
+	return "completed";
+}
