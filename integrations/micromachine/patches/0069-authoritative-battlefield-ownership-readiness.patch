+inline VoiBattlefieldTransferProjection
+voiProjectBattlefieldTransfer(
+	const VoiBattlefieldTransferInput & input,
+	bool ownershipIntegrity,
+	const std::set<std::uint64_t> & eligibleTags)
+{
+	VoiBattlefieldTransferProjection result;
+	result.requested =
+		input.requested && input.editResolution != "applied";
+	result.action = result.requested && !input.action.empty()
+		? input.action
+		: "availability";
+	result.counterpartAction =
+		result.requested ? input.counterpartAction : "";
+	result.editResolution = input.editResolution.empty()
+		? (result.requested ? "pending" : "none")
+		: input.editResolution;
+	if (!result.requested)
+	{
+		result.editResolution =
+			input.editResolution == "applied"
+				? "applied"
+				: "none";
+	}
+	result.counterpartOperationId =
+		result.requested
+			? input.counterpartOperationId
+			: "";
+	result.sourceOwnerId = input.sourceOwnerId;
+	result.requestedGeneration =
+		input.requestedGeneration;
+	result.counterpartGeneration =
+		input.counterpartGeneration;
+	result.requestedSourceGeneration =
+		input.requestedSourceGeneration;
+	result.requestedCounterpartGeneration =
+		input.requestedCounterpartGeneration;
+	result.requestedCount =
+		result.requested ? input.requestedCount : 0;
+	result.counterpartPresent =
+		input.counterpartPresent;
+	result.counterpartPending =
+		input.counterpartPending;
+	result.sourceActive = input.sourceActive;
+	result.destinationActive =
+		result.requested
+			? input.destinationActive
+			: true;
+	result.ownershipIntegrity = ownershipIntegrity;
+	result.operationAssignmentsMatch =
+		input.operationAssignmentsMatch;
+	result.squadAssignmentsMatch =
+		input.squadAssignmentsMatch;
+	result.actionAssignmentsMatch =
+		input.actionAssignmentsMatch;
+	result.roleAssignmentsMatch =
+		input.roleAssignmentsMatch;
+	const std::string expectedCounterpartAction =
+		input.action == "transfer_out"
+			? "transfer_in"
+			: (input.action == "transfer_in"
+				? "transfer_out"
+				: "");
+	result.reciprocalAction =
+		!result.requested
+		|| (!expectedCounterpartAction.empty()
+			&& input.counterpartAction
+				== expectedCounterpartAction);
+	result.reciprocalCounterpart =
+		!result.requested
+		|| input.counterpartCounterpartOperationId
+			== input.sourceOwnerId;
+	result.reciprocalGeneration =
+		!result.requested
+		|| (input.requestedGeneration > 0
+			&& input.counterpartGeneration > 0
+			&& input.requestedSourceGeneration
+				> input.requestedGeneration
+			&& input.requestedCounterpartGeneration
+				> input.counterpartGeneration
+			&& input.counterpartRequestedGeneration
+				== input.requestedCounterpartGeneration);
+	result.reciprocalCount =
+		!result.requested
+		|| input.counterpartRequestedCount
+			== input.requestedCount;
+	const std::vector<std::uint64_t> sourceTags =
+		voiBattlefieldEligibleUniqueTags(
+			input.sourceOwnerTags,
+			eligibleTags);
+	const std::vector<std::uint64_t> selectedTags =
+		voiBattlefieldEligibleUniqueTags(
+			input.selectedTags,
+			eligibleTags);
+	result.sourceOwnerCount = sourceTags.size();
+	result.protectedMinimum = input.sourceMinimum;
+	const std::size_t sourceSurplus =
+		result.sourceOwnerCount > result.protectedMinimum
+			? result.sourceOwnerCount - result.protectedMinimum
+			: 0;
+	const std::size_t destinationCapacity =
+		input.destinationMaximum > input.destinationOwnedCount
+			? input.destinationMaximum
+				- input.destinationOwnedCount
+			: 0;
+	const std::size_t prospectiveAvailableCount = result.requested
+		? selectedTags.size()
+		: std::min(sourceSurplus, selectedTags.size());
+	result.protectedMinimumRespected =
+		result.sourceOwnerCount >= result.protectedMinimum
+		&& prospectiveAvailableCount <= sourceSurplus;
+
+	if (result.requested)
+	{
+		if (input.sourceUpdateId.empty()
+			|| input.sourceUpdateId
+				!= input.counterpartUpdateId)
+		{
+			result.blocker =
+				"transfer_selection_update_mismatch";
+			return result;
+		}
+		VoiOperationTransferSelectionIdentity<std::uint64_t>
+			observedIdentity;
+		observedIdentity.updateId =
+			input.sourceUpdateId;
+		observedIdentity.sourceOperationId =
+			input.sourceOwnerId;
+		observedIdentity.counterpartOperationId =
+			input.counterpartOperationId;
+		observedIdentity.sourceAction = input.action;
+		observedIdentity.counterpartAction =
+			input.counterpartAction;
+		observedIdentity.sourceGeneration =
+			input.requestedGeneration;
+		observedIdentity.counterpartGeneration =
+			input.counterpartGeneration;
+		observedIdentity.requestedSourceGeneration =
+			input.requestedSourceGeneration;
+		observedIdentity.requestedCounterpartGeneration =
+			input.requestedCounterpartGeneration;
+		observedIdentity.requestedCount =
+			input.requestedCount;
+		observedIdentity.selectedUnitTags =
+			input.selectedTags;
+		const auto selectionValidation =
+			voiRevalidateOperationTransferSelectionIdentity(
+				input.admittedSelectionIdentity,
+				observedIdentity);
+		if (!selectionValidation.valid)
+		{
+			result.blocker = selectionValidation.blocker;
+			return result;
+		}
+	}
+
+	if (result.sourceOwnerId.empty())
+	{
+		result.blocker = "transfer_source_owner_missing";
+		return result;
+	}
+	if (!input.sourceActive)
+	{
+		result.blocker = "transfer_source_inactive";
+		return result;
+	}
+	if (!input.admissionBlocker.empty())
+	{
+		result.blocker = input.admissionBlocker;
+		return result;
+	}
+	if (!ownershipIntegrity)
+	{
+		result.blocker = "ownership_integrity_fail_closed";
+		return result;
+	}
+	if (!input.operationAssignmentsMatch
+		|| !input.squadAssignmentsMatch
+		|| !input.actionAssignmentsMatch
+		|| !input.roleAssignmentsMatch)
+	{
+		result.blocker =
+			"transfer_atomic_revalidation_mismatch";
+		return result;
+	}
+	if (!result.protectedMinimumRespected)
+	{
+		result.blocker =
+			"transfer_source_protected_minimum_invalid";
+		return result;
+	}
+	if (result.requested
+		&& (!input.counterpartPresent
+			|| !input.counterpartPending
+			|| !input.destinationActive))
+	{
+		result.blocker = !input.counterpartPresent
+			? "transfer_counterpart_missing"
+			: (!input.counterpartPending
+				? "transfer_counterpart_not_pending"
+				: "transfer_destination_inactive");
+		return result;
+	}
+	if (result.requested
+		&& (!result.reciprocalAction
+			|| !result.reciprocalCounterpart
+			|| !result.reciprocalGeneration
+			|| !result.reciprocalCount))
+	{
+		result.blocker =
+			"transfer_reciprocal_contract_mismatch";
+		return result;
+	}
+	if (result.requested && input.requestedCount == 0)
+	{
+		result.blocker = "transfer_selection_empty";
+		return result;
+	}
+	if (result.requested
+		&& (selectedTags.size() != input.selectedTags.size()
+			|| selectedTags.size() != input.requestedCount))
+	{
+		result.blocker = "transfer_selection_identity_mismatch";
+		return result;
+	}
+	if (std::find_if(
+			selectedTags.begin(),
+			selectedTags.end(),
+			[&](std::uint64_t tag)
+			{
+				return std::find(
+					sourceTags.begin(),
+					sourceTags.end(),
+					tag) == sourceTags.end();
+			}) != selectedTags.end())
+	{
+		result.blocker = "transfer_selection_not_owned_by_source";
+		return result;
+	}
+	if (result.requested
+		&& (selectedTags.size() > sourceSurplus
+			|| selectedTags.size() > destinationCapacity))
+	{
+		result.blocker =
+			"transfer_capacity_or_source_minimum";
+		return result;
+	}
+	if (prospectiveAvailableCount == 0)
+	{
+		result.blocker = "no_transferable_units";
+		return result;
+	}
+	result.availableCount = prospectiveAvailableCount;
+	result.transferableTags.assign(
+		selectedTags.begin(),
+		selectedTags.begin()
+			+ static_cast<std::ptrdiff_t>(
+				prospectiveAvailableCount));
+	result.atomicRevalidationReady = true;
+	result.transferSafe = true;
+	return result;
+}
+
+inline VoiBattlefieldProjection voiMakeBattlefieldProjection(
+	const VoiBattlefieldProjectionInput & input)
+{
+	VoiBattlefieldProjection result;
+	result.frame = input.frame;
+	result.updateId = input.updateId.empty()
+		? "micromachine-autonomous"
+		: input.updateId;
+	result.scope = input.scope.empty()
+		? "battlefield"
+		: input.scope;
+	result.generation = std::max<std::uint64_t>(
+		1,
+		input.generation);
+	result.stage = input.stage.empty()
+		? "observed"
+		: input.stage;
+	result.ownershipEvidencePresent =
+		input.ownershipEvidencePresent;
+	result.baseEvidencePresent = input.baseEvidencePresent;
+
+	std::set<std::uint64_t> eligibleTags;
+	std::map<std::uint64_t, std::set<std::string>>
+		explicitOwnersByTag;
+	std::map<std::uint64_t, std::set<std::string>>
+		autonomousOwnersByTag;
+	std::map<std::uint64_t, VoiBattlefieldUnitInput>
+		normalizedUnits;
+	for (const auto & unit : input.units)
+	{
+		const auto existing = normalizedUnits.find(unit.tag);
+		if (existing != normalizedUnits.end())
+		{
+			++result.duplicateUnitInputCount;
+			result.duplicateUnitInputTags.push_back(unit.tag);
+			existing->second.explicitOwners.insert(
+				existing->second.explicitOwners.end(),
+				unit.explicitOwners.begin(),
+				unit.explicitOwners.end());
+			existing->second.autonomousOwners.insert(
+				existing->second.autonomousOwners.end(),
+				unit.autonomousOwners.begin(),
+				unit.autonomousOwners.end());
+			continue;
+		}
+		normalizedUnits[unit.tag] = unit;
+	}
+	for (const auto & unitEntry : normalizedUnits)
+	{
+		const auto & unit = unitEntry.second;
+		if (!unit.alive)
+		{
+			++result.excludedDeadCount;
+			result.excludedDeadTags.push_back(unit.tag);
+			continue;
+		}
+		if (!unit.selfOwned)
+		{
+			++result.excludedNonSelfCount;
+			result.excludedNonSelfTags.push_back(unit.tag);
+			continue;
+		}
+		if (!unit.complete)
+		{
+			++result.excludedIncompleteCount;
+			result.excludedIncompleteTags.push_back(
+				unit.tag);
+			continue;
+		}
+		if (unit.worker)
+		{
+			++result.excludedWorkerCount;
+			result.excludedWorkerTags.push_back(unit.tag);
+			continue;
+		}
+		if (unit.structure)
+		{
+			++result.excludedStructureCount;
+			result.excludedStructureTags.push_back(unit.tag);
+			continue;
+		}
+		if (unit.temporaryPayload)
+		{
+			++result.excludedTemporaryPayloadCount;
+			result.excludedTemporaryPayloadTags.push_back(
+				unit.tag);
+			continue;
+		}
+		if (!unit.combat)
+		{
+			++result.excludedNonCombatCount;
+			result.excludedNonCombatTags.push_back(unit.tag);
+			continue;
+		}
+		if (!eligibleTags.insert(unit.tag).second)
+		{
+			continue;
+		}
+		explicitOwnersByTag[unit.tag].insert(
+			unit.explicitOwners.begin(),
+			unit.explicitOwners.end());
+		autonomousOwnersByTag[unit.tag].insert(
+			unit.autonomousOwners.begin(),
+			unit.autonomousOwners.end());
+	}
+	result.eligibleTags.assign(
+		eligibleTags.begin(),
+		eligibleTags.end());
+	result.eligibleCombatCount = eligibleTags.size();
+	const std::set<std::uint64_t> eligibleTagSet =
+		voiBattlefieldEligibleTagSet(result);
+
+	std::map<std::string, std::set<std::uint64_t>>
+		autonomousTagsByOwner;
+	for (const auto tag : eligibleTags)
+	{
+		for (const auto & owner : autonomousOwnersByTag[tag])
+		{
+			if (!owner.empty())
+			{
+				autonomousTagsByOwner[owner].insert(tag);
+			}
+		}
+	}
+	for (const auto & owner : autonomousTagsByOwner)
+	{
+		VoiBattlefieldAutonomousOwnerProjection projected;
+		projected.ownerId = owner.first;
+		projected.ownerTags.assign(
+			owner.second.begin(),
+			owner.second.end());
+		projected.ownerCount = projected.ownerTags.size();
+		projected.integrity = input.ownershipEvidencePresent;
+		result.autonomousOwnedCount += projected.ownerCount;
+		result.autonomousOwners.push_back(projected);
+		result.autonomousOwnedTags.insert(
+			result.autonomousOwnedTags.end(),
+			projected.ownerTags.begin(),
+			projected.ownerTags.end());
+	}
+	std::sort(
+		result.autonomousOwnedTags.begin(),
+		result.autonomousOwnedTags.end());
+	result.autonomousOwnedTags.erase(
+		std::unique(
+			result.autonomousOwnedTags.begin(),
+			result.autonomousOwnedTags.end()),
+		result.autonomousOwnedTags.end());
+
+	bool allOperationOwnershipEvidencePresent = true;
+	std::map<std::string, std::vector<std::uint64_t>>
+		operationOwnerTags;
+	std::set<std::string> knownOperationOwnerKeys;
+	for (const auto & operation : input.operations)
+	{
+		const std::string ownerKey =
+			"operation:" + operation.operationId + "#"
+			+ std::to_string(operation.generation);
+		knownOperationOwnerKeys.insert(ownerKey);
+		std::vector<std::uint64_t> ownerTags;
+		for (const auto tag :
+			voiBattlefieldEligibleUniqueTags(
+				operation.assignedTags,
+				eligibleTagSet))
+		{
+			const auto owners = explicitOwnersByTag.find(tag);
+			if (owners != explicitOwnersByTag.end()
+				&& owners->second.find(ownerKey)
+					!= owners->second.end())
+			{
+				ownerTags.push_back(tag);
+			}
+		}
+		operationOwnerTags[ownerKey] = ownerTags;
+		result.explicitOwnedCount += ownerTags.size();
+		result.explicitOwnedTags.insert(
+			result.explicitOwnedTags.end(),
+			ownerTags.begin(),
+			ownerTags.end());
+		if (operation.active && !operation.completed)
+		{
+			allOperationOwnershipEvidencePresent =
+				allOperationOwnershipEvidencePresent
+				&& operation.ownershipEvidencePresent;
+		}
+	}
+	bool allExplicitOwnersKnown = true;
+	for (const auto & ownerEntry : explicitOwnersByTag)
+	{
+		for (const auto & owner : ownerEntry.second)
+		{
+			if (!owner.empty()
+				&& knownOperationOwnerKeys.find(owner)
+					== knownOperationOwnerKeys.end())
+			{
+				allExplicitOwnersKnown = false;
+			}
+		}
+	}
+	std::sort(
+		result.explicitOwnedTags.begin(),
+		result.explicitOwnedTags.end());
+	result.explicitOwnedTags.erase(
+		std::unique(
+			result.explicitOwnedTags.begin(),
+			result.explicitOwnedTags.end()),
+		result.explicitOwnedTags.end());
+
+	std::map<std::uint64_t, std::size_t> ownerClaimCount;
+	for (const auto & owner : operationOwnerTags)
+	{
+		for (const auto tag : owner.second)
+		{
+			++ownerClaimCount[tag];
+		}
+	}
+	for (const auto & owner : result.autonomousOwners)
+	{
+		for (const auto tag : owner.ownerTags)
+		{
+			++ownerClaimCount[tag];
+		}
+	}
+	for (const auto tag : eligibleTags)
+	{
+		const auto claims = ownerClaimCount.find(tag);
+		if (claims == ownerClaimCount.end()
+			|| claims->second == 0)
+		{
+			result.unassignedTags.push_back(tag);
+			continue;
+		}
+		if (claims->second > 1)
+		{
+			result.duplicateOwnershipTags.push_back(tag);
+			result.duplicateOwnershipCount +=
+				claims->second - 1;
+		}
+	}
+	result.unassignedCount = result.unassignedTags.size();
+	result.ownerCount = ownerClaimCount.size();
+	result.uniqueOwnerTagCount = ownerClaimCount.size();
+	result.ownershipIntegrity =
+		input.ownershipEvidencePresent
+		&& allOperationOwnershipEvidencePresent
+		&& allExplicitOwnersKnown
+		&& result.duplicateUnitInputCount == 0
+		&& result.duplicateOwnershipCount == 0
+		&& result.eligibleCombatCount
+			== result.explicitOwnedCount
+				+ result.autonomousOwnedCount
+				+ result.unassignedCount;
+	result.failClosed = !result.ownershipIntegrity;
+	for (auto & owner : result.autonomousOwners)
+	{
+		owner.integrity =
+			owner.integrity && result.ownershipIntegrity;
+	}
+
+	bool allOccupiedBasesReady = input.baseEvidencePresent;
+	bool allOccupiedBaseEvidencePresent =
+		input.baseEvidencePresent;
+	for (const auto & base : input.bases)
+	{
+		VoiBattlefieldBaseProjection projected;
+		projected.baseId = base.baseId.empty()
+			? "unknown_base"
+			: base.baseId;
+		projected.semanticAnchor =
+			base.semanticAnchor.empty()
+				? "self_base"
+				: base.semanticAnchor;
+		projected.occupied = base.occupied;
+		projected.evidencePresent =
+			base.readinessEvidencePresent
+			&& base.threatEvidencePresent;
+		projected.threatened = base.threatened;
+		projected.threatEvidence =
+			base.threatEvidence.empty()
+				? "missing_evidence"
+				: base.threatEvidence;
+		projected.evidenceClass =
+			base.evidenceClass.empty()
+				? "missing_evidence"
+				: base.evidenceClass;
+		projected.threatFrame = base.threatFrame;
+		projected.groundThreat =
+			std::max(0.0f, base.groundThreat);
+		projected.airThreat =
+			std::max(0.0f, base.airThreat);
+		projected.observedEnemyStrength =
+			std::max(0.0f, base.observedEnemyStrength);
+		projected.defenderCount =
+			voiBattlefieldEligibleUniqueTags(
+				base.defenderTags,
+				eligibleTagSet).size();
+		projected.requiredDefenderCount =
+			base.requiredDefenderCount > 0
+				? base.requiredDefenderCount
+				: base.protectedMinimum;
+		projected.protectedMinimum =
+			base.protectedMinimum;
+		projected.protectedFamily =
+			base.protectedFamily.empty()
+				? "eligible_combat"
+				: base.protectedFamily;
+		projected.protectedRole =
+			base.protectedRole.empty()
+				? "base_defender"
+				: base.protectedRole;
+		projected.ready =
+			!base.occupied
+			|| (projected.evidencePresent
+				&& (!projected.threatened
+					|| projected.defenderCount
+						>= projected.protectedMinimum));
+		projected.readinessState =
+			!projected.evidencePresent
+				? "missing_evidence"
+				: (projected.ready ? "ready" : "unsafe");
+		projected.readinessReason =
+			!projected.evidencePresent
+				? "threat_or_readiness_evidence_missing"
+				: (projected.ready
+					? "protected_minimum_satisfied"
+					: "protected_minimum_not_met");
+		if (base.occupied)
+		{
+			allOccupiedBaseEvidencePresent =
+				allOccupiedBaseEvidencePresent
+				&& projected.evidencePresent;
+			allOccupiedBasesReady =
+				allOccupiedBasesReady
+				&& projected.ready;
+		}
+		result.bases.push_back(projected);
+	}
+
+	std::map<std::string, VoiBattlefieldTransferProjection>
+		transferBySourceOwner;
+	for (const auto & transfer : input.transferAvailability)
+	{
+		const auto projected = voiProjectBattlefieldTransfer(
+			transfer,
+			result.ownershipIntegrity,
+			eligibleTagSet);
+		if (!projected.sourceOwnerId.empty())
+		{
+			transferBySourceOwner[projected.sourceOwnerId] =
+				projected;
+		}
+	}
+	for (const auto & operation : input.operations)
+	{
+		VoiBattlefieldOperationProjection projected;
+		projected.scope = "operation:" + operation.operationId;
+		projected.operationId = operation.operationId;
+		projected.generation = operation.generation;
+		projected.updateId = operation.updateId.empty()
+			? result.updateId
+			: operation.updateId;
+		projected.identityStage =
+			operation.identityStage.empty()
+				? (operation.completed
+					? "terminal"
+					: (operation.engagementObserved
+						|| operation.movementObserved
+							? "effect_observed"
+							: "assigned"))
+				: operation.identityStage;
+		projected.status = operation.status;
+		projected.ownershipEvidencePresent =
+			operation.ownershipEvidencePresent;
+		const std::string ownerKey =
+			"operation:" + operation.operationId + "#"
+			+ std::to_string(operation.generation);
+		projected.ownerTags = operationOwnerTags[ownerKey];
+		projected.assignedCount = projected.ownerTags.size();
+		projected.minimumUnits = operation.minimumUnits;
+		projected.maximumUnits = operation.maximumUnits;
+		projected.allowPartial = operation.allowPartial;
+		projected.strictScope = operation.strictScope;
+		projected.partial =
+			projected.assignedCount > 0
+			&& projected.assignedCount
+				< projected.minimumUnits;
+		projected.requestedRouteType =
+			operation.requestedRouteType.empty()
+				? (operation.routeType.empty()
+					? "direct"
+					: operation.routeType)
+				: operation.requestedRouteType;
+		projected.routeType =
+			operation.routeType.empty()
+				? "direct"
+				: operation.routeType;
+		projected.targetIntent =
+			operation.targetIntent.empty()
+				? "unspecified"
+				: operation.targetIntent;
+		projected.targetType =
+			operation.targetType.empty()
+				? "unknown_target"
+				: operation.targetType;
+		projected.resolvedTargetLabel =
+			operation.resolvedTargetLabel.empty()
+				? projected.targetIntent
+				: operation.resolvedTargetLabel;
+		projected.targetEvidence =
+			operation.targetEvidence.empty()
+				? "missing_evidence"
+				: operation.targetEvidence;
+		projected.targetX = operation.targetX;
+		projected.targetY = operation.targetY;
+		projected.lifetimeMode =
+			operation.lifetimeMode.empty()
+				? "missing_evidence"
+				: operation.lifetimeMode;
+		projected.completionConditions =
+			operation.completionConditions;
+		projected.durationSeconds = operation.durationSeconds;
+		projected.issuedAtFrame = operation.issuedAtFrame;
+		projected.deadlineFrame = operation.deadlineFrame;
+		projected.standing = operation.standing;
+		projected.completed =
+			operation.completed
+			&& voiBattlefieldStandingMayComplete(
+				operation.standing,
+				operation.completionReason);
+		projected.completionReason =
+			projected.completed
+				? operation.completionReason
+				: "";
+		projected.completionFrame =
+			projected.completed
+				? operation.completionFrame
+				: 0;
+		projected.movementObserved =
+			operation.movementObserved;
+		projected.engagementObserved =
+			operation.engagementObserved;
+		projected.targetReached = operation.targetReached;
+		projected.completionState =
+			voiBattlefieldCompletionState(
+				operation.status,
+				projected.completed);
+		projected.transferSelection.identity =
+			operation.transferSelectionIdentity;
+		projected.transferSelection.editResolution =
+			operation.transferSelectionResolution.empty()
+				? operation.transfer.editResolution
+				: operation.transferSelectionResolution;
+		projected.transferSelection.present =
+			!projected.transferSelection.identity
+				.selectedUnitTags.empty();
+		if (projected.transferSelection.present)
+		{
+			const auto identityValidation =
+				voiValidateOperationTransferSelectionRuntimeEvidence(
+					projected.transferSelection.identity,
+					operation
+						.transferSelectionRuntimeEvidence);
+			projected.transferSelection.identityValid =
+				identityValidation.valid;
+			projected.transferSelection.blocker =
+				identityValidation.blocker;
+			projected.transferSelection.writeIdentity.updateId =
+				projected.updateId;
+			projected.transferSelection.writeIdentity.operationId =
+				projected.operationId;
+			projected.transferSelection.writeIdentity
+				.operationGeneration =
+					projected.generation;
+			projected.transferSelection.writeIdentity.stage =
+				projected.identityStage;
+			projected.transferSelection.writeIdentity.gameFrame =
+				input.frame;
+			projected.transferSelection.writeIdentity
+				.selectionIdentity =
+					projected.transferSelection.identity;
+			projected.transferSelection
+				.telemetryWriteAcknowledged =
+					projected.transferSelection.identityValid
+					&& voiOperationTransferSelectionAcknowledgementMatches(
+						projected.transferSelection
+							.writeIdentity,
+						operation
+							.transferSelectionAcknowledgement,
+						input.frame);
+			projected.transferSelection.acknowledgedFrame =
+				projected.transferSelection
+						.telemetryWriteAcknowledged
+					? operation
+						.transferSelectionAcknowledgement
+						.acknowledgedFrame
+					: 0;
+			if (projected.transferSelection
+				.telemetryWriteAcknowledged)
+			{
+					projected.transferSelection
+						.acknowledgedIdentity =
+							operation
+								.transferSelectionAcknowledgement
+							.identity;
+			}
+		}
+		projected.transfer =
+			voiProjectBattlefieldTransfer(
+				operation.transfer,
+				result.ownershipIntegrity,
+				eligibleTagSet);
+		projected.protectedDefenseMinimumRespected =
+			operation.targetType == "defend"
+			|| allOccupiedBasesReady;
+		projected.sourceOperationMinimumRespected =
+			!operation.transfer.requested
+			|| projected.transfer
+				.protectedMinimumRespected;
+		projected.transferAdmission =
+			!operation.transfer.requested
+				? "not_required"
+				: (projected.transfer
+						.atomicRevalidationReady
+					? "accepted"
+					: "blocked");
+		projected.emergencyPreemption =
+			operation.emergencyPreemption.empty()
+				? "none"
+				: operation.emergencyPreemption;
+
+		const bool defendOperation =
+			operation.targetType == "defend";
+		const bool operationEvidencePresent =
+			operation.ownershipEvidencePresent
+			&& !operation.operationId.empty()
+			&& operation.generation > 0
+			&& !operation.targetEvidence.empty()
+			&& operation.targetEvidence
+				!= "missing_evidence"
+			&& !operation.lifetimeMode.empty()
+			&& operation.lifetimeMode
+				!= "missing_evidence";
+		const bool baseEvidenceRequired =
+			!defendOperation;
+		projected.partialLaunchAllowed =
+			!projected.partial
+			|| (operation.allowPartial
+				&& !operation.strictScope
+			&& result.ownershipIntegrity
+			&& projected.protectedDefenseMinimumRespected
+			&& projected.sourceOperationMinimumRespected
+			&& projected.transferAdmission != "blocked"
+			&& projected.emergencyPreemption == "none");
+		projected.partialLaunchSafe =
+			projected.partialLaunchAllowed
+			&& operationEvidencePresent
+			&& result.ownershipIntegrity
+			&& projected.protectedDefenseMinimumRespected
+			&& projected.sourceOperationMinimumRespected
+			&& projected.transferAdmission != "blocked"
+			&& projected.emergencyPreemption == "none"
+			&& (!baseEvidenceRequired
+				|| allOccupiedBaseEvidencePresent);
+
+		if (input.ownershipEvidencePresent
+			&& !result.ownershipIntegrity)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				result.duplicateOwnershipCount > 0
+					? "duplicate_ownership_fail_closed"
+					: "ownership_partition_fail_closed";
+		}
+		else if (!input.ownershipEvidencePresent
+			|| !operationEvidencePresent
+			|| (baseEvidenceRequired
+				&& !allOccupiedBaseEvidencePresent))
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::MissingEvidence;
+			projected.launchReason =
+				!input.ownershipEvidencePresent
+					? "ownership_evidence_missing"
+					: (!operationEvidencePresent
+						? "operation_evidence_missing"
+						: "base_readiness_evidence_missing");
+		}
+		else if (!operation.active || projected.completed)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				"operation_not_active";
+		}
+		else if (!projected
+			.protectedDefenseMinimumRespected)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				"base_protected_minimum_not_met";
+		}
+		else if (projected.assignedCount == 0)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				"no_eligible_units_assigned";
+		}
+		else if (projected.minimumUnits
+			> projected.maximumUnits)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				"operation_bounds_invalid";
+		}
+		else if (projected.maximumUnits > 0
+			&& projected.assignedCount
+				> projected.maximumUnits)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				"operation_maximum_exceeded";
+		}
+		else if (projected.partial
+			&& !projected.partialLaunchSafe)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				operation.allowPartial
+					? "partial_launch_unsafe"
+					: "operation_minimum_not_met";
+		}
+		else if (operation.transfer.requested
+			&& !projected.transfer
+				.atomicRevalidationReady)
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Unsafe;
+			projected.launchReason =
+				projected.transfer.blocker;
+		}
+		else
+		{
+			projected.launchState =
+				VoiBattlefieldDecisionState::Safe;
+			projected.launchReason =
+				projected.partial
+					? "partial_launch_safe"
+					: "full_launch_safe";
+		}
+		result.operations.push_back(projected);
+
+		if (!projected.transfer.sourceOwnerId.empty())
+		{
+			const auto existing = transferBySourceOwner.find(
+				projected.transfer.sourceOwnerId);
+			if (existing == transferBySourceOwner.end()
+				|| projected.transfer.requested)
+			{
+				transferBySourceOwner[
+					projected.transfer.sourceOwnerId] =
+						projected.transfer;
+			}
+		}
+	}
+	for (const auto & transfer : transferBySourceOwner)
+	{
+		result.transfers.push_back(transfer.second);
+	}
+	return result;
+}
+
+inline void voiBattlefieldWriteTagArray(
+	std::ostringstream & output,
+	const std::vector<std::uint64_t> & tags)
+{
+	output << "[";
+	for (std::size_t index = 0; index < tags.size(); ++index)
+	{
+		if (index > 0)
+		{
+			output << ",";
+		}
+		output << tags[index];
+	}
+	output << "]";
+}
+
+inline void voiBattlefieldWriteStringArray(
+	std::ostringstream & output,
+	const std::vector<std::string> & values)
+{
+	output << "[";
+	for (std::size_t index = 0; index < values.size(); ++index)
+	{
+		if (index > 0)
+		{
+			output << ",";
+		}
+		output << "\""
+			<< voiBattlefieldJsonEscape(values[index])
+			<< "\"";
+	}
+	output << "]";
+}
+
+inline void voiBattlefieldWriteTransferSelectionIdentity(
+	std::ostringstream & output,
+	const VoiOperationTransferSelectionIdentity<std::uint64_t>
+		& identity)
+{
+	output << "{"
+		<< "\"update_id\":\""
+		<< voiBattlefieldJsonEscape(
+			identity.updateId)
+		<< "\",\"source_owner_id\":\""
+		<< voiBattlefieldJsonEscape(
+			identity.sourceOperationId)
+		<< "\",\"counterpart_operation_id\":\""
+		<< voiBattlefieldJsonEscape(
+			identity.counterpartOperationId)
+		<< "\",\"source_action\":\""
+		<< voiBattlefieldJsonEscape(
+			identity.sourceAction)
+		<< "\",\"counterpart_action\":\""
+		<< voiBattlefieldJsonEscape(
+			identity.counterpartAction)
+		<< "\",\"source_generation\":"
+		<< identity.sourceGeneration
+		<< ",\"counterpart_generation\":"
+		<< identity.counterpartGeneration
+		<< ",\"requested_source_generation\":"
+		<< identity.requestedSourceGeneration
+		<< ",\"requested_counterpart_generation\":"
+		<< identity.requestedCounterpartGeneration
+		<< ",\"requested_count\":"
+		<< identity.requestedCount
+		<< ",\"selected_unit_tags\":";
+	voiBattlefieldWriteTagArray(
+		output,
+		identity.selectedUnitTags);
+	output << "}";
+}
+
+inline void voiBattlefieldWriteTransferSelectionWriteIdentity(
+	std::ostringstream & output,
+	const VoiOperationTransferSelectionWriteIdentity<std::uint64_t>
+		& identity)
+{
+	output << "{"
+		<< "\"update_id\":\""
+		<< voiBattlefieldJsonEscape(identity.updateId)
+		<< "\",\"operation_id\":\""
+		<< voiBattlefieldJsonEscape(identity.operationId)
+		<< "\",\"operation_generation\":"
+		<< identity.operationGeneration
+		<< ",\"stage\":\""
+		<< voiBattlefieldJsonEscape(identity.stage)
+		<< "\",\"game_frame\":"
+		<< identity.gameFrame
+		<< ",\"selection_identity\":";
+	voiBattlefieldWriteTransferSelectionIdentity(
+		output,
+		identity.selectionIdentity);
+	output << "}";
+}
