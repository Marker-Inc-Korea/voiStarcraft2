+			<< base.defenderCount
+			<< ",\"required_defender_count\":"
+			<< base.requiredDefenderCount
+			<< ",\"protected_minimum\":[{"
+			<< "\"family\":\""
+			<< voiBattlefieldJsonEscape(
+				base.protectedFamily)
+			<< "\",\"role\":\""
+			<< voiBattlefieldJsonEscape(
+				base.protectedRole)
+			<< "\",\"count\":"
+			<< base.protectedMinimum
+			<< "}]}}";
+	}
+	output << "],\"transfer_availability\":{"
+		<< "\"evaluated_at_frame\":"
+		<< projection.frame
+		<< ",\"atomic_revalidation_required\":true,"
+		<< "\"entries\":[";
+	for (std::size_t index = 0;
+		index < projection.transfers.size();
+		++index)
+	{
+		if (index > 0)
+		{
+			output << ",";
+		}
+		const auto & transfer = projection.transfers[index];
+		output << "{\"source_owner_id\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.sourceOwnerId)
+			<< "\",\"source_owner_count\":"
+			<< transfer.sourceOwnerCount
+			<< ",\"protected_minimum\":"
+			<< transfer.protectedMinimum
+			<< ",\"transferable_count\":"
+			<< transfer.transferableTags.size()
+			<< ",\"transferable_unit_tags\":";
+		voiBattlefieldWriteTagArray(
+			output,
+			transfer.transferableTags);
+		output << ",\"transfer_safe\":"
+			<< (transfer.transferSafe
+				? "true"
+				: "false")
+			<< ",\"atomic_runtime_blocker\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.blocker)
+			<< "\",\"recommended_resolution_choices\":[],"
+			<< "\"safety_evidence\":{"
+			<< "\"evaluated_at_frame\":"
+			<< projection.frame
+			<< ",\"protected_minimum_respected\":"
+			<< (transfer.protectedMinimumRespected
+				? "true"
+				: "false")
+			<< ",\"atomic_revalidation_required\":true},"
+			<< "\"atomic_revalidation_inputs\":{"
+			<< "\"requested\":"
+			<< (transfer.requested ? "true" : "false")
+			<< ",\"selected_unit_tags\":";
+		voiBattlefieldWriteTagArray(
+			output,
+			transfer.transferableTags);
+		output << ",\"source_owner_id\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.sourceOwnerId)
+			<< "\",\"action\":\""
+			<< voiBattlefieldJsonEscape(transfer.action)
+			<< "\",\"edit_resolution\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.editResolution)
+			<< "\",\"counterpart_operation_id\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.counterpartOperationId)
+			<< "\",\"counterpart_action\":\""
+			<< voiBattlefieldJsonEscape(
+				transfer.counterpartAction)
+			<< "\",\"requested_generation\":"
+			<< transfer.requestedGeneration
+			<< ",\"counterpart_generation\":"
+			<< transfer.counterpartGeneration
+			<< ",\"requested_source_generation\":"
+			<< transfer.requestedSourceGeneration
+			<< ",\"requested_counterpart_generation\":"
+			<< transfer.requestedCounterpartGeneration
+			<< ",\"requested_count\":"
+			<< transfer.requestedCount
+			<< ",\"counterpart_present\":"
+			<< (transfer.counterpartPresent
+				? "true"
+				: "false")
+			<< ",\"counterpart_pending\":"
+			<< (transfer.counterpartPending
+				? "true"
+				: "false")
+			<< ",\"reciprocal_action\":"
+			<< (transfer.reciprocalAction
+				? "true"
+				: "false")
+			<< ",\"reciprocal_counterpart\":"
+			<< (transfer.reciprocalCounterpart
+				? "true"
+				: "false")
+			<< ",\"reciprocal_generation\":"
+			<< (transfer.reciprocalGeneration
+				? "true"
+				: "false")
+			<< ",\"reciprocal_count\":"
+			<< (transfer.reciprocalCount
+				? "true"
+				: "false")
+			<< ",\"source_active\":"
+			<< (transfer.sourceActive
+				? "true"
+				: "false")
+			<< ",\"destination_active\":"
+			<< (transfer.destinationActive
+				? "true"
+				: "false")
+			<< ",\"ownership_integrity\":"
+			<< (transfer.ownershipIntegrity
+				? "true"
+				: "false")
+			<< ",\"operation_assignments_match\":"
+			<< (transfer.operationAssignmentsMatch
+				? "true"
+				: "false")
+			<< ",\"squad_assignments_match\":"
