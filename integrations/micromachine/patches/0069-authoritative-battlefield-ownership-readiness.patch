+				? "true"
+				: "false")
+			<< ",\"partial_launch_safe\":"
+			<< (operation.partialLaunchSafe
+				? "true"
+				: "false")
+			<< ",\"launch_count\":"
+			<< operation.assignedCount
+			<< ",\"missing_count\":"
+			<< missingCount
+			<< ",\"decision\":\""
+				<< (operation.launchState
+						== VoiBattlefieldDecisionState::Safe
+					? "launch"
+					: "wait")
+			<< "\",\"blocker\":\"";
+		if (operation.launchState
+			!= VoiBattlefieldDecisionState::Safe)
+		{
+			output << voiBattlefieldJsonEscape(
+				operation.launchReason);
+		}
+		output << "\",\"recommended_choices\":[],"
+			<< "\"safety_evidence\":{"
+			<< "\"evaluated_at_frame\":"
+			<< projection.frame
+			<< ",\"protected_defense_minimum_respected\":"
