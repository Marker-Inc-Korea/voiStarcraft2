+			<< voiBattlefieldJsonEscape(
+				operation.routeType)
+			<< "\",\"location_intent\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.targetIntent)
+			<< "\",\"target_type\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.targetType)
+			<< "\",\"resolved_target_label\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.resolvedTargetLabel)
+			<< "\",\"target_x\":" << operation.targetX
+			<< ",\"target_y\":" << operation.targetY
+			<< ",\"target_evidence\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.targetEvidence)
+			<< "\"},\"operation_lifetime\":{"
+			<< "\"mode\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.lifetimeMode)
+			<< "\",\"completion_state\":\""
+			<< voiBattlefieldJsonEscape(
+				operation.completionState)
+			<< "\",\"completion_conditions\":";
+		voiBattlefieldWriteStringArray(
+			output,
+			voiBattlefieldSplitCommaList(
+				operation.completionConditions));
+		output << ",\"duration_seconds\":"
+			<< operation.durationSeconds
+			<< ",\"issued_at_frame\":"
+			<< operation.issuedAtFrame
