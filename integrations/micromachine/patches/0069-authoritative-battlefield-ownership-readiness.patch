+			"emergency.cancel_attacks",
+			false);
+	for (const auto & operation : m_voiOperations)
+	{
+		const bool operationSnapshotValid =
+			operationAssignmentsMatch(operation);
+		const bool squadSnapshotValid =
+			squadAssignmentsMatch(operation);
+		const bool actionSnapshotValid =
+			actionAssignmentsMatch(operation);
+		const bool roleSnapshotValid =
+			roleAssignmentsMatch(operation);
+
+		VoiBattlefieldOperationInput projectedOperation;
+		projectedOperation.scope =
+			operation.commandLayer.empty()
