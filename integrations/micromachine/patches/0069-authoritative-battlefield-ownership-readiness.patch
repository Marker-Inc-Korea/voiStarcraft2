+	auto autonomous = combatUnit(21);
+	autonomous.autonomousOwners = { "squad:BaseDefense:main" };
+	auto unassigned = combatUnit(31);
+	input.units = { assault, defense, autonomous, unassigned };
+	input.bases = { readyBase() };
+	input.operations = {
+		operation("assault-alpha", 4, { 11 }),
+		operation("defense-bravo", 2, { 12 }),
+	};
+	input.operations[1].targetType = "defend";
+	input.operations[1].minimumUnits = 1;
