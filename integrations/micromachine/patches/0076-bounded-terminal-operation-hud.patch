diff --git a/src/voi_operation_hud_selection.hpp b/src/voi_operation_hud_selection.hpp
new file mode 100644
index 0000000..2c14311
--- /dev/null
+++ b/src/voi_operation_hud_selection.hpp
@@ -0,0 +1,120 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+constexpr std::size_t VoiOperationHudMaxRows = 8;
+constexpr std::uint64_t VoiOperationHudTerminalGraceFrames = 110;
+
+struct VoiOperationHudCandidate
+{
+	std::size_t sourceIndex = 0;
+	std::string operationId;
+	std::uint64_t generation = 0;
+	std::uint64_t canonicalFrame = 0;
+	bool terminal = false;
+	bool terminalFramePresent = false;
+	std::uint64_t terminalFrame = 0;
+};
+
+struct VoiOperationHudSelection
+{
+	std::vector<std::size_t> operationIndices;
+	std::size_t hiddenCount = 0;
+};
+
+inline std::uint64_t voiOperationHudLatchTerminalFrame(
+	bool wasTerminal,
+	std::uint64_t terminalFrame,
+	std::uint64_t currentFrame)
+{
+	return wasTerminal ? terminalFrame : currentFrame;
+}
+
+inline bool voiOperationHudRetainTerminalHistory(bool terminal)
+{
+	return terminal;
+}
+
+inline bool voiOperationHudTerminalEligible(
+	const VoiOperationHudCandidate & candidate,
+	std::uint64_t currentFrame)
+{
+	if (!candidate.terminal)
+	{
+		return true;
+	}
+	if (!candidate.terminalFramePresent
+		|| candidate.terminalFrame == 0
+		|| candidate.terminalFrame < candidate.canonicalFrame
+		|| candidate.terminalFrame > currentFrame)
+	{
+		return false;
+	}
+	return currentFrame - candidate.terminalFrame
+		< VoiOperationHudTerminalGraceFrames;
+}
+
+inline VoiOperationHudSelection voiSelectOperationHud(
+	const std::vector<VoiOperationHudCandidate> & candidates,
+	std::uint64_t currentFrame)
+{
+	std::vector<VoiOperationHudCandidate> eligible;
+	eligible.reserve(candidates.size());
+	for (const auto & candidate : candidates)
+	{
+		if (voiOperationHudTerminalEligible(candidate, currentFrame))
+		{
+			eligible.push_back(candidate);
+		}
+	}
+	std::sort(
+		eligible.begin(),
+		eligible.end(),
+		[](const VoiOperationHudCandidate & left,
+			const VoiOperationHudCandidate & right)
+		{
+			if (left.terminal != right.terminal)
+			{
+				return !left.terminal;
+			}
+			if (left.canonicalFrame != right.canonicalFrame)
+			{
+				return left.canonicalFrame < right.canonicalFrame;
+			}
+			if (left.operationId != right.operationId)
+			{
+				return left.operationId < right.operationId;
+			}
+			if (left.generation != right.generation)
+			{
+				return left.generation < right.generation;
+			}
+			return left.sourceIndex < right.sourceIndex;
+		});
+
+	VoiOperationHudSelection selection;
+	const std::size_t visibleCount =
+		std::min(VoiOperationHudMaxRows, eligible.size());
+	selection.operationIndices.reserve(visibleCount);
+	for (std::size_t index = 0; index < visibleCount; ++index)
+	{
+		selection.operationIndices.push_back(
+			eligible[index].sourceIndex);
+	}
+	selection.hiddenCount = eligible.size() - visibleCount;
+	return selection;
+}
+
+inline bool voiOperationHudMarkerVisible(
+	const VoiOperationHudSelection & selection,
+	std::size_t sourceIndex)
+{
+	return std::find(
+		selection.operationIndices.begin(),
+		selection.operationIndices.end(),
+		sourceIndex) != selection.operationIndices.end();
+}
