diff --git a/tests/operation_hud_selection_test.cpp b/tests/operation_hud_selection_test.cpp
new file mode 100644
index 0000000..619bcc3
--- /dev/null
+++ b/tests/operation_hud_selection_test.cpp
@@ -0,0 +1,253 @@
+#include "voi_operation_hud_selection.hpp"
+
+#include <algorithm>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+int failures = 0;
+
+#define CHECK(condition)                                                     \
+	do                                                                       \
+	{                                                                        \
+		if (!(condition))                                                     \
+		{                                                                    \
+			std::cerr << __FILE__ << ":" << __LINE__                         \
+				<< ": CHECK failed: " #condition << "\n";                    \
+			++failures;                                                       \
+		}                                                                    \
+	} while (false)
+
+VoiOperationHudCandidate candidate(
+	std::size_t sourceIndex,
+	const std::string & operationId,
+	std::uint64_t generation,
+	std::uint64_t canonicalFrame,
+	bool terminal = false,
+	std::uint64_t terminalFrame = 0,
+	bool terminalFramePresent = false)
+{
+	VoiOperationHudCandidate result;
+	result.sourceIndex = sourceIndex;
+	result.operationId = operationId;
+	result.generation = generation;
+	result.canonicalFrame = canonicalFrame;
+	result.terminal = terminal;
+	result.terminalFrame = terminalFrame;
+	result.terminalFramePresent = terminalFramePresent;
+	return result;
+}
+
+std::string fingerprint(
+	const std::vector<VoiOperationHudCandidate> & candidates)
+{
+	std::ostringstream output;
+	for (const auto & value : candidates)
+	{
+		output << value.sourceIndex << "|"
+			<< value.operationId << "|"
+			<< value.generation << "|"
+			<< value.canonicalFrame << "|"
+			<< value.terminal << "|"
+			<< value.terminalFramePresent << "|"
+			<< value.terminalFrame << "\n";
+	}
+	return output.str();
+}
+
+void testThirtyTwoOperationCap()
+{
+	std::vector<VoiOperationHudCandidate> candidates;
+	for (std::size_t index = 0; index < 32; ++index)
+	{
+		candidates.push_back(candidate(
+			index,
+			"operation-" + std::to_string(index),
+			1,
+			100 + index));
+	}
+	std::reverse(candidates.begin(), candidates.end());
+	const auto selection = voiSelectOperationHud(candidates, 500);
+	CHECK(selection.operationIndices.size() == VoiOperationHudMaxRows);
+	CHECK(selection.hiddenCount == 24);
+	for (std::size_t index = 0;
+		index < selection.operationIndices.size();
+		++index)
+	{
+		CHECK(selection.operationIndices[index] == index);
+	}
+}
+
+void testActiveOperationsPrecedeTerminalHistory()
+{
+	std::vector<VoiOperationHudCandidate> candidates;
+	for (std::size_t index = 0; index < 10; ++index)
+	{
+		candidates.push_back(candidate(
+			100 + index,
+			"active-" + std::to_string(index),
+			1,
+			200 + index));
+		candidates.push_back(candidate(
+			index,
+			"terminal-" + std::to_string(index),
+			1,
+			10 + index,
+			true,
+			490,
+			true));
+	}
+	const auto selection = voiSelectOperationHud(candidates, 500);
+	CHECK(selection.operationIndices.size() == 8);
+	CHECK(selection.hiddenCount == 12);
+	for (std::size_t index = 0;
+		index < selection.operationIndices.size();
+		++index)
+	{
+		CHECK(selection.operationIndices[index] == 100 + index);
+	}
+}
+
+void testSameFrameTieBreak()
+{
+	const std::vector<VoiOperationHudCandidate> candidates = {
+		candidate(30, "bravo", 1, 100),
+		candidate(20, "alpha", 2, 100),
+		candidate(10, "alpha", 1, 100),
+		candidate(40, "alpha", 1, 101),
+	};
+	const auto selection = voiSelectOperationHud(candidates, 500);
+	const std::vector<std::size_t> expected = { 10, 20, 30, 40 };
+	CHECK(selection.operationIndices == expected);
+	CHECK(selection.hiddenCount == 0);
+}
+
+void testInvalidTerminalFramesFailClosed()
+{
+	const std::vector<VoiOperationHudCandidate> candidates = {
+		candidate(1, "zero", 1, 100, true, 0, true),
+		candidate(2, "missing", 1, 100, true, 150, false),
+		candidate(3, "future", 1, 100, true, 501, true),
+		candidate(4, "regressive", 1, 200, true, 199, true),
+		candidate(5, "valid", 1, 100, true, 450, true),
+	};
+	const auto selection = voiSelectOperationHud(candidates, 500);
+	CHECK(selection.operationIndices
+		== std::vector<std::size_t>({ 5 }));
+	CHECK(selection.hiddenCount == 0);
+}
+
+void testTerminalGraceBoundary()
+{
+	const std::vector<VoiOperationHudCandidate> candidates = {
+		candidate(1, "terminal", 1, 10, true, 100, true),
+	};
+	CHECK(voiSelectOperationHud(candidates, 209)
+		.operationIndices.size() == 1);
+	CHECK(voiSelectOperationHud(candidates, 210)
+		.operationIndices.empty());
+	CHECK(voiSelectOperationHud(candidates, 211)
+		.operationIndices.empty());
+}
+
+void testTerminalFrameLatchesOnFirstTransition()
+{
+	CHECK(voiOperationHudLatchTerminalFrame(
+		false,
+		0,
+		400) == 400);
+	CHECK(voiOperationHudLatchTerminalFrame(
+		true,
+		400,
+		401) == 400);
+	CHECK(voiOperationHudLatchTerminalFrame(
+		true,
+		0,
+		401) == 0);
+}
+
+void testPolicyOmissionRetainsOnlyTerminalHistory()
+{
+	CHECK(voiOperationHudRetainTerminalHistory(true));
+	CHECK(!voiOperationHudRetainTerminalHistory(false));
+}
+
+void testHiddenCountBoundaryAndAgedOutExclusion()
+{
+	std::vector<VoiOperationHudCandidate> candidates;
+	for (std::size_t index = 0; index < 8; ++index)
+	{
+		candidates.push_back(candidate(
+			index,
+			"active-" + std::to_string(index),
+			1,
+			index));
+	}
+	CHECK(voiSelectOperationHud(candidates, 500).hiddenCount == 0);
+	candidates.push_back(candidate(8, "active-8", 1, 8));
+	CHECK(voiSelectOperationHud(candidates, 500).hiddenCount == 1);
+	candidates.push_back(candidate(
+		9,
+		"aged-terminal",
+		1,
+		1,
+		true,
+		300,
+		true));
+	CHECK(voiSelectOperationHud(candidates, 500).hiddenCount == 1);
+}
+
+void testMarkerEligibilityUsesSelection()
+{
+	std::vector<VoiOperationHudCandidate> candidates;
+	for (std::size_t index = 0; index < 9; ++index)
+	{
+		candidates.push_back(candidate(
+			index,
+			"active-" + std::to_string(index),
+			1,
+			index));
+	}
+	const auto selection = voiSelectOperationHud(candidates, 500);
+	CHECK(voiOperationHudMarkerVisible(selection, 0));
+	CHECK(voiOperationHudMarkerVisible(selection, 7));
+	CHECK(!voiOperationHudMarkerVisible(selection, 8));
+
+	const auto aged = voiSelectOperationHud(
+		{ candidate(20, "aged", 1, 1, true, 300, true) },
+		500);
+	CHECK(!voiOperationHudMarkerVisible(aged, 20));
+}
+
+void testSelectionDoesNotMutateCanonicalState()
+{
+	std::vector<VoiOperationHudCandidate> candidates = {
+		candidate(3, "charlie", 3, 30),
+		candidate(1, "alpha", 1, 10),
+		candidate(2, "bravo", 2, 20, true, 25, true),
+	};
+	const std::string before = fingerprint(candidates);
+	const auto selection = voiSelectOperationHud(candidates, 30);
+	CHECK(fingerprint(candidates) == before);
+	CHECK(selection.operationIndices
+		== std::vector<std::size_t>({ 1, 3, 2 }));
+}
+}
+
+int main()
+{
+	testThirtyTwoOperationCap();
+	testActiveOperationsPrecedeTerminalHistory();
+	testSameFrameTieBreak();
+	testInvalidTerminalFramesFailClosed();
+	testTerminalGraceBoundary();
+	testTerminalFrameLatchesOnFirstTransition();
+	testPolicyOmissionRetainsOnlyTerminalHistory();
+	testHiddenCountBoundaryAndAgedOutExclusion();
+	testMarkerEligibilityUsesSelection();
+	testSelectionDoesNotMutateCanonicalState();
+	return failures == 0 ? 0 : 1;
+}
