 voiAllocateOperationProductionProgress(
 	int targetCount,
diff --git a/tests/runtime_convergence_test.cpp b/tests/runtime_convergence_test.cpp
index a593e8f..b78b1a3 100644
--- a/tests/runtime_convergence_test.cpp
+++ b/tests/runtime_convergence_test.cpp
@@ -7,6 +7,53 @@
 
 int main()
 {
+	VoiOperationDeadlineInput exactUntilCompleted;
+	exactUntilCompleted.lifetimeMode = "until_completed";
+	exactUntilCompleted.issuedAtFrame = 2508;
+	exactUntilCompleted.durationSeconds = 300;
+	exactUntilCompleted.exactComposition = true;
+	assert(voiOperationDeadlineFrame(exactUntilCompleted) == 0);
+	assert(!voiOperationDeadlineExpired(
+		50000,
+		0,
+		exactUntilCompleted));
+
+	exactUntilCompleted.submittedFrame = 9000;
+	assert(voiOperationDeadlineFrame(exactUntilCompleted) == 15600);
+	assert(!voiOperationDeadlineExpired(
+		15600,
+		0,
+		exactUntilCompleted));
+	assert(voiOperationDeadlineExpired(
+		15601,
+		0,
+		exactUntilCompleted));
+	assert(
+		voiLatchOperationDeadlineFrame(
+			15500,
+			exactUntilCompleted) == 15500);
+
+	VoiOperationDeadlineInput ordinaryUntilCompleted =
+		exactUntilCompleted;
+	ordinaryUntilCompleted.exactComposition = false;
+	ordinaryUntilCompleted.submittedFrame = 12000;
+	assert(
+		voiOperationDeadlineFrame(
+			ordinaryUntilCompleted) == 9108);
+	assert(!voiOperationDeadlineExpired(
+		9108,
+		0,
+		ordinaryUntilCompleted));
+	assert(voiOperationDeadlineExpired(
+		9109,
+		0,
+		ordinaryUntilCompleted));
+
+	VoiOperationDeadlineInput standing = exactUntilCompleted;
+	standing.standing = true;
+	assert(voiOperationDeadlineFrame(standing) == 0);
+	assert(!voiOperationDeadlineExpired(999999, 0, standing));
+
 	VoiRuntimeRequirementSnapshot tank;
 	tank.unitType = "TERRAN_SIEGETANK";
 	tank.role = "siege";
