diff --git a/src/voi_runtime_convergence.hpp b/src/voi_runtime_convergence.hpp
index 53dcf72..5656659 100644
--- a/src/voi_runtime_convergence.hpp
+++ b/src/voi_runtime_convergence.hpp
@@ -53,6 +53,61 @@ struct VoiRuntimeProductionAllocation
 	int representedCount = 0;
 };
 
+struct VoiOperationDeadlineInput
+{
+	std::string lifetimeMode;
+	std::uint64_t issuedAtFrame = 0;
+	std::uint64_t submittedFrame = 0;
+	int durationSeconds = 0;
+	bool standing = false;
+	bool exactComposition = false;
+};
+
+inline std::uint64_t voiOperationDeadlineFrame(
+	const VoiOperationDeadlineInput & input)
+{
+	if (input.standing || input.durationSeconds <= 0)
+	{
+		return 0;
+	}
+	const bool startsAtSubmission =
+		input.lifetimeMode == "until_completed"
+		&& input.exactComposition;
+	if (startsAtSubmission && input.submittedFrame == 0)
+	{
+		return 0;
+	}
+	const std::uint64_t startFrame =
+		startsAtSubmission
+			? input.submittedFrame
+			: input.issuedAtFrame;
+	return startFrame
+		+ static_cast<std::uint64_t>(
+			input.durationSeconds) * 22u;
+}
+
+inline std::uint64_t voiLatchOperationDeadlineFrame(
+	std::uint64_t currentDeadlineFrame,
+	const VoiOperationDeadlineInput & input)
+{
+	return currentDeadlineFrame > 0
+		? currentDeadlineFrame
+		: voiOperationDeadlineFrame(input);
+}
+
+inline bool voiOperationDeadlineExpired(
+	std::uint64_t currentFrame,
+	std::uint64_t deadlineFrame,
+	const VoiOperationDeadlineInput & input)
+{
+	const std::uint64_t effectiveDeadline =
+		voiLatchOperationDeadlineFrame(
+			deadlineFrame,
+			input);
+	return effectiveDeadline > 0
+		&& currentFrame > effectiveDeadline;
+}
