new file mode 100644
--- /dev/null
+++ b/src/voi_runtime_identity.hpp
@@ -0,0 +1,159 @@
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+
+#if defined(_WIN32)
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+
+struct VoiRuntimeInstanceIdentity
+{
+	std::string value;
+	bool valid = false;
+	std::string status = "missing";
+};
+
+inline bool voiRuntimeInstanceIdentityCharacterAllowed(char value)
+{
+	return (value >= 'a' && value <= 'f')
+		|| (value >= '0' && value <= '9');
+}
+
+inline VoiRuntimeInstanceIdentity voiParseRuntimeInstanceIdentity(
+	const char * value)
+{
+	VoiRuntimeInstanceIdentity result;
+	if (value == nullptr || value[0] == '\0')
+	{
+		return result;
+	}
+
+	constexpr std::size_t RequiredLength = 32;
+	for (std::size_t index = 0;
+		index < RequiredLength;
+		++index)
+	{
+		const char character = value[index];
+		if (!voiRuntimeInstanceIdentityCharacterAllowed(
+			character))
+		{
+			result.status = "invalid";
+			return result;
+		}
+	}
+	if (value[RequiredLength] != '\0')
+	{
+		result.status = "invalid";
+		return result;
+	}
+
+	result.value.assign(value, RequiredLength);
+	result.valid = true;
+	result.status = "valid";
+	return result;
+}
+
+inline const VoiRuntimeInstanceIdentity &
+voiRuntimeInstanceIdentityFromEnvironment()
+{
+	static const VoiRuntimeInstanceIdentity identity =
+		voiParseRuntimeInstanceIdentity(
+			std::getenv(
+				"VOI_MICROMACHINE_RUNTIME_INSTANCE_ID"));
+	return identity;
+}
+
+inline std::string voiRuntimeInstanceTelemetryJsonFields(
+	const VoiRuntimeInstanceIdentity & identity)
+{
+	std::ostringstream output;
+	output << "\"runtime_instance_id\":\""
+		<< (identity.valid ? identity.value : "")
+		<< "\",\"runtime_instance_id_valid\":"
+		<< (identity.valid ? "true" : "false")
+		<< ",\"runtime_instance_id_status\":\""
+		<< identity.status
+		<< "\"";
+	return output.str();
+}
+
+inline std::uint64_t voiMixBattlefieldSessionComponent(
+	std::uint64_t value)
+{
+	value += 0x9e3779b97f4a7c15ULL;
+	value = (value ^ (value >> 30))
+		* 0xbf58476d1ce4e5b9ULL;
+	value = (value ^ (value >> 27))
+		* 0x94d049bb133111ebULL;
+	return value ^ (value >> 31);
+}
+
+inline std::uint64_t voiComposeBattlefieldSessionIdentity(
+	std::uint64_t wallClockNanoseconds,
+	std::uint64_t processId,
+	std::uint64_t processNonce)
+{
+	std::uint64_t value =
+		voiMixBattlefieldSessionComponent(
+			wallClockNanoseconds);
+	value = voiMixBattlefieldSessionComponent(
+		value ^ processId);
+	value = voiMixBattlefieldSessionComponent(
+		value ^ processNonce);
+	return value == 0 ? 1 : value;
+}
+
+inline std::uint64_t voiCurrentBattlefieldProcessId()
+{
+#if defined(_WIN32)
+	return static_cast<std::uint64_t>(_getpid());
+#else
+	return static_cast<std::uint64_t>(getpid());
+#endif
+}
+
+inline std::uint64_t voiCurrentBattlefieldSessionEpoch()
+{
+	static int processAnchor = 0;
+	static const std::uint64_t processIdentity = []()
+	{
+		const auto wallClockTicks =
+			std::chrono::duration_cast<
+				std::chrono::nanoseconds>(
+				std::chrono::system_clock::now()
+					.time_since_epoch())
+				.count();
+		const auto monotonicTicks =
+			std::chrono::duration_cast<
+				std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now()
+					.time_since_epoch())
+				.count();
+		const std::uint64_t wallClock =
+			wallClockTicks > 0
+				? static_cast<std::uint64_t>(
+					wallClockTicks)
+				: 1;
+		const std::uint64_t monotonic =
+			monotonicTicks > 0
+				? static_cast<std::uint64_t>(
+					monotonicTicks)
+				: 1;
+		const std::uint64_t addressNonce =
+			static_cast<std::uint64_t>(
+				reinterpret_cast<std::uintptr_t>(
+					&processAnchor));
+		return voiComposeBattlefieldSessionIdentity(
+			wallClock,
+			voiCurrentBattlefieldProcessId(),
+			monotonic ^ addressNonce);
+	}();
+	return processIdentity;
+}
