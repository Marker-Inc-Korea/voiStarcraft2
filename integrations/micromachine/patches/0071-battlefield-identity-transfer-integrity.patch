+
+struct VoiBattlefieldTransferMutationValidation
+{
+	bool valid = false;
+	std::string blocker;
+};
+
+inline VoiBattlefieldTransferMutationValidation
+voiValidateBattlefieldTransferMutation(
+	const VoiBattlefieldProjection & projection,
+	const std::string & sourceOperationId,
+	std::uint64_t sourceGeneration,
+	const std::string & destinationOperationId,
+	std::uint64_t destinationGeneration,
+	const std::vector<std::uint64_t> & selectedTags)
+{
+	if (!projection.ownershipEvidencePresent)
+	{
+		return {
+			false,
+			"ownership_evidence_missing"
+		};
+	}
+	if (!projection.ownershipIntegrity
+		|| projection.failClosed)
+	{
+		return {
+			false,
+			"ownership_integrity_fail_closed"
+		};
+	}
+
+	const VoiBattlefieldOperationProjection * source = nullptr;
+	const VoiBattlefieldOperationProjection * destination = nullptr;
+	std::size_t sourceMatches = 0;
+	std::size_t destinationMatches = 0;
+	for (const auto & operation : projection.operations)
+	{
+		if (operation.operationId == sourceOperationId
+			&& operation.generation == sourceGeneration)
+		{
+			source = &operation;
+			++sourceMatches;
+		}
+		if (operation.operationId == destinationOperationId
+			&& operation.generation == destinationGeneration)
+		{
+			destination = &operation;
+			++destinationMatches;
+		}
+	}
+	if (sourceMatches != 1 || destinationMatches != 1
+		|| source == nullptr || destination == nullptr)
+	{
+		return {
+			false,
+			"transfer_canonical_endpoint_mismatch"
+		};
+	}
+	if (!source->ownershipEvidencePresent
+		|| !destination->ownershipEvidencePresent)
+	{
+		return {
+			false,
+			"transfer_canonical_assignment_evidence_missing"
+		};
+	}
+	if (!source->transfer.atomicRevalidationReady
+		|| !source->transfer.transferSafe)
+	{
+		return {
+			false,
+			source->transfer.blocker.empty()
+				? "transfer_canonical_revalidation_failed"
+				: source->transfer.blocker
+		};
+	}
+	if (source->transfer.sourceOwnerId
+			!= sourceOperationId
+		|| source->transfer.counterpartOperationId
+			!= destinationOperationId
+		|| source->transfer.requestedGeneration
+			!= sourceGeneration
+		|| source->transfer.counterpartGeneration
+			!= destinationGeneration)
+	{
+		return {
+			false,
+			"transfer_canonical_identity_mismatch"
+		};
+	}
+
+	const std::set<std::uint64_t> selected(
+		selectedTags.begin(),
+		selectedTags.end());
+	const std::set<std::uint64_t> canonicalSelected(
+		source->transfer.transferableTags.begin(),
+		source->transfer.transferableTags.end());
+	if (selected.size() != selectedTags.size()
+		|| selected != canonicalSelected)
+	{
+		return {
+			false,
+			"transfer_canonical_selection_mismatch"
+		};
+	}
+	return { true, "" };
 }
 
+template <typename Mutation>
+bool voiApplyBattlefieldTransferMutationOnce(
+	const VoiBattlefieldProjection & projection,
+	const std::string & sourceOperationId,
+	std::uint64_t sourceGeneration,
+	const std::string & destinationOperationId,
+	std::uint64_t destinationGeneration,
+	const std::vector<std::uint64_t> & selectedTags,
+	const VoiOperationTransferEndpoint & sourceEndpoint,
+	const VoiOperationTransferEndpoint & destinationEndpoint,
+	std::string & blocker,
+	Mutation mutation)
+{
+	const auto validation =
+		voiValidateBattlefieldTransferMutation(
+			projection,
+			sourceOperationId,
+			sourceGeneration,
+			destinationOperationId,
+			destinationGeneration,
+			selectedTags);
+	if (!validation.valid)
+	{
+		blocker = validation.blocker;
+		return false;
+	}
+	blocker.clear();
+	return voiApplyOperationTransferMutationOnce(
+		sourceEndpoint,
+		destinationEndpoint,
+		mutation);
+}
