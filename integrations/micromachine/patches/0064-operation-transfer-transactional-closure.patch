+	const std::map<Tag, Owner> & owners,
+	const std::vector<std::pair<Tag, Owner>> & operationAssignments,
+	const std::vector<std::pair<Tag, Owner>> & squadAssignments,
+	const std::vector<std::pair<Tag, Owner>> & actionAssignments,
+	const std::vector<Tag> & selectedTags,
+	const Owner & currentSource,
+	const Owner & currentDestination,
+	const Owner & requestedSource,
+	const Owner & requestedDestination)
+{
+	VoiOperationTransferTransactionPlan<Tag, Owner> result;
+	auto assignmentMap =
+		[](
+			const std::vector<std::pair<Tag, Owner>> & assignments,
+			const std::string & duplicateBlocker,
+			std::string & blocker)
+		{
+			std::map<Tag, Owner> mapped;
+			for (const auto & assignment : assignments)
+			{
+				if (mapped.find(assignment.first) != mapped.end())
+				{
+					blocker = duplicateBlocker;
+					return std::map<Tag, Owner>();
+				}
+				mapped[assignment.first] = assignment.second;
+			}
+			return mapped;
+		};
+
+	std::string blocker;
+	const auto operationByTag = assignmentMap(
+		operationAssignments,
+		"transfer_duplicate_operation_tag",
+		blocker);
+	if (!blocker.empty())
+	{
+		result.blocker = blocker;
+		return result;
+	}
+	const auto squadByTag = assignmentMap(
+		squadAssignments,
+		"transfer_duplicate_squad_tag",
+		blocker);
+	if (!blocker.empty())
+	{
+		result.blocker = blocker;
+		return result;
+	}
+	if (operationByTag != squadByTag)
+	{
+		result.blocker = "transfer_operation_squad_mismatch";
+		return result;
+	}
+	for (const auto & assignment : operationByTag)
+	{
+		if (assignment.second != currentSource
+			&& assignment.second != currentDestination)
+		{
+			result.blocker = "transfer_operation_owner_out_of_scope";
+			return result;
+		}
+		const auto owner = owners.find(assignment.first);
+		if (owner == owners.end()
+			|| owner->second != assignment.second)
+		{
+			result.blocker = "transfer_owner_mismatch";
+			return result;
+		}
+	}
+	for (const auto & owner : owners)
+	{
+		if ((owner.second == currentSource
+				|| owner.second == currentDestination)
+			&& operationByTag.find(owner.first)
+				== operationByTag.end())
+		{
+			result.blocker = "transfer_owner_squad_mismatch";
+			return result;
+		}
+	}
+	const auto actionByTag = assignmentMap(
+		actionAssignments,
+		"transfer_duplicate_action_tag",
+		blocker);
+	if (!blocker.empty())
+	{
+		result.blocker = blocker;
+		return result;
+	}
+	for (const auto & action : actionByTag)
+	{
+		const auto operation = operationByTag.find(action.first);
+		if (operation == operationByTag.end()
+			|| operation->second != action.second)
+		{
+			result.blocker = "transfer_action_owner_mismatch";
+			return result;
+		}
+	}
+
+	std::set<Tag> selected;
+	for (const auto & tag : selectedTags)
+	{
+		if (!selected.insert(tag).second)
+		{
+			result.blocker = "transfer_duplicate_selected_tag";
+			return result;
+		}
+		const auto operation = operationByTag.find(tag);
+		if (operation == operationByTag.end()
+			|| operation->second != currentSource)
+		{
+			result.blocker = "transfer_selected_tag_not_source_owned";
+			return result;
+		}
+	}
+
+	result.replacementOwners = owners;
+	for (const auto & operation : operationByTag)
+	{
+		const bool transferred =
+			selected.find(operation.first) != selected.end();
+		if (operation.second == currentSource && !transferred)
+		{
+			result.replacementOwners[operation.first] = requestedSource;
+			result.sourceTags.push_back(operation.first);
+		}
+		else
+		{
+			result.replacementOwners[operation.first] =
+				requestedDestination;
+			result.destinationTags.push_back(operation.first);
+		}
+	}
+	result.admitted = true;
+	return result;
+}
