+bool voiParallelOperationContainsToken(
+	CCBot & bot,
+	int operationIndex,
+	const std::string & token)
+{
+	if (!voiParallelOperationIsActive(bot, operationIndex)
+		|| token.empty())
+	{
+		return false;
+	}
+	const std::string prefix =
+		"operations." + std::to_string(operationIndex);
+	for (const std::string & field : {
+			".tactical_task.production_targets",
+			".tactical_task.unit_classes",
+			".scope.unit_classes" })
+	{
+		if (voiCommaListContains(
+				bot.Commander().getVoiPolicyString(
+					prefix + field,
+					""),
+				token))
+		{
+			return true;
+		}
+	}
+	const std::string compositionPrefix =
+		prefix + ".composition_requirements";
+	const int requirementCount = std::min(
+		32,
+		std::max(
+			0,
+			bot.Commander().getVoiPolicyInt(
+				compositionPrefix + ".count",
+				0)));
+	for (int requirementIndex = 0;
+		requirementIndex < requirementCount;
+		++requirementIndex)
+	{
+		if (bot.Commander().getVoiPolicyString(
+				compositionPrefix + "."
+					+ std::to_string(requirementIndex)
+					+ ".unit_type",
+				"") == token)
+		{
+			return true;
+		}
+	}
+	return false;
+}
