+void CombatCommander::synchronizeVoiOperationLifecycleForProduction()
+{
+	if (m_voiOperations.empty())
+	{
+		return;
+	}
+
+	const int operationCount =
+		m_bot.Commander().isVoiPolicyActive()
+			? std::min(
+				32,
+				std::max(
+					0,
+					m_bot.Commander().getVoiPolicyInt(
+						"operations.count",
+						0)))
+			: 0;
+	const uint64_t currentFrame =
+		static_cast<uint64_t>(m_bot.GetCurrentFrame());
+	for (auto & operation : m_voiOperations)
+	{
+		bool retained = false;
+		bool terminal = false;
+		std::string reason =
+			"removed_from_policy_before_production";
+		int matchingEntryCount = 0;
+		int matchingIndex = -1;
+		for (int index = 0;
+			index < operationCount;
+			++index)
+		{
+			const std::string prefix =
+				"operations." + std::to_string(index);
+			if (m_bot.Commander().getVoiPolicyString(
+					prefix + ".operation_id",
+					"") != operation.operationId
+				|| static_cast<uint64_t>(
+					std::max(
+						1,
+						m_bot.Commander().getVoiPolicyInt(
+							prefix + ".generation",
+							1))) != operation.generation)
+			{
+				continue;
+			}
+			++matchingEntryCount;
+			matchingIndex = index;
+		}
+
+		if (matchingEntryCount > 1)
+		{
+			reason =
+				"duplicate_operation_key_before_production";
+		}
+		else if (matchingEntryCount == 1)
+		{
+			retained = true;
+			const std::string prefix =
+				"operations."
+					+ std::to_string(matchingIndex);
+			const std::string status =
+				m_bot.Commander().getVoiPolicyString(
+					prefix + ".status",
+					"");
+			const std::string completionState =
+				m_bot.Commander().getVoiPolicyString(
+					prefix + ".lifetime.completion_state",
+					"active");
+			const bool cancelled =
+				m_bot.Commander().getVoiPolicyBool(
+					prefix + ".cancelled",
+					false)
+				|| status == "CANCELLED"
+				|| status == "cancelled"
+				|| completionState == "cancelled";
+			const bool completed =
+				m_bot.Commander().getVoiPolicyBool(
+					prefix + ".completed",
+					false)
+				|| status == "COMPLETED"
+				|| status == "completed"
+				|| completionState == "completed";
+			const bool expired =
+				status == "EXPIRED"
+				|| status == "expired"
+				|| completionState == "expired";
+			const bool failed =
+				status == "FAILED"
+				|| status == "failed"
+				|| completionState == "failed";
+			const bool superseded =
+				status == "SUPERSEDED"
+				|| status == "superseded"
+				|| completionState == "superseded";
+			const int rawOperationIssuedAtFrame =
+				m_bot.Commander().getVoiPolicyInt(
+					prefix + ".issued_at_frame",
+					-1);
+			const int policyIssuedAtFrame =
+				m_bot.Commander().getVoiPolicyInt(
+					"issued_at_frame",
+					-1);
+			const int issuedAtFrame =
+				rawOperationIssuedAtFrame > 0
+					? rawOperationIssuedAtFrame
+					: (policyIssuedAtFrame >= 0
+						? policyIssuedAtFrame
+						: rawOperationIssuedAtFrame);
+			const std::string lifetimeMode =
+				m_bot.Commander().getVoiPolicyString(
+					prefix + ".lifetime.mode",
+					"until_completed");
+			const bool standing =
+				lifetimeMode == "standing_order"
+				|| lifetimeMode == "until_cancelled";
+			const int durationSeconds = std::max(
+				0,
+				m_bot.Commander().getVoiPolicyInt(
+					prefix
+						+ ".tactical_task.duration_seconds",
+					m_bot.Commander().getVoiPolicyInt(
+						prefix
+							+ ".scope.duration_seconds",
+						0)));
+			const uint64_t deadlineFrame =
+				issuedAtFrame >= 0
+					&& !standing
+					&& durationSeconds > 0
+				? static_cast<uint64_t>(
+						issuedAtFrame)
+					+ static_cast<uint64_t>(
+						durationSeconds) * 22u
+				: 0;
+
+			if (issuedAtFrame < 0)
+			{
+				retained = false;
+				reason =
+					"missing_operation_issued_at_frame";
+			}
+			else if (static_cast<uint64_t>(
+					issuedAtFrame) > currentFrame)
+			{
+				retained = false;
+				reason =
+					"future_operation_issued_at_frame";
+			}
+			else if (deadlineFrame > 0
+				&& currentFrame > deadlineFrame)
+			{
+				terminal = true;
+				reason =
+					"operation_deadline_expired";
+			}
+			else if (cancelled)
+			{
+				terminal = true;
+				reason = "cancelled_by_policy";
+			}
+			else if (expired)
+			{
+				terminal = true;
+				reason = "expired_by_policy";
+			}
+			else if (failed)
+			{
+				terminal = true;
+				reason = "failed_by_policy";
+			}
+			else if (superseded)
+			{
+				terminal = true;
+				reason = "superseded_by_policy";
+			}
+			else if (completed)
+			{
+				terminal = true;
+				reason = "completed_by_policy";
+			}
+		}
+
+		if (!retained || terminal)
+		{
+			releaseVoiOperation(
+				operation,
+				reason,
+				terminal);
+			if (terminal)
+			{
+				operation.status =
+					reason == "cancelled_by_policy"
+						? "CANCELLED"
+						: (reason == "expired_by_policy"
+								|| reason
+									== "operation_deadline_expired"
+							? "EXPIRED"
+							: (reason == "failed_by_policy"
+								? "FAILED"
+								: (reason
+										== "superseded_by_policy"
+									? "SUPERSEDED"
+									: "COMPLETED")));
+			}
+		}
+	}
+}
