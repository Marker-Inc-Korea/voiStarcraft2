+				prefix + ".operation_id",
+				"") != operationId
+			|| static_cast<uint64_t>(
+				std::max(
+					1,
+					bot.Commander().getVoiPolicyInt(
+						prefix + ".generation",
+						1))) != generation)
+		{
+			continue;
+		}
+		++matchingEntries;
+		if (matchingEntries > 1)
+		{
+			return false;
+		}
+	}
+	return matchingEntries == 1;
