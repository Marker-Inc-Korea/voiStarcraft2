+void BuildOrderQueue::promoteTypeToHighestPriority(
+	const MetaType & type,
+	bool blocking)
+{
+	auto promoted = m_queue.end();
+	for (auto item = m_queue.begin(); item != m_queue.end(); ++item)
+	{
+		if (!sameBuildOrderType(*item, type))
+		{
+			continue;
+		}
+		if (promoted == m_queue.end()
+			|| item->voiTaskPriority > promoted->voiTaskPriority
+			|| (item->voiTaskPriority == promoted->voiTaskPriority
+				&& item->priority > promoted->priority)
+			|| (item->voiTaskPriority == promoted->voiTaskPriority
+				&& item->priority == promoted->priority
+				&& item->insertionSequence
+					> promoted->insertionSequence))
+		{
+			promoted = item;
+		}
+	}
+	if (promoted == m_queue.end())
+	{
+		return;
+	}
+
+	const int promotedPriority =
+		m_highestPriority + m_defaultPrioritySpacing;
+	ensureVoiOwnerMetadata(*promoted);
+	auto promotedOwner =
+		promoted->voiOperationOwnerMetadata.end();
+	for (auto owner =
+			promoted->voiOperationOwnerMetadata.begin();
+		owner != promoted->voiOperationOwnerMetadata.end();
+		++owner)
+	{
+		if (promotedOwner
+				== promoted->voiOperationOwnerMetadata.end()
+			|| owner->second.taskPriority
+				> promotedOwner->second.taskPriority
+			|| (owner->second.taskPriority
+					== promotedOwner->second.taskPriority
+				&& owner->second.priority
+					> promotedOwner->second.priority))
+		{
+			promotedOwner = owner;
+		}
+	}
+	const bool promotePreserved =
+		promoted->preserveWithoutVoiOperationOwners
+		&& (promotedOwner
+				== promoted->voiOperationOwnerMetadata.end()
+			|| promoted->voiPreservedTaskPriority
+				>= promotedOwner->second.taskPriority);
+	if (promotePreserved)
+	{
+		promoted->voiPreservedPriority = promotedPriority;
+		promoted->voiPreservedBlocking =
+			promoted->voiPreservedBlocking || blocking;
+	}
+	else if (promotedOwner
+		!= promoted->voiOperationOwnerMetadata.end())
+	{
+		promotedOwner->second.priority = promotedPriority;
+		promotedOwner->second.blocking =
+			promotedOwner->second.blocking || blocking;
+	}
+	refreshVoiAggregateMetadata(*promoted);
+	std::sort(m_queue.begin(), m_queue.end());
+	refreshPriorityBounds();
+}
