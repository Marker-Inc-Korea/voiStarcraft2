+void BuildOrderQueue::reconcileTypeVoiClaims(
+	const MetaType & type,
+	const std::vector<MM::VoiBuildOrderClaim> & claims)
+{
+	std::vector<MM::BuildOrderItem> existing;
+	for (auto item = m_queue.begin(); item != m_queue.end();)
+	{
+		if (!sameBuildOrderType(*item, type))
+		{
+			++item;
+			continue;
+		}
+		existing.push_back(*item);
+		item = m_queue.erase(item);
+	}
+	refreshPriorityBounds();
+
+	std::vector<bool> used(existing.size(), false);
+	std::vector<MM::BuildOrderItem> reconciled;
+	reconciled.reserve(claims.size());
+	int nextNewPriority =
+		m_highestPriority + m_defaultPrioritySpacing;
+	for (const auto & claim : claims)
+	{
+		int matchedIndex = -1;
+		for (int index = 0;
+			index < static_cast<int>(existing.size());
+			++index)
+		{
+			if (used[index])
+			{
+				continue;
+			}
+			const bool sameIdentity =
+				claim.insertionSequence > 0
+				&& existing[index].insertionSequence
+					== claim.insertionSequence;
+			ensureVoiOwnerMetadata(existing[index]);
+			const auto claimOwnerMetadata =
+				normalizedOwnerMetadata(
+					claim,
+					existing[index].priority);
+			const bool sameClaim =
+				existing[index].voiOperationOwners
+						== claim.operationOwners
+					&& existing[index].preserveWithoutVoiOperationOwners
+						== claim.preserveWithoutOperationOwners
+					&& existing[index].voiClaimSource
+						== claim.source
+					&& existing[index].voiOperationOwnerMetadata
+						== claimOwnerMetadata
+					&& existing[index].voiPreservedClaimSource
+						== normalizedPreservedSource(claim)
+					&& existing[index].voiPreservedBlocking
+						== (claim.preservedSource.empty()
+							? claim.blocking
+							: claim.preservedBlocking)
+					&& existing[index].voiPreservedTaskPriority
+						== (claim.preservedSource.empty()
+							? claim.taskPriority
+							: claim.preservedTaskPriority);
+			if (sameIdentity || sameClaim)
+			{
+				matchedIndex = index;
+				break;
+			}
+		}
+
+		if (matchedIndex >= 0)
+		{
+			used[matchedIndex] = true;
+			auto item = existing[matchedIndex];
+			item.voiOperationOwners = claim.operationOwners;
+			item.preserveWithoutVoiOperationOwners =
+				claim.preserveWithoutOperationOwners;
+			item.voiClaimSource = claim.source;
+			item.voiOperationOwnerMetadata =
+				normalizedOwnerMetadata(
+					claim,
+					item.priority);
+			item.voiPreservedClaimSource =
+				normalizedPreservedSource(claim);
+			item.voiPreservedBlocking =
+				claim.preservedSource.empty()
+					? claim.blocking
+					: claim.preservedBlocking;
+			item.voiPreservedTaskPriority =
+				claim.preservedSource.empty()
+					? claim.taskPriority
+					: claim.preservedTaskPriority;
+			item.voiPreservedPriority =
+				claim.preservedPriority == 0
+					? item.priority
+					: claim.preservedPriority;
+			refreshVoiAggregateMetadata(item);
+			reconciled.push_back(item);
+			continue;
+		}
+
+		const int claimPriority =
+			claim.insertionSequence > 0
+				? claim.priority
+				: nextNewPriority;
+		reconciled.emplace_back(
+			type,
+			claimPriority,
+			claim.blocking,
+			claim.operationOwners,
+			claim.preserveWithoutOperationOwners,
+			claim.source,
+			claim.taskPriority,
+			claim.insertionSequence,
+			normalizedOwnerMetadata(
+				claim,
+				claimPriority),
+			normalizedPreservedSource(claim),
+			claim.preservedSource.empty()
+				? claim.blocking
+				: claim.preservedBlocking,
+			claim.preservedSource.empty()
+				? claim.taskPriority
+				: claim.preservedTaskPriority,
+			claim.preservedPriority == 0
+				? claimPriority
+				: claim.preservedPriority);
+		if (claim.insertionSequence == 0)
+		{
+			nextNewPriority += m_defaultPrioritySpacing;
+		}
+	}
+
+	for (const auto & item : reconciled)
+	{
+		queueItem(item);
+	}
+}
