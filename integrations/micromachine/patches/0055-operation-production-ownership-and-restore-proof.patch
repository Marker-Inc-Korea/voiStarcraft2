+void BuildOrderQueue::addVoiOperationOwnersToType(
+	const MetaType & type,
+	const MM::BuildOrderItem & dependentItem)
+{
+	MM::BuildOrderItem dependent = dependentItem;
+	ensureVoiOwnerMetadata(dependent);
+	if (dependent.voiOperationOwners.empty()
+		&& !dependent.preserveWithoutVoiOperationOwners)
+	{
+		return;
+	}
+
+	// A prerequisite may be shared, but only one queued item is needed to
+	// carry that shared claim. Never smear an operation owner or macro
+	// preservation flag across every duplicate of the same type.
+	for (auto item = m_queue.rbegin(); item != m_queue.rend(); ++item)
+	{
+		if (!sameBuildOrderType(*item, type))
+		{
+			continue;
+		}
+		ensureVoiOwnerMetadata(*item);
+		if (dependent.preserveWithoutVoiOperationOwners)
+		{
+			const std::string dependentSource =
+				dependent.voiPreservedClaimSource.empty()
+					? "top_level"
+					: dependent.voiPreservedClaimSource;
+			const int dependentPriority = std::max(
+				dependent.priority,
+				dependent.voiPreservedPriority);
+			if (!item->preserveWithoutVoiOperationOwners)
+			{
+				item->voiPreservedClaimSource =
+					dependentSource;
+				item->voiPreservedBlocking =
+					dependent.voiPreservedBlocking;
+				item->voiPreservedTaskPriority =
+					dependent.voiPreservedTaskPriority;
+				item->voiPreservedPriority =
+					dependentPriority + 1;
+			}
+			else
+			{
+				item->voiPreservedBlocking =
+					item->voiPreservedBlocking
+					|| dependent.voiPreservedBlocking;
+				item->voiPreservedTaskPriority =
+					std::max(
+						item->voiPreservedTaskPriority,
+						dependent.voiPreservedTaskPriority);
+				item->voiPreservedPriority =
+					std::max(
+						item->voiPreservedPriority,
+						dependentPriority + 1);
+			}
+		}
+		item->voiOperationOwners.insert(
+			dependent.voiOperationOwners.begin(),
+			dependent.voiOperationOwners.end());
+		for (const auto & owner :
+			dependent.voiOperationOwners)
+		{
+			const auto dependentMetadata =
+				dependent.voiOperationOwnerMetadata.find(owner);
+			const MM::VoiBuildOrderOwnerMetadata metadataToInherit =
+				dependentMetadata
+						== dependent.voiOperationOwnerMetadata.end()
+					? MM::VoiBuildOrderOwnerMetadata {
+						"operation",
+						dependent.blocking,
+						dependent.voiTaskPriority,
+						dependent.priority }
+					: dependentMetadata->second;
+			auto & metadata =
+				item->voiOperationOwnerMetadata[owner];
+			metadata.source = "operation";
+			metadata.blocking =
+				metadata.blocking
+				|| metadataToInherit.blocking;
+			metadata.taskPriority = std::max(
+				metadata.taskPriority,
+				metadataToInherit.taskPriority);
+			metadata.priority = std::max(
+				metadata.priority,
+				std::max(
+					dependent.priority,
+					metadataToInherit.priority) + 1);
+		}
+		item->preserveWithoutVoiOperationOwners =
+			item->preserveWithoutVoiOperationOwners
+			|| dependent.preserveWithoutVoiOperationOwners;
+		refreshVoiAggregateMetadata(*item);
+		std::sort(m_queue.begin(), m_queue.end());
+		refreshPriorityBounds();
+		return;
+	}
+}
