+void BuildOrderQueue::refreshPriorityBounds()
+{
+	if (m_queue.empty())
+	{
+		m_highestPriority = 0;
+		m_lowestPriority = 0;
+		return;
+	}
+	m_highestPriority = m_queue.front().priority;
+	m_lowestPriority = m_queue.front().priority;
+	for (const auto & item : m_queue)
+	{
+		m_highestPriority =
+			std::max(m_highestPriority, item.priority);
+		m_lowestPriority =
+			std::min(m_lowestPriority, item.priority);
+	}
+}
