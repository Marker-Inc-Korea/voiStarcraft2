+int CombatCommander::getVoiOperationOwnedUnitCount(
+	const std::string & operationId,
+	uint64_t generation,
+	const std::string & compositionToken) const
+{
+	int count = 0;
+	for (const auto & owner : m_voiOperationUnitOwners)
+	{
+		if (owner.second.first != operationId
+			|| owner.second.second != generation)
+		{
+			continue;
+		}
+		const Unit unit = m_bot.GetUnit(owner.first);
+		if (unit.isValid()
+			&& unit.isAlive()
+			&& voiUnitMatchesCompositionToken(
+				unit,
+				compositionToken))
+		{
+			++count;
+		}
+	}
+	return count;
+}
+
