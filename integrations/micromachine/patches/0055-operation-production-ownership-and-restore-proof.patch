+int BuildOrderQueue::removeVoiOperationOwner(
+	const std::string & operationId,
+	uint64_t generation)
+{
+	int removedItems = 0;
+	for (auto item = m_queue.begin(); item != m_queue.end();)
+	{
+		ensureVoiOwnerMetadata(*item);
+		const auto owner = item->voiOperationOwners.find(
+			{ operationId, generation });
+		if (owner != item->voiOperationOwners.end())
+		{
+			item->voiOperationOwners.erase(owner);
+			item->voiOperationOwnerMetadata.erase(
+				{ operationId, generation });
+		}
+		if (item->voiOperationOwners.empty()
