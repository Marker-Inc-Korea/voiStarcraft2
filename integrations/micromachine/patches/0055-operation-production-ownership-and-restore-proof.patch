+			++count;
+		}
+	}
+	return count;
+}
+
+int CombatCommander::getVoiAssignableUnownedUnitCount(
+	const std::string & compositionToken) const
+{
+	int count = 0;
+	for (const auto & unit : m_combatUnits)
+	{
+		if (!unit.isValid()
+			|| !unit.isAlive()
+			|| !voiIsSupportedOperationUnit(unit)
+			|| isVoiOperationOwnedUnit(unit.getTag())
+			|| !voiUnitMatchesCompositionToken(
+				unit,
+				compositionToken))
+		{
+			continue;
+		}
+		if (voiTacticalNukeTaskRequested(m_bot)
+			&& unit.getAPIUnitType()
+				== sc2::UNIT_TYPEID::TERRAN_GHOST)
+		{
+			continue;
+		}
+		if (unit.getTag() == m_voiExplicitAbilityStagingActorTag
+			|| unit.getTag() == m_lastVoiExplicitAbilityActorTag)
+		{
+			continue;
+		}
+		const Squad * current = m_squadData.getUnitSquad(unit);
+		if (current == nullptr
+			|| (!voiIsOperationSquadName(current->getName())
+				&& current->getPriority()
+					< TacticalAbilityPriority))
+		{
+			++count;
+		}
+	}
+	return count;
+}
