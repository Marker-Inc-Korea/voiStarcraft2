+void BuildOrderQueue::resizeTypePreservingVoiClaims(
+	const MetaType & type,
+	int count,
+	bool blocking)
+{
+	std::vector<MM::VoiBuildOrderClaim> claims =
+		getVoiClaimsForType(type);
+	const int targetCount = std::max(0, count);
+	if (static_cast<int>(claims.size()) > targetCount)
+	{
+		claims.erase(
+			claims.begin(),
+			claims.end() - targetCount);
+	}
+	while (static_cast<int>(claims.size())
+		< targetCount)
+	{
+		claims.push_back({
+			{},
+			true,
+			"legacy",
+			blocking,
+			0.0f,
+			0,
+			0,
+			{},
+			"legacy",
+			blocking,
+			0.0f,
+			0 });
+	}
+	reconcileTypeVoiClaims(type, claims);
+}
