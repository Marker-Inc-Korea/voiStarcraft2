+std::string voiBuildQueueJsonEscape(const std::string & value)
+{
+	std::ostringstream escaped;
+	for (const char character : value)
+	{
+		switch (character)
+		{
+			case '\\': escaped << "\\\\"; break;
+			case '"': escaped << "\\\""; break;
+			case '\n': escaped << "\\n"; break;
+			case '\r': escaped << "\\r"; break;
+			case '\t': escaped << "\\t"; break;
+			default: escaped << character; break;
+		}
+	}
+	return escaped.str();
+}
+
+bool sameBuildOrderType(
+	const MM::BuildOrderItem & item,
+	const MetaType & type)
+{
+	const auto itemApiType =
+		item.type.getUnitType().getAPIUnitType();
+	const auto requestedApiType =
+		type.getUnitType().getAPIUnitType();
+	return itemApiType == 0
+		? item.type == type
+		: itemApiType == requestedApiType;
+}
+
+std::map<
+	MM::VoiBuildOrderOwner,
+	MM::VoiBuildOrderOwnerMetadata>
+normalizedOwnerMetadata(
+	const MM::VoiBuildOrderClaim & claim,
+	int fallbackPriority)
+{
+	auto metadata = claim.operationOwnerMetadata;
+	for (const auto & owner : claim.operationOwners)
+	{
+		auto existing = metadata.find(owner);
+		if (existing == metadata.end())
+		{
+			metadata[owner] = {
+				claim.source == "shared_prerequisite"
+					? "operation"
+					: claim.source,
+				claim.blocking,
+				claim.taskPriority,
+				fallbackPriority };
+			continue;
+		}
+		if (existing->second.priority == 0)
+		{
+			existing->second.priority = fallbackPriority;
+		}
+	}
+	for (auto existing = metadata.begin();
+		existing != metadata.end();)
+	{
+		if (claim.operationOwners.find(existing->first)
+			== claim.operationOwners.end())
+		{
+			existing = metadata.erase(existing);
+			continue;
+		}
+		++existing;
+	}
+	return metadata;
+}
+
+std::string normalizedPreservedSource(
+	const MM::VoiBuildOrderClaim & claim)
+{
+	if (!claim.preserveWithoutOperationOwners)
+	{
+		return "";
+	}
+	if (!claim.preservedSource.empty())
+	{
+		return claim.preservedSource;
+	}
+	return claim.operationOwners.empty()
+		? claim.source
+		: "top_level";
+}
+
+void ensureVoiOwnerMetadata(MM::BuildOrderItem & item)
+{
+	for (const auto & owner : item.voiOperationOwners)
+	{
+		if (item.voiOperationOwnerMetadata.find(owner)
+			== item.voiOperationOwnerMetadata.end())
+		{
+			item.voiOperationOwnerMetadata[owner] = {
+				item.voiClaimSource == "shared_prerequisite"
+					? "operation"
+					: item.voiClaimSource,
+				item.blocking,
+				item.voiTaskPriority,
+				item.priority };
+		}
+	}
+	for (auto existing =
+			item.voiOperationOwnerMetadata.begin();
+		existing != item.voiOperationOwnerMetadata.end();)
+	{
+		if (item.voiOperationOwners.find(existing->first)
+			== item.voiOperationOwners.end())
+		{
+			existing =
+				item.voiOperationOwnerMetadata.erase(existing);
+			continue;
+		}
+		++existing;
+	}
+
+	if (item.preserveWithoutVoiOperationOwners
+		&& item.voiPreservedClaimSource.empty())
+	{
+		item.voiPreservedClaimSource =
+			item.voiOperationOwners.empty()
+				? item.voiClaimSource
+				: "top_level";
+		item.voiPreservedBlocking = item.blocking;
+		item.voiPreservedTaskPriority =
+			item.voiTaskPriority;
+		item.voiPreservedPriority = item.priority;
+	}
+}
+
+void refreshVoiAggregateMetadata(MM::BuildOrderItem & item)
+{
+	ensureVoiOwnerMetadata(item);
+	bool blocking = false;
+	float taskPriority = 0.0f;
+	int priority = item.priority;
+	bool hasPriority = false;
+
+	if (item.preserveWithoutVoiOperationOwners)
+	{
+		blocking = item.voiPreservedBlocking;
+		taskPriority = item.voiPreservedTaskPriority;
+		priority = item.voiPreservedPriority;
+		hasPriority = true;
+	}
+	for (const auto & owner : item.voiOperationOwnerMetadata)
+	{
+		blocking = blocking || owner.second.blocking;
+		taskPriority = std::max(
+			taskPriority,
+			owner.second.taskPriority);
+		if (!hasPriority
+			|| owner.second.priority > priority)
+		{
+			priority = owner.second.priority;
+			hasPriority = true;
+		}
+	}
+
+	item.blocking = blocking;
+	item.voiTaskPriority = taskPriority;
+	if (hasPriority)
+	{
+		item.priority = priority;
+	}
+	if (item.preserveWithoutVoiOperationOwners
+		&& !item.voiOperationOwners.empty())
+	{
+		item.voiClaimSource = "shared_prerequisite";
+	}
+	else if (item.preserveWithoutVoiOperationOwners)
+	{
+		item.voiClaimSource =
+			item.voiPreservedClaimSource.empty()
+				? "legacy"
+				: item.voiPreservedClaimSource;
+	}
+	else if (!item.voiOperationOwnerMetadata.empty())
+	{
+		item.voiClaimSource =
+			item.voiOperationOwnerMetadata.begin()
+				->second.source;
+	}
+}
