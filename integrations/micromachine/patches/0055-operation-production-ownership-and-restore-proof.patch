+std::set<std::pair<std::string, uint64_t>>
+voiParallelOperationOwnersForType(
+	CCBot & bot,
+	const MetaType & type)
+{
+	std::set<std::pair<std::string, uint64_t>> owners;
+	for (int operationIndex = 0;
+		operationIndex < voiParallelOperationCount(bot);
+		++operationIndex)
+	{
+		if (!voiParallelOperationRequiresType(
+				bot,
+				operationIndex,
+				type))
+		{
+			continue;
+		}
+		const std::string prefix =
+			"operations." + std::to_string(operationIndex);
+		const std::string operationId =
+			bot.Commander().getVoiPolicyString(
+				prefix + ".operation_id",
+				"");
+		if (operationId.empty())
+		{
+			continue;
+		}
+		owners.insert({
+			operationId,
+			static_cast<uint64_t>(
+				std::max(
+					1,
+					bot.Commander().getVoiPolicyInt(
+						prefix + ".generation",
+						1)))
+		});
+	}
+	return owners;
+}
