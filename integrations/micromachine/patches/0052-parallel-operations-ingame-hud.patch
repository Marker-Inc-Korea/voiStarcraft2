+std::string voiOperationAbilityPolicyForUnit(
+	const VoiOperationState * operation,
+	const sc2::Unit * unit,
+	const std::string & role)
+{
+	if (operation != nullptr && unit != nullptr)
+	{
+		const VoiOperationState::UnitRole * selectedRole = nullptr;
+		for (const auto & operationRole : operation->unitRoles)
+		{
+			if (!operationRole.abilityPolicy.empty()
+				&& voiSc2UnitMatchesRoleToken(
+					unit,
+					operationRole.unitType)
+				&& (selectedRole == nullptr
+					|| operationRole.priority
+						>= selectedRole->priority))
+			{
+				selectedRole = &operationRole;
+			}
+		}
+		if (selectedRole != nullptr)
+		{
+			return selectedRole->abilityPolicy;
+		}
+	}
+	if (role == "cloak_if_available"
+		|| role == "worker_harass"
+		|| role == "spellcaster"
+		|| role == "ambush"
+		|| role == "zone_control"
+		|| role == "siege_support"
+		|| role == "contain"
+		|| role == "defensive_hold")
+	{
+		return "if_available";
+	}
+	if (role == "yamato_high_value"
+		|| role == "capital_pressure"
+		|| role == "capital_ship"
+		|| role == "capital_ship_focus")
+	{
+		return "high_value_target";
+	}
+	if (role == "tactical_jump_escape"
+		|| role == "evac")
+	{
+		return "escape";
+	}
+	return "never";
+}
