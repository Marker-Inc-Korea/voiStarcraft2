+std::string voiResolveOperationTargetEvidence(
+	CCBot & bot,
+	const std::string & locationIntent,
+	const CCPosition & explicitTarget,
+	const CCPosition & resolvedTarget)
+{
+	if (resolvedTarget == CCPosition())
+	{
+		return "unresolved";
+	}
+	if (explicitTarget != CCPosition())
+	{
+		return "explicit";
+	}
+	if (locationIntent == "home"
+		|| locationIntent == "self_main"
+		|| locationIntent == "main_base")
+	{
+		return "self_observed";
+	}
+	if (locationIntent == "natural"
+		|| locationIntent == "self_natural")
+	{
+		return "self_natural";
+	}
+	const CCPosition observedEnemy =
+		voiObservedEnemyCombatTarget(bot);
+	if (observedEnemy != CCPosition()
+		&& Util::DistSq(
+			observedEnemy,
+			resolvedTarget) <= 4.0f)
+	{
+		return "observed_enemy";
+	}
+	const BaseLocation * enemyBase =
+		bot.Bases().getPlayerStartingBaseLocation(
+			Players::Enemy);
+	if (enemyBase != nullptr
+		&& voiIsRemoteCombatTarget(
+			bot,
+			enemyBase->getDepotPosition())
+		&& Util::DistSq(
+			enemyBase->getDepotPosition(),
+			resolvedTarget) <= 4.0f)
+	{
+		return "known_enemy_base";
+	}
+	if (locationIntent == "enemy_main"
+		|| locationIntent == "enemy_base"
+		|| locationIntent == "enemy_start"
+		|| locationIntent == "enemy_start_location"
+		|| locationIntent == "enemy_natural"
+		|| locationIntent == "contain_enemy_natural"
+		|| locationIntent == "enemy_front")
+	{
+		return "search_candidate";
+	}
+	return "resolved";
+}
