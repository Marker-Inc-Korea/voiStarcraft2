+std::string voiOperationJsonEscape(const std::string & value)
+{
+	std::ostringstream escaped;
+	for (const unsigned char character : value)
+	{
+		switch (character)
+		{
+		case '"':
+			escaped << "\\\"";
+			break;
+		case '\\':
+			escaped << "\\\\";
+			break;
+		case '\b':
+			escaped << "\\b";
+			break;
+		case '\f':
+			escaped << "\\f";
+			break;
+		case '\n':
+			escaped << "\\n";
+			break;
+		case '\r':
+			escaped << "\\r";
+			break;
+		case '\t':
+			escaped << "\\t";
+			break;
+		default:
+			if (character >= 0x20)
+			{
+				escaped << static_cast<char>(character);
+			}
+			break;
+		}
+	}
+	return escaped.str();
+}
