+CCPosition voiResolveOperationRouteWaypoint(
+	CCBot & bot,
+	const std::string & routeType,
+	const CCPosition & target)
+{
+	if (target == CCPosition()
+		|| routeType.empty()
+		|| routeType == "direct"
+		|| routeType == "shortest")
+	{
+		return target;
+	}
+	const bool leftRoute =
+		routeType == "flank_left"
+		|| routeType == "left_flank";
+	const bool rightRoute =
+		routeType == "flank_right"
+		|| routeType == "right_flank";
+	const bool safeRoute =
+		routeType == "safe"
+		|| routeType == "safe_route"
+		|| routeType == "safe_path"
+		|| routeType == "avoid_enemy_strength";
+	if (!leftRoute && !rightRoute && !safeRoute)
+	{
+		return target;
+	}
+	const CCPosition home = voiHomePosition(bot);
+	const CCPosition direction = target - home;
+	const float distance = std::sqrt(
+		direction.x * direction.x + direction.y * direction.y);
+	if (distance <= 12.0f)
+	{
+		return target;
+	}
+	const CCPosition forward = direction / distance;
+	const CCPosition lateral(-forward.y, forward.x);
+	const float side = rightRoute ? -1.0f : 1.0f;
+	const float lateralDistance = safeRoute ? 8.0f : 14.0f;
+	for (float progress : {0.55f, 0.45f, 0.65f})
+	{
+		for (float candidateSide : {side, -side})
+		{
+			const CCPosition candidate =
+				home + forward * (distance * progress)
+					+ lateral
+						* (lateralDistance * candidateSide);
+			if (bot.Map().isValidPosition(candidate)
+				&& bot.Map().isWalkable(candidate)
+				&& bot.Map().isConnected(home, candidate))
+			{
+				return candidate;
+			}
+		}
+	}
+	return target;
+}
