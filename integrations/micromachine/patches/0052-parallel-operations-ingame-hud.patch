+bool voiIsValidOperationId(const std::string & operationId)
+{
+	if (operationId.empty() || operationId.size() > 128)
+	{
+		return false;
+	}
+	for (const unsigned char value : operationId)
+	{
+		if (!std::isalnum(value)
+			&& value != '.'
+			&& value != ':'
+			&& value != '_'
+			&& value != '-')
+		{
+			return false;
+		}
+	}
+	return true;
+}
