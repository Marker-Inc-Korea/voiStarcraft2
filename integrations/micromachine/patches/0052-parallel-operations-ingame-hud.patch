+std::string voiOperationRoleForUnit(
+	const VoiOperationState * operation,
+	const sc2::Unit * unit)
+{
+	if (operation == nullptr || unit == nullptr)
+	{
+		return "";
+	}
+	const VoiOperationState::UnitRole * selectedRole = nullptr;
+	for (const auto & role : operation->unitRoles)
+	{
+		if (!role.role.empty()
+			&& voiSc2UnitMatchesRoleToken(unit, role.unitType)
+			&& (selectedRole == nullptr
+				|| role.priority >= selectedRole->priority))
+		{
+			selectedRole = &role;
+		}
+	}
+	if (selectedRole != nullptr)
+	{
+		return selectedRole->role;
+	}
+	for (const auto & requirement :
+		operation->compositionRequirements)
+	{
+		if (!requirement.role.empty()
+			&& voiSc2UnitMatchesRoleToken(
+				unit,
+				requirement.unitType))
+		{
+			return requirement.role;
+		}
+	}
+	return "";
+}
