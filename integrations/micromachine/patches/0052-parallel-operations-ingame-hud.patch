+CCPosition voiResolveOperationTarget(
+	CCBot & bot,
+	const std::string & taskType,
+	const std::string & locationIntent,
+	const CCPosition & explicitTarget)
+{
+	if (explicitTarget != CCPosition()
+		&& bot.Map().isValidPosition(explicitTarget))
+	{
+		return explicitTarget;
+	}
+	if (locationIntent == "home"
+		|| locationIntent == "self_main"
+		|| locationIntent == "main_base")
+	{
+		return voiHomePosition(bot);
+	}
+	if (locationIntent == "natural"
+		|| locationIntent == "self_natural")
+	{
+		const BaseLocation * natural =
+			bot.Bases().getPlayerNat(Players::Self);
+		return natural ? natural->getPosition() : voiHomePosition(bot);
+	}
+	if (locationIntent == "last_seen_enemy_army"
+		|| locationIntent == "observed_enemy")
+	{
+		return voiObservedEnemyCombatTarget(bot);
+	}
+	if (taskType == "defend" && locationIntent.empty())
+	{
+		return voiHomePosition(bot);
+	}
+	const CCPosition observedTarget = voiObservedEnemyCombatTarget(bot);
+	const CCPosition fallbackTarget = observedTarget != CCPosition()
+		? observedTarget
+		: voiEnemyMainCombatTarget(bot);
+	return voiResolveCombatLocationIntent(
+		bot,
+		locationIntent,
+		fallbackTarget);
+}
