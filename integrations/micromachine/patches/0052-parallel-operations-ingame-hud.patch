+int voiParallelOperationCount(CCBot & bot)
+{
+	return std::min(
+		32,
+		std::max(
+			0,
+			bot.Commander().getVoiPolicyInt(
+				"operations.count",
+				0)));
+}
+
+bool voiParallelOperationTaskListContains(
+	CCBot & bot,
+	const std::string & field,
+	const std::string & needle)
+{
+	for (int operationIndex = 0;
+		operationIndex < voiParallelOperationCount(bot);
+		++operationIndex)
+	{
+		const std::string value =
+			bot.Commander().getVoiPolicyString(
+				"operations."
+					+ std::to_string(operationIndex)
+					+ ".tactical_task."
+					+ field,
+				"");
+		if (voiCommaListContains(value, needle))
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+float voiParallelOperationTaskPriority(CCBot & bot)
+{
+	float priority = 0.0f;
+	for (int operationIndex = 0;
+		operationIndex < voiParallelOperationCount(bot);
+		++operationIndex)
+	{
+		priority = std::max(
+			priority,
+			bot.Commander().getVoiPolicyFloat(
+				"operations."
+					+ std::to_string(operationIndex)
+					+ ".tactical_task.priority",
+				0.0f));
+	}
+	return priority;
+}
