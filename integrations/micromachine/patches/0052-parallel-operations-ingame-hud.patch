+
+bool CombatCommander::isCurrentVoiOperationAction(
+	const sc2::Unit * unit,
+	const UnitAction & action)
+{
+	if (unit == nullptr
+		|| action.operationId.empty()
+		|| action.operationGeneration == 0)
+	{
+		return false;
+	}
+	const auto owner = m_voiOperationUnitOwners.find(unit->tag);
+	if (owner == m_voiOperationUnitOwners.end()
+		|| owner->second.first != action.operationId
+		|| owner->second.second != action.operationGeneration)
+	{
+		return false;
+	}
+	const VoiOperationState * operation = findVoiOperation(
+		action.operationId,
+		action.operationGeneration);
+	return operation != nullptr
+		&& !operation->completed
+		&& operation->squadName == action.squad
+		&& m_squadData.squadExists(operation->squadName)
+		&& m_squadData.getSquad(
+			operation->squadName).containsUnit(unit->tag);
+}
+
+void CombatCommander::releaseVoiOperation(
+	VoiOperationState & operation,
+	const std::string & reason,
+	bool terminal)
+{
+	std::vector<Unit> unitsToRestore;
+	if (!operation.squadName.empty()
+		&& m_squadData.squadExists(operation.squadName))
+	{
+		unitsToRestore =
+			m_squadData.getSquad(operation.squadName).getUnits();
+		m_squadData.removeSquad(operation.squadName);
+	}
+	for (const auto & unit : unitsToRestore)
+	{
+		const auto owner =
+			m_voiOperationUnitOwners.find(unit.getTag());
+		if (owner != m_voiOperationUnitOwners.end()
+			&& owner->second.first == operation.operationId
+			&& owner->second.second == operation.generation)
+		{
+			m_voiOperationUnitOwners.erase(owner);
+		}
+		const auto previous =
+			operation.previousSquadByTag.find(unit.getTag());
+		std::string restoreSquad =
+			previous != operation.previousSquadByTag.end()
+				? previous->second
+				: "Backup";
+		if (voiIsOperationSquadName(restoreSquad)
+			|| !m_squadData.squadExists(restoreSquad))
+		{
+			restoreSquad =
+				m_squadData.squadExists("Backup")
+					? "Backup"
+					: "Idle";
+		}
+		if (m_squadData.squadExists(restoreSquad)
+			&& unit.isValid()
+			&& unit.isAlive())
+		{
+			m_squadData.assignUnitToSquad(
+				unit,
+				m_squadData.getSquad(restoreSquad));
+		}
+	}
+	for (auto owner = m_voiOperationUnitOwners.begin();
+		owner != m_voiOperationUnitOwners.end();)
+	{
+		if (owner->second.first == operation.operationId
+			&& owner->second.second == operation.generation)
+		{
+			owner = m_voiOperationUnitOwners.erase(owner);
+		}
+		else
+		{
+			++owner;
+		}
+	}
+	for (auto action = unitActions.begin();
+		action != unitActions.end();)
+	{
+		if (action->second.operationId == operation.operationId
+			&& action->second.operationGeneration
+				== operation.generation)
+		{
+			action = unitActions.erase(action);
+		}
+		else
+		{
+			++action;
+		}
+	}
+	operation.assignedUnitTags.clear();
+	operation.assignedCount = 0;
+	operation.previousSquadByTag.clear();
+	operation.submittedPositions.clear();
+	operation.blockedReason = reason;
+	if (terminal)
+	{
+		operation.completed = true;
+		operation.status = "COMPLETED";
+	}
+	else
+	{
+		operation.status = "BLOCKED";
+	}
+}
+
+void CombatCommander::recordVoiOperationSubmission(
+	const sc2::Unit * unit,
+	const UnitAction & action)
+{
+	if (!isCurrentVoiOperationAction(unit, action))
+	{
+		return;
+	}
+	VoiOperationState * operation = findVoiOperation(
+		action.operationId,
+		action.operationGeneration);
+	if (operation == nullptr)
+	{
+		return;
+	}
+	const uint32_t frame = m_bot.GetGameLoop();
+	if (operation->submittedFrame == 0)
+	{
+		operation->submittedFrame = frame;
+	}
+	if (operation->submittedPositions.find(unit->tag)
+		== operation->submittedPositions.end())
+	{
+		operation->submittedPositions[unit->tag] = unit->pos;
+	}
+	operation->lastActionFrame = frame;
+	operation->lastAction = voiActionEvidence(action);
+	if (operation->status != "BLOCKED"
+		&& operation->status != "MOVING"
+		&& operation->status != "ENGAGED"
+		&& operation->status != "COMPLETED")
+	{
+		operation->status = "SUBMITTED";
+	}
+}
+
+void CombatCommander::observeVoiOperations()
+{
+	const uint32_t currentFrame = m_bot.GetGameLoop();
+	const CCPosition home = voiHomePosition(m_bot);
+	for (auto & operation : m_voiOperations)
+	{
+		if (operation.completed
+			|| operation.squadName.empty()
+			|| !m_squadData.squadExists(operation.squadName))
+		{
+			continue;
+		}
+		Squad & squad = m_squadData.getSquad(operation.squadName);
+		for (auto owner = m_voiOperationUnitOwners.begin();
+			owner != m_voiOperationUnitOwners.end();)
+		{
+			if (owner->second.first == operation.operationId
+				&& owner->second.second == operation.generation
+				&& !squad.containsUnit(owner->first))
+			{
+				operation.previousSquadByTag.erase(owner->first);
+				operation.submittedPositions.erase(owner->first);
+				owner = m_voiOperationUnitOwners.erase(owner);
+			}
+			else
+			{
+				++owner;
+			}
+		}
+		std::vector<Unit> observedUnits;
+		std::vector<sc2::Tag> observedTags;
+		for (const auto & unit : squad.getUnits())
+		{
+			const auto owner =
+				m_voiOperationUnitOwners.find(unit.getTag());
+			if (!unit.isValid()
+				|| !unit.isAlive()
+				|| owner == m_voiOperationUnitOwners.end()
+				|| owner->second.first != operation.operationId
+				|| owner->second.second != operation.generation)
+			{
+				continue;
+			}
+			observedUnits.push_back(unit);
+			observedTags.push_back(unit.getTag());
+			operation.maxHomeDistance = std::max(
+				operation.maxHomeDistance,
+				Util::Dist(unit.getPosition(), home));
+		}
+		std::sort(observedTags.begin(), observedTags.end());
+		operation.assignedUnitTags = observedTags;
+		operation.assignedCount =
+			static_cast<int>(observedTags.size());
+		if (operation.submittedFrame == 0
+			|| currentFrame <= operation.submittedFrame
+			|| observedUnits.empty())
+		{
+			continue;
+		}
+
+		bool observedMovement = false;
+		for (const auto & unit : observedUnits)
+		{
+			const auto submitted =
+				operation.submittedPositions.find(unit.getTag());
+			if (submitted != operation.submittedPositions.end()
+				&& Util::DistSq(
+					unit.getPosition(),
+					submitted->second) >= 1.0f)
+			{
+				observedMovement = true;
+				break;
+			}
+		}
+		const bool observedEnemy =
+			voiHasVisibleEnemyNearSquad(
+				observedUnits,
+				m_bot,
+				14.0f);
+		if (observedEnemy)
+		{
+			operation.lastEnemyFrame = currentFrame;
+			operation.engaged = true;
+			operation.status = "ENGAGED";
+		}
+		else if (observedMovement
+			&& operation.status != "ENGAGED")
+		{
+			operation.status = "MOVING";
+		}
+
+		const int majority = std::max(
+			1,
+			static_cast<int>(
+				std::ceil(
+					static_cast<float>(
+						observedUnits.size()) * 0.60f)));
+		if (!operation.routeStageComplete
+			&& operation.activeTargetPosition != CCPosition()
+			&& voiCountUnitsNearPosition(
+				observedUnits,
+				operation.activeTargetPosition,
+				8.0f) >= majority)
+		{
+			operation.routeStageComplete = true;
+			operation.activeTargetPosition =
+				operation.targetPosition;
+			const int orderType =
+				operation.taskType == "scout"
+					? SquadOrderTypes::Scout
+					: (operation.taskType == "defend"
+						? SquadOrderTypes::Defend
+						: SquadOrderTypes::Attack);
+			squad.setSquadOrder(
+				SquadOrder(
+					orderType,
+					operation.targetPosition,
+					operation.taskType == "scout"
+						? ScoutOrderRadius
+						: DefaultOrderRadius,
+					operation.status));
+		}
+
+		const float completionRadius =
+			operation.taskType == "scout" ? 5.0f : 8.0f;
+		const bool targetReached =
+			operation.targetPosition != CCPosition()
+			&& voiCountUnitsNearPosition(
+				observedUnits,
+				operation.targetPosition,
+				completionRadius) >= majority;
+		bool completed = false;
+		if (operation.taskType == "scout")
+		{
+			completed = targetReached;
+		}
+		else if (operation.taskType == "attack"
+			&& targetReached
+			&& !observedEnemy
+			&& m_bot.Map().isExplored(
+				operation.targetPosition))
+		{
+			completed = !operation.engaged
+				|| (operation.lastEnemyFrame > 0
+					&& currentFrame
+						>= operation.lastEnemyFrame + 44u);
+		}
+		if (completed)
+		{
+			releaseVoiOperation(
+				operation,
+				"objective_observed_complete",
+				true);
+		}
+	}
+}
