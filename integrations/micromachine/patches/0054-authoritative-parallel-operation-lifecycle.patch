+bool CombatCommander::hasVoiOperationState(
+	const std::string & operationId,
+	uint64_t generation) const
+{
+	return findVoiOperation(operationId, generation) != nullptr;
+}
+
+bool CombatCommander::isVoiOperationActive(
+	const std::string & operationId,
+	uint64_t generation) const
+{
+	const VoiOperationState * operation =
+		findVoiOperation(operationId, generation);
+	if (operation == nullptr
+		|| operation->completed
+		|| operation->status == "COMPLETED"
+		|| operation->status == "CANCELLED"
+		|| operation->status == "EXPIRED"
+		|| operation->status == "FAILED"
+		|| operation->status == "SUPERSEDED")
+	{
+		return false;
+	}
+	return operation->standing
+		|| operation->deadlineFrame == 0
+		|| static_cast<uint64_t>(m_bot.GetCurrentFrame())
+			<= operation->deadlineFrame;
+}
