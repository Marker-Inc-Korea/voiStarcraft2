{
  "schema_version": 1,
  "producers": {
    "deterministic_journeys": {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-S",
        "-c",
        "import runpy,sys;root,relative,*args=sys.argv[1:];script=root+'/'+relative;sys.path.insert(0,root);sys.argv=[script,*args];runpy.run_path(script,run_name='__main__')",
        "{repository}",
        "starcraft_commander/micromachine_pre_live_journeys.py",
        "--emit-bundle",
        "{output}",
        "--micromachine-binary",
        "{micromachine_binary}"
      ],
      "cwd": ".",
      "output": "producer/deterministic-journeys.zip"
    },
    "provenance_qualification": {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-S",
        "-c",
        "import runpy,sys;root,relative,*args=sys.argv[1:];script=root+'/'+relative;sys.path.insert(0,root);sys.argv=[script,*args];runpy.run_path(script,run_name='__main__')",
        "{repository}",
        "starcraft_commander/micromachine_pre_live_provenance.py",
        "--emit-foundation-evidence",
        "{output}"
      ],
      "cwd": ".",
      "output": "producer/provenance-qualification.json"
    }
  }
}
